                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Binding="{Binding Active}"
                                    behaviors:DeviceTableColumnLayoutBehavior.ColumnKey="Active"
                                    Width="1.05*"
                                    MinWidth="110"
                                    IsReadOnly="True"
