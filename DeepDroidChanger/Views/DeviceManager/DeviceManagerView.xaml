
<UserControl x:Class="DeepDroidChanger.Views.DeviceManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:behaviors="clr-namespace:DeepDroidChanger.Behaviors"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:models="clr-namespace:DeepDroidChanger.Models"
             Background="Transparent">

    <UserControl.Resources>

        <Style x:Key="DeviceManagerGridStyle"
               TargetType="DataGrid"
               BasedOn="{StaticResource FlatDataGridStyle}">
            <Setter Property="MinHeight"
                    Value="220"/>
            <Setter Property="RowHeight"
                    Value="{StaticResource Metric.DataGridEditorRowHeight}"/>
            <Setter Property="MaxHeight"
                    Value="364"/>
            <Setter Property="GridLinesVisibility"
                    Value="All"/>
            <Setter Property="HorizontalGridLinesBrush"
                    Value="{DynamicResource Brush.Border}"/>
            <Setter Property="VerticalGridLinesBrush"
                    Value="{DynamicResource Brush.Border}"/>
            <Setter Property="HorizontalScrollBarVisibility"
                    Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility"
                    Value="Auto"/>
            <Setter Property="RowStyle"
                    Value="{DynamicResource DeviceGridRowContextMenuStyle}"/>
        </Style>

        <Style x:Key="DeviceActionsContextMenuToggleTextBaseStyle"
               TargetType="TextBlock">
            <Setter Property="FontFamily"
                    Value="{StaticResource Metric.FontFamily}"/>
            <Setter Property="FontSize"
                    Value="{StaticResource Metric.FontSize.Body}"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="DeviceActionsContextMenuGmsTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource DeviceActionsContextMenuToggleTextBaseStyle}">
            <Setter Property="Text"
                    Value="{DynamicResource DeviceManager_RowMenuDisableGms}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsGmsDisabled, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                             Value="True">
                    <Setter Property="Text"
                            Value="{DynamicResource DeviceManager_RowMenuEnableGms}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeviceActionsContextMenuPlayStoreTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource DeviceActionsContextMenuToggleTextBaseStyle}">
            <Setter Property="Text"
                    Value="{DynamicResource DeviceManager_RowMenuDisablePlayStore}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsPlayStoreDisabled, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                             Value="True">
                    <Setter Property="Text"
                            Value="{DynamicResource DeviceManager_RowMenuEnablePlayStore}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeviceActionsContextMenuWifiTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource DeviceActionsContextMenuToggleTextBaseStyle}">
            <Setter Property="Text"
                    Value="{DynamicResource DeviceManager_RowMenuEnableWifi}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsWifiEnabled, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                             Value="True">
                    <Setter Property="Text"
                            Value="{DynamicResource DeviceManager_RowMenuDisableWifi}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeviceGridRowContextMenuStyle"
               TargetType="DataGridRow"
               BasedOn="{StaticResource {x:Type DataGridRow}}">
            <EventSetter Event="ContextMenuOpening"
                         Handler="OnDeviceRowContextMenuOpening"/>
            <Setter Property="FocusVisualStyle"
                    Value="{StaticResource AppFocusVisualStyle}"/>
            <Setter Property="Tag"
                    Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu Style="{DynamicResource DeviceActionsContextMenuStyle}">
                        <MenuItem Command="{Binding PlacementTarget.Tag.ViewDeviceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Style="{DynamicResource DeviceActionsContextMenuItemStyle}">
                            <MenuItem.Header>
                                <Grid Style="{DynamicResource DeviceActionsContextMenuHeaderGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Cellphone"
                                                             Style="{DynamicResource DeviceActionsContextMenuButtonIconStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource DeviceManager_ActionViewDevice}"
                                               Style="{DynamicResource DeviceActionsContextMenuButtonTextStyle}"/>
                                </Grid>
                            </MenuItem.Header>
                        </MenuItem>

                        <MenuItem Command="{Binding PlacementTarget.Tag.ViewDeviceInfoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Style="{DynamicResource DeviceActionsContextMenuItemStyle}">
                            <MenuItem.Header>
                                <Grid Style="{DynamicResource DeviceActionsContextMenuHeaderGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="InformationOutline"
                                                             Style="{DynamicResource DeviceActionsContextMenuButtonIconStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource DeviceManager_RowMenuDeviceInfo}"
                                               Style="{DynamicResource DeviceActionsContextMenuButtonTextStyle}"/>
                                </Grid>
                            </MenuItem.Header>
                        </MenuItem>

                        <MenuItem Command="{Binding PlacementTarget.Tag.CopySerialCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Style="{DynamicResource DeviceActionsContextMenuItemStyle}">
                            <MenuItem.Header>
                                <Grid Style="{DynamicResource DeviceActionsContextMenuHeaderGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="ContentCopy"
                                                             Style="{DynamicResource DeviceActionsContextMenuButtonIconStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource DeviceManager_RowMenuCopySerial}"
                                               Style="{DynamicResource DeviceActionsContextMenuButtonTextStyle}"/>
                                </Grid>
                            </MenuItem.Header>
                        </MenuItem>

                        <MenuItem Command="{Binding PlacementTarget.Tag.ToggleGmsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  IsEnabled="{Binding PlacementTarget.DataContext.CanToggleContextMenuActions, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Style="{DynamicResource DeviceActionsContextMenuItemStyle}">
                            <MenuItem.Header>
                                <Grid Style="{DynamicResource DeviceActionsContextMenuHeaderGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Google"
                                                             Style="{DynamicResource DeviceActionsContextMenuButtonIconStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource DeviceActionsContextMenuGmsTextStyle}"/>
                                </Grid>
                            </MenuItem.Header>
                        </MenuItem>

                        <MenuItem Command="{Binding PlacementTarget.Tag.TogglePlayStoreCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  IsEnabled="{Binding PlacementTarget.DataContext.CanToggleContextMenuActions, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Style="{DynamicResource DeviceActionsContextMenuItemStyle}">
                            <MenuItem.Header>
                                <Grid Style="{DynamicResource DeviceActionsContextMenuHeaderGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="GooglePlay"
                                                             Style="{DynamicResource DeviceActionsContextMenuButtonIconStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource DeviceActionsContextMenuPlayStoreTextStyle}"/>
                                </Grid>
                            </MenuItem.Header>
                        </MenuItem>

                        <MenuItem Command="{Binding PlacementTarget.Tag.ToggleWifiCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  IsEnabled="{Binding PlacementTarget.DataContext.CanToggleContextMenuActions, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Style="{DynamicResource DeviceActionsContextMenuItemStyle}">
                            <MenuItem.Header>
                                <Grid Style="{DynamicResource DeviceActionsContextMenuHeaderGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Wifi"
                                                             Style="{DynamicResource DeviceActionsContextMenuButtonIconStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource DeviceActionsContextMenuWifiTextStyle}"/>
                                </Grid>
                            </MenuItem.Header>
                        </MenuItem>

                        <MenuItem Command="{Binding PlacementTarget.Tag.RebootDeviceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Style="{DynamicResource DeviceActionsContextMenuItemStyle}">
                            <MenuItem.Header>
                                <Grid Style="{DynamicResource DeviceActionsContextMenuHeaderGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Restart"
                                                             Style="{DynamicResource DeviceActionsContextMenuButtonIconStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource DeviceManager_RowMenuRebootDevice}"
                                               Style="{DynamicResource DeviceActionsContextMenuButtonTextStyle}"/>
                                </Grid>
                            </MenuItem.Header>
                        </MenuItem>

                        <Separator Style="{DynamicResource DeviceActionsContextMenuSeparatorStyle}"/>

                        <MenuItem Command="{Binding PlacementTarget.Tag.FactoryResetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  IsEnabled="{Binding PlacementTarget.DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Style="{DynamicResource DeviceActionsContextMenuDangerItemStyle}">
                            <MenuItem.Header>
                                <Grid Style="{DynamicResource DeviceActionsContextMenuHeaderGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Restore"
                                                             Style="{DynamicResource DeviceActionsContextMenuDangerButtonIconStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource DeviceManager_RowMenuFactoryReset}"
                                               Style="{DynamicResource DeviceActionsContextMenuDangerButtonTextStyle}"/>
                                </Grid>
                            </MenuItem.Header>
                        </MenuItem>

                        <MenuItem Command="{Binding PlacementTarget.Tag.DeleteDeviceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Style="{DynamicResource DeviceActionsContextMenuDangerItemStyle}">
                            <MenuItem.Header>
                                <Grid Style="{DynamicResource DeviceActionsContextMenuHeaderGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Delete"
                                                             Style="{DynamicResource DeviceActionsContextMenuDangerButtonIconStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource DeviceManager_RowMenuDeleteDevice}"
                                               Style="{DynamicResource DeviceActionsContextMenuDangerButtonTextStyle}"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding InputGestureText, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                                               Style="{DynamicResource DeviceActionsContextMenuShortcutTextStyle}"/>
                                </Grid>
                            </MenuItem.Header>
                        </MenuItem>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>

        <Thickness x:Key="DeviceProfilePanelContentMargin">0,10,16,0</Thickness>

        <Style x:Key="DeviceManagerCellStretchStyle"
               TargetType="DataGridCell"
               BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="DeviceSectionBorderStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource Brush.SurfaceAlt}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="{StaticResource Radius.Medium}"/>
            <Setter Property="Padding"
                    Value="14,12"/>
        </Style>

        <Style x:Key="DeviceInfoSectionBorderStyle"
               TargetType="Border"
               BasedOn="{StaticResource DeviceSectionBorderStyle}">
            <Setter Property="Margin"
                    Value="0,0,12,0"/>
        </Style>

        <Style x:Key="DeviceActionSectionBorderStyle"
               TargetType="Border"
               BasedOn="{StaticResource DeviceSectionBorderStyle}">
            <Setter Property="Padding"
                    Value="10,8"/>
        </Style>

        <Style x:Key="DeviceSectionHeaderGridStyle"
               TargetType="Grid">
            <Setter Property="Margin"
                    Value="0,0,0,10"/>
        </Style>

        <Style x:Key="DeviceSectionIconStyle"
               TargetType="materialDesign:PackIcon">
            <Setter Property="Width"
                    Value="20"/>
            <Setter Property="Height"
                    Value="20"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="Margin"
                    Value="0,0,10,0"/>
        </Style>

        <Style x:Key="DeviceSectionTitleTextStyle"
               TargetType="TextBlock">
            <Setter Property="FontFamily"
                    Value="{StaticResource Metric.FontFamily}"/>
            <Setter Property="FontSize"
                    Value="{StaticResource Metric.FontSize.Body}"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="DeviceInfoFormGridStyle"
               TargetType="Grid">
            <Setter Property="VerticalAlignment"
                    Value="Top"/>
        </Style>

        <Style x:Key="DeviceFormLabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource AppLabelTextStyle}">
            <Setter Property="Margin"
                    Value="0,0,8,0"/>
            <Setter Property="TextWrapping"
                    Value="NoWrap"/>
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="DeviceFormSecondaryLabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource DeviceFormLabelStyle}">
            <Setter Property="Margin"
                    Value="10,0,8,0"/>
        </Style>

        <Style x:Key="DeviceTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource FlatTextBoxStyle}">
            <Setter Property="Margin"
                    Value="0,0,0,8"/>
            <Setter Property="materialDesign:HintAssist.Foreground"
                    Value="{DynamicResource Brush.TextDisabled}"/>
        </Style>

        <Style x:Key="DeviceComboBoxItemStyle"
               TargetType="ComboBoxItem"
               BasedOn="{StaticResource FlatComboBoxItemStyle}">
            <Setter Property="Padding"
                    Value="10,6"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>
        </Style>

        <Style x:Key="DeviceComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource FlatComboBoxStyle}">
            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>
            <Setter Property="Margin"
                    Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>
            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource DeviceComboBoxItemStyle}"/>
        </Style>

        <Style x:Key="DeviceActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource MaterialPrimaryButtonStyle}">
            <Setter Property="Background"
                    Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="BorderBrush"

                    Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource Brush.AccentForeground}"/>
            <Setter Property="Height"
                    Value="36"/>
            <Setter Property="Margin"
                    Value="0,0,5,4"/>
            <Setter Property="Padding"
                    Value="8,0"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius"
                    Value="{StaticResource Radius.Medium}"/>
            <Setter Property="materialDesign:RippleAssist.Feedback"
                    Value="{DynamicResource Brush.AccentForeground}"/>
            <Setter Property="materialDesign:RippleAssist.RippleOnTop"
                    Value="True"/>
            <Setter Property="materialDesign:ElevationAssist.Elevation"
                    Value="Dp1"/>
        </Style>

        <Style x:Key="DeviceActionButtonTextStyle"
               TargetType="TextBlock">
            <Setter Property="FontFamily"
                    Value="{StaticResource Metric.FontFamily}"/>
            <Setter Property="FontSize"
                    Value="{StaticResource Metric.FontSize.Small}"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="TextWrapping"
                    Value="NoWrap"/>
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>
            <Setter Property="TextAlignment"
                    Value="Left"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>

        <Style x:Key="DeviceInfoDetailsButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DeviceActionButtonStyle}">
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>

        <Style x:Key="DeviceFlashPlaceholderTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource AppLabelTextStyle}">
            <Setter Property="FontSize"
                    Value="{StaticResource Metric.FontSize.Body}"/>
            <Setter Property="HorizontalAlignment"
                    Value="Center"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>

    <Style x:Key="DeviceLoadToolbarStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <Style x:Key="DeviceLoadButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource MaterialPrimaryButtonStyle}">
        <Setter Property="Background"
                Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="16,0,16,0"/>
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="{StaticResource Radius.ExtraSmall}"/>
        <Setter Property="materialDesign:RippleAssist.Feedback" Value="{DynamicResource Brush.AccentForeground}"/>
        <Setter Property="materialDesign:RippleAssist.RippleOnTop" Value="True"/>
        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2"/>
    </Style>

    <Style x:Key="DeviceLoadButtonContentStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DeviceLoadCountTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="10,0,0,0"/>
    </Style>

    <Style x:Key="DeviceFilterLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style x:Key="DeviceFilterComboBoxStyle"
           TargetType="ComboBox"
           BasedOn="{StaticResource FlatComboBoxStyle}">
        <Setter Property="Width"
                Value="156"/>
        <Setter Property="VerticalAlignment"
                Value="Center"/>
        <Setter Property="HorizontalContentAlignment"
                Value="Left"/>
        <Setter Property="ItemContainerStyle"
                Value="{StaticResource DeviceComboBoxItemStyle}"/>
    </Style>

    <Thickness x:Key="DeviceActionsContextMenuPadding">6</Thickness>
        <Thickness x:Key="DeviceActionsContextMenuItemPadding">12,9</Thickness>
        <Thickness x:Key="DeviceActionsContextMenuItemMargin">2,1</Thickness>
        <Thickness x:Key="DeviceActionsContextMenuDangerItemMargin">2,5,2,1</Thickness>
        <Thickness x:Key="DeviceActionsContextMenuIconMargin">0,0,14,0</Thickness>
        <Thickness x:Key="DeviceActionsContextMenuShortcutMargin">28,0,0,0</Thickness>
        <Thickness x:Key="DeviceActionsContextMenuSeparatorMargin">12,6,12,3</Thickness>

        <sys:Double x:Key="DeviceActionsContextMenuMinWidth">248</sys:Double>
        <sys:Double x:Key="DeviceActionsContextMenuItemMinHeight">38</sys:Double>
        <sys:Double x:Key="DeviceActionsContextMenuIconSize">17</sys:Double>
        <sys:Double x:Key="DeviceActionsContextMenuDangerHoverOpacity">0.14</sys:Double>
        <sys:Double x:Key="DeviceActionsContextMenuDangerPressedOpacity">0.22</sys:Double>

        <Style x:Key="DeviceActionsContextMenuStyle"
               TargetType="ContextMenu">
            <Setter Property="Background"
                    Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="Padding"
                    Value="{StaticResource DeviceActionsContextMenuPadding}"/>
            <Setter Property="SnapsToDevicePixels"
                    Value="True"/>
            <Setter Property="OverridesDefaultStyle"
                    Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{StaticResource Metric.BorderThickness.Uniform}"
                                CornerRadius="{StaticResource Radius.Overlay}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="{StaticResource Metric.Elevation.FloatingBlurRadius}"
                                                  ShadowDepth="{StaticResource Metric.Elevation.FloatingShadowDepth}"
                                                  Direction="270"
                                                  Opacity="{StaticResource Metric.Elevation.FloatingShadowOpacity}"/>
                            </Border.Effect>
                            <StackPanel ClipToBounds="False"
                                        IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeviceActionsContextMenuItemStyle"
               TargetType="MenuItem">
            <Setter Property="FontFamily"
                    Value="{StaticResource Metric.FontFamily}"/>
            <Setter Property="FontSize"
                    Value="{StaticResource Metric.FontSize.Body}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="Background"
                    Value="{DynamicResource Brush.SurfaceHover}"/>
            <Setter Property="BorderBrush"

                    Value="{DynamicResource Brush.SurfaceSelected}"/>
            <Setter Property="Padding"
                    Value="{StaticResource DeviceActionsContextMenuItemPadding}"/>
            <Setter Property="Margin"
                    Value="{StaticResource DeviceActionsContextMenuItemMargin}"/>
            <Setter Property="MinWidth"
                    Value="{StaticResource DeviceActionsContextMenuMinWidth}"/>
            <Setter Property="MinHeight"
                    Value="{StaticResource DeviceActionsContextMenuItemMinHeight}"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border Margin="{TemplateBinding Margin}"
                                MinWidth="{TemplateBinding MinWidth}"
                                MinHeight="{TemplateBinding MinHeight}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="HoverOverlay"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="{StaticResource Radius.Interactive}"
                                        Opacity="0"/>
                                <Border x:Name="PressedOverlay"
                                        Background="{TemplateBinding BorderBrush}"
                                        CornerRadius="{StaticResource Radius.Interactive}"
                                        Opacity="0"/>
                                <ContentPresenter x:Name="HeaderPresenter"
                                                  Margin="{TemplateBinding Padding}"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted"
                                     Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="{StaticResource Metric.Animation.HoverDuration}">
                                                <DoubleAnimation.EasingFunction>
                                                    <StaticResource ResourceKey="Metric.Animation.EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="{StaticResource Metric.Animation.HoverDuration}">
                                                <DoubleAnimation.EasingFunction>
                                                    <StaticResource ResourceKey="Metric.Animation.EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="PressedOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="{StaticResource Metric.Animation.HoverDuration}">
                                                <DoubleAnimation.EasingFunction>
                                                    <StaticResource ResourceKey="Metric.Animation.EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <EventTrigger RoutedEvent="PreviewMouseDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="{StaticResource Metric.Animation.PressDuration}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="{StaticResource Metric.Animation.HoverDuration}">
                                            <DoubleAnimation.EasingFunction>
                                                <StaticResource ResourceKey="Metric.Animation.EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Cursor"
                                        Value="Arrow"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Brush.TextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
