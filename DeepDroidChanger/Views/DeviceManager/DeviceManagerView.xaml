                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridCheckBoxColumn Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        behaviors:DeviceTableColumnLayoutBehavior.ColumnKey="Selected"
                                        Width="0.55*"
                                        MinWidth="72"
                                        ElementStyle="{StaticResource DataGridCheckBoxStyle}"
                                        EditingElementStyle="{StaticResource DataGridCheckBoxStyle}">
                    <DataGridCheckBoxColumn.Header>
                        <TextBlock Text="{DynamicResource DeviceManager_ColumnSelected}"
                                   Style="{StaticResource DataGridColumnHeaderTextStyle}"/>
                    </DataGridCheckBoxColumn.Header>
                </DataGridCheckBoxColumn>
                <DataGridTextColumn Binding="{Binding Serial}"
                                    behaviors:DeviceTableColumnLayoutBehavior.ColumnKey="Serial"
                                    Width="1.05*"
                                    MinWidth="110"
                                    IsReadOnly="True"
                                    ElementStyle="{StaticResource DataGridLeftCellTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource DeviceManager_ColumnSerial}"
                                   Style="{StaticResource DataGridColumnHeaderTextStyle}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTemplateColumn behaviors:DeviceTableColumnLayoutBehavior.ColumnKey="Name"
                                        Width="1.05*"
                                        MinWidth="110"
                                        CellStyle="{StaticResource DeviceManagerCellStretchStyle}">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{DynamicResource DeviceManager_ColumnName}"
                                   Style="{StaticResource DataGridColumnHeaderTextStyle}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanEdit}"
                                     Style="{StaticResource InlineDataGridTextBoxStyle}"
                                     materialDesign:HintAssist.Hint="{DynamicResource Shared_DeviceNameHint}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn behaviors:DeviceTableColumnLayoutBehavior.ColumnKey="Type"
