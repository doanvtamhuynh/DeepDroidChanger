                          SelectedValuePath="Tag"
                          Style="{StaticResource DeviceFilterComboBoxStyle}">
                    <ComboBoxItem Tag="All"
                                  Content="{DynamicResource DeviceManager_FilterAll}"
                                  Style="{StaticResource DeviceComboBoxItemStyle}"/>
                    <ComboBoxItem Tag="Online"
                                  Content="{DynamicResource DeviceManager_FilterOnline}"
                                  Style="{StaticResource DeviceComboBoxItemStyle}"/>
                    <ComboBoxItem Tag="Offline"
                                  Content="{DynamicResource DeviceManager_FilterOffline}"
                                  Style="{StaticResource DeviceComboBoxItemStyle}"/>
                    <ComboBoxItem Tag="Active"
                                  Content="{DynamicResource DeviceManager_FilterActive}"
                                  Style="{StaticResource DeviceComboBoxItemStyle}"/>
                    <ComboBoxItem Tag="Inactive"
                                  Content="{DynamicResource DeviceManager_FilterInactive}"
