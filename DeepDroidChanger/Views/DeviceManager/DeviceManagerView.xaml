                                </ComboBox>

                                <TextBlock Grid.Row="2"
                                           Text="{DynamicResource DeviceManager_FieldModel}"
                                           Style="{StaticResource DeviceFormLabelStyle}"/>
                                <TextBox Grid.Row="2"
                                         Grid.Column="1"
                                         Text="{Binding DeviceInfo.Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DeviceTextBoxStyle}"/>

                                <TextBlock Grid.Row="3"
                                           Text="{DynamicResource DeviceManager_FieldCountry}"
                                           Style="{StaticResource DeviceFormLabelStyle}"/>
                                <ComboBox x:Name="CountryComboBox"
                                          Grid.Row="3"
                                          Grid.Column="1"
                                          ItemsSource="{Binding Countries}"
                                          SelectedItem="{Binding SelectedCountry, Mode=TwoWay}"
                                          Style="{StaticResource DeviceComboBoxStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Row="4"
                                           Text="{DynamicResource DeviceManager_FieldCarrier}"
                                           Style="{StaticResource DeviceFormLabelStyle}"/>
                                <ComboBox x:Name="CarrierComboBox"
                                          Grid.Row="4"
                                          Grid.Column="1"
                                          ItemsSource="{Binding Carriers}"
                                          SelectedItem="{Binding SelectedCarrier, Mode=TwoWay}"
                                          Style="{StaticResource DeviceComboBoxStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <CheckBox Grid.Row="5"
                                          Grid.ColumnSpan="2"
                                          Content="{DynamicResource DeviceManager_OptionChangeSim}"
                                          IsChecked="{Binding IsChangeSimEnabled, Mode=TwoWay}"
                                          Style="{StaticResource FormCheckBoxStyle}"/>
                                <CheckBox x:Name="UseDefaultChangeModeCheckBox"
                                          Grid.Row="6"
                                          Grid.ColumnSpan="2"
                                          Content="{DynamicResource DeviceManager_OptionDefaultChangeMode}"
                                          IsChecked="{Binding UseDefaultChangeMode, Mode=TwoWay}"
                                          Style="{StaticResource FormCheckBoxStyle}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource DeviceActionSectionBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Style="{StaticResource DeviceSectionHeaderGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Cog"
                                                         Style="{StaticResource DeviceSectionIconStyle}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{DynamicResource DeviceManager_ActionSingleHeader}"
                                           Style="{StaticResource DeviceSectionTitleTextStyle}"/>
                            </Grid>

                            <Grid x:Name="DeviceActionGrid"
                                  Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                            <Button x:Name="RandomDeviceButton"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Command="{Binding RandomDeviceCommand}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Cellphone"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource DeviceManager_ActionRandomDevice}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button x:Name="ChangeWithoutWipeButton"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Command="{Binding ChangeWithoutWipeCommand}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="CellphoneText"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource DeviceManager_ActionChangeWithoutWipe}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button x:Name="ChangeDeviceButton"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Command="{Binding ChangeDeviceCommand}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="CellphoneCog"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource DeviceManager_ActionChangeDevice}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button x:Name="WipeWithoutChangeButton"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Command="{Binding WipeWithoutChangeCommand}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="DeleteSweep"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource DeviceManager_ActionWipeWithoutChange}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button Grid.Row="3"
                                    Grid.Column="0"
                                    Command="{Binding RandomChangeAndWipeDeviceCommand}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Sync"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource DeviceManager_ActionRandomChangeAndWipe}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button x:Name="RandomSimButton"
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Command="{Binding RandomSimCommand}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="SimCard"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource DeviceManager_ActionRandomSim}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button x:Name="ChangeSimButton"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Command="{Binding ChangeSimCommand}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="SimCard"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource DeviceManager_ActionChangeSim}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button Grid.Row="4"
                                    Grid.Column="0"
                                    Command="{Binding ChangeLocationCommand}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="MapMarker"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource DeviceManager_ActionChangeLocation}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button Grid.Row="4"
                                    Grid.Column="1"
                                    Command="{Binding ChangeTimezoneCommand}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="ClockOutline"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource DeviceManager_ActionChangeTimezone}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button Grid.Row="6"
                                    Grid.Column="0"
                                    Command="{Binding UpdateIntegrityCommand}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="ShieldCheck"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource DeviceManager_ActionUpdateIntegrity}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button Grid.Row="3"
                                    Grid.Column="1"
                                    Command="{Binding InstallApkCommand}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Android"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource DeviceManager_ActionInstallApk}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button Grid.Row="5"
                                    Grid.Column="0"
                                    Command="{Binding FakeProxyCommand}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Wifi"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource DeviceManager_ActionFakeProxy}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button Grid.Row="5"
                                    Grid.Column="1"
                                    Command="{Binding StopFakeProxyCommand}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="WifiOff"
                                                             Width="16"
                                                             Height="16"

                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource DeviceManager_ActionStopFakeProxy}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            </Grid>
                        </Grid>
                    </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource DeviceManager_TabFlashRom}"
                     Style="{StaticResource UnderlineTabItemStyle}">
                <Grid>
                    <TextBlock Text="{DynamicResource DeviceManager_FlashRomPlaceholder}"
                               Style="{StaticResource DeviceFlashPlaceholderTextStyle}"/>
                </Grid>
            </TabItem>
        </TabControl>
        </Grid>
    </ScrollViewer>
</UserControl>
