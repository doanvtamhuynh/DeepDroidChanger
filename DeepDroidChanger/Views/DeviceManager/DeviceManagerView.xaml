<UserControl x:Class="DeepDroidChanger.Views.DeviceManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:DeepDroidChanger.Behaviors"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:models="clr-namespace:DeepDroidChanger.Models"
             xmlns:constants="clr-namespace:DeepDroidChanger.Constants"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="DeviceManagerRootGrid"
              Style="{StaticResource DeviceManagerRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"
                           MinHeight="220"/>
            <RowDefinition Height="360"
                           MinHeight="360"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0"
              Style="{StaticResource DeviceLoadToolbarStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{Binding AddNewDevicesCommand}"
                    ToolTip="{DynamicResource DeviceManager_AddNewDevices}"
                    Style="{StaticResource DeviceLoadButtonStyle}">
                <StackPanel Style="{StaticResource DeviceLoadButtonContentStyle}">
                    <materialDesign:PackIcon Kind="Plus"
                                             Style="{StaticResource DeviceLoadButtonIconStyle}"/>
                    <TextBlock Text="{DynamicResource DeviceManager_AddNewDevices}"
                               Style="{StaticResource DeviceLoadButtonTextStyle}"/>
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1"
                       Text="{Binding NewDeviceCountText}"
                       Style="{StaticResource DeviceLoadCountTextStyle}"/>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource DeviceManager_FilterLabel}"
                           Style="{StaticResource DeviceFilterLabelStyle}"/>
                <ComboBox SelectedValue="{Binding SelectedDeviceFilter, Mode=TwoWay}"
                          SelectedValuePath="Tag"
                          Style="{StaticResource DeviceFilterComboBoxStyle}">
                    <ComboBoxItem Tag="{x:Static constants:DeviceFilterKeys.All}"
                                  Content="{DynamicResource DeviceManager_FilterAll}"
                                  Style="{StaticResource DeviceFilterComboBoxItemStyle}"/>
                    <ComboBoxItem Tag="{x:Static constants:DeviceFilterKeys.Online}"
                                  Content="{DynamicResource DeviceManager_FilterOnline}"
                                  Style="{StaticResource DeviceFilterComboBoxItemStyle}"/>
                    <ComboBoxItem Tag="{x:Static constants:DeviceFilterKeys.Offline}"
                                  Content="{DynamicResource DeviceManager_FilterOffline}"
                                  Style="{StaticResource DeviceFilterComboBoxItemStyle}"/>
                    <ComboBoxItem Tag="{x:Static constants:DeviceFilterKeys.Active}"
                                  Content="{DynamicResource DeviceManager_FilterActive}"
                                  Style="{StaticResource DeviceFilterComboBoxItemStyle}"/>
                    <ComboBoxItem Tag="{x:Static constants:DeviceFilterKeys.Inactive}"
                                  Content="{DynamicResource DeviceManager_FilterInactive}"
                                  Style="{StaticResource DeviceFilterComboBoxItemStyle}"/>
                </ComboBox>
            </StackPanel>
        </Grid>
        <DataGrid x:Name="DeviceGrid"
                  Grid.Row="1"
                  ItemsSource="{Binding Devices}"
                  SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  PreviewMouseRightButtonDown="OnDeviceGridPreviewMouseRightButtonDown"
                  behaviors:DeviceTableColumnLayoutBehavior.PersistColumnRatios="True"
                  behaviors:DeviceTableColumnLayoutBehavior.ColumnRatios="{Binding DeviceTableColumnRatios}"
                  behaviors:DeviceTableColumnLayoutBehavior.SaveColumnRatiosCommand="{Binding SaveColumnRatiosCommand}"
                  Style="{StaticResource DeviceManagerGridStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Index}"
                                    behaviors:DeviceTableColumnLayoutBehavior.ColumnKey="{x:Static constants:DeviceTableColumnSettings.Index}"
                                    Width="0.55*"
                                    MinWidth="72"
                                    IsReadOnly="True"
                                    ElementStyle="{StaticResource DeviceGridCenterCellTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource DeviceManager_ColumnIndex}"
                                   Style="{StaticResource DeviceManagerColumnHeaderTextStyle}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridCheckBoxColumn Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        behaviors:DeviceTableColumnLayoutBehavior.ColumnKey="{x:Static constants:DeviceTableColumnSettings.Selected}"
                                        Width="0.55*"
                                        MinWidth="72"
                                        ElementStyle="{StaticResource DeviceGridCheckBoxStyle}"
                                        EditingElementStyle="{StaticResource DeviceGridCheckBoxStyle}">
                    <DataGridCheckBoxColumn.Header>
                        <TextBlock Text="{DynamicResource DeviceManager_ColumnSelected}"
                                   Style="{StaticResource DeviceManagerColumnHeaderTextStyle}"/>
                    </DataGridCheckBoxColumn.Header>
                </DataGridCheckBoxColumn>
                <DataGridTextColumn Binding="{Binding Serial}"
                                    behaviors:DeviceTableColumnLayoutBehavior.ColumnKey="{x:Static constants:DeviceTableColumnSettings.Serial}"
                                    Width="1.05*"
                                    MinWidth="110"
                                    IsReadOnly="True"
                                    ElementStyle="{StaticResource DeviceGridLeftCellTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource DeviceManager_ColumnSerial}"
                                   Style="{StaticResource DeviceManagerColumnHeaderTextStyle}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTemplateColumn behaviors:DeviceTableColumnLayoutBehavior.ColumnKey="{x:Static constants:DeviceTableColumnSettings.Name}"
                                        Width="1.05*"
                                        MinWidth="110"
                                        CellStyle="{StaticResource DeviceManagerCellStretchStyle}">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{DynamicResource DeviceManager_ColumnName}"
                                   Style="{StaticResource DeviceManagerColumnHeaderTextStyle}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InlineDataGridTextBoxStyle}"
                                     materialDesign:HintAssist.Hint="{DynamicResource Shared_DeviceNameHint}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn behaviors:DeviceTableColumnLayoutBehavior.ColumnKey="{x:Static constants:DeviceTableColumnSettings.Type}"
                                        Width="0.9*"
                                        MinWidth="90"
                                        CellStyle="{StaticResource DeviceManagerCellStretchStyle}">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{DynamicResource DeviceManager_ColumnType}"
                                   Style="{StaticResource DeviceManagerColumnHeaderTextStyle}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.TypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedItem="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource InlineDataGridComboBoxStyle}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Binding="{Binding Active}"
                                    behaviors:DeviceTableColumnLayoutBehavior.ColumnKey="{x:Static constants:DeviceTableColumnSettings.Active}"
                                    Width="1.05*"
                                    MinWidth="110"
                                    IsReadOnly="True"
                                    ElementStyle="{StaticResource DeviceGridLeftCellTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource DeviceManager_ColumnActive}"
                                   Style="{StaticResource DeviceManagerColumnHeaderTextStyle}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Status}"
                                    behaviors:DeviceTableColumnLayoutBehavior.ColumnKey="{x:Static constants:DeviceTableColumnSettings.Status}"
                                    Width="1*"
                                    MinWidth="100"
                                    IsReadOnly="True"
                                    ElementStyle="{StaticResource DeviceGridLeftCellTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource DeviceManager_ColumnStatus}"
                                   Style="{StaticResource DeviceManagerColumnHeaderTextStyle}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Process}"
                                    behaviors:DeviceTableColumnLayoutBehavior.ColumnKey="{x:Static constants:DeviceTableColumnSettings.Process}"
                                    Width="1.95*"
                                    MinWidth="150"
                                    IsReadOnly="True"
                                    ElementStyle="{StaticResource DeviceGridWrappingCellTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource DeviceManager_ColumnProcess}"
                                   Style="{StaticResource DeviceManagerColumnHeaderTextStyle}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TabControl Grid.Row="2"
                    Style="{StaticResource DeviceTabControlStyle}"
                    Margin="0,8,0,0"
                    MinHeight="300">
            <TabItem Header="{DynamicResource DeviceManager_TabChangeInfoSingle}"
                     Style="{StaticResource DeviceTabItemStyle}">
                <ScrollViewer x:Name="DeviceProfilePanelScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="DeviceProfilePanelContentGrid"
                          Margin="{StaticResource DeviceProfilePanelContentMargin}"
                          MinHeight="260">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="1.45*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource DeviceInfoSectionBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Style="{StaticResource DeviceSectionHeaderGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="CellphoneCog"
                                                         Style="{StaticResource DeviceSectionIconStyle}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{DynamicResource DeviceManager_DeviceInfoHeader}"
                                           Style="{StaticResource DeviceSectionTitleTextStyle}"/>
                                <Button x:Name="ViewAllDeviceInfoButton"
                                        Grid.Column="2"
                                        Command="{Binding ViewRandomDeviceInfoCommand}"
                                        ToolTip="{DynamicResource DeviceManager_ActionViewAllDeviceInfo}"
                                        Style="{StaticResource DeviceInfoDetailsButtonStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="InformationOutline"
                                                                 Style="{StaticResource DeviceInfoDetailsButtonIconStyle}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{DynamicResource DeviceManager_ActionViewAllDeviceInfo}"
                                                   Style="{StaticResource DeviceInfoDetailsButtonTextStyle}"/>
                                    </Grid>
                                </Button>
                            </Grid>

                            <Grid Grid.Row="1"
                                  Style="{StaticResource DeviceInfoFormGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="{DynamicResource DeviceManager_FieldName}"
                                           Style="{StaticResource DeviceFormLabelStyle}"/>
                                <TextBox x:Name="DeviceInfoNameTextBox"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Text="{Binding DeviceInfo.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DeviceTextBoxStyle}"/>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="2"
                                           Text="{DynamicResource DeviceManager_FieldOperator}"
                                           Style="{StaticResource DeviceFormSecondaryLabelStyle}"/>
                                <TextBox x:Name="DeviceInfoOperatorTextBox"
                                         Grid.Row="0"
                                         Grid.Column="3"
                                         Text="{Binding DeviceInfo.Operator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DeviceTextBoxStyle}"/>

                                <TextBlock Grid.Row="1"
                                           Text="{DynamicResource DeviceManager_FieldBrand}"
                                           Style="{StaticResource DeviceFormLabelStyle}"/>
                                <TextBox x:Name="DeviceInfoBrandTextBox"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Text="{Binding DeviceInfo.Brand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DeviceTextBoxStyle}"/>
                                <TextBlock Grid.Row="1"
                                           Grid.Column="2"
                                           Text="{DynamicResource DeviceManager_FieldPhoneNumber}"
                                           Style="{StaticResource DeviceFormSecondaryLabelStyle}"/>
                                <TextBox x:Name="DeviceInfoPhoneNumberTextBox"
                                         Grid.Row="1"
                                         Grid.Column="3"
                                         Text="{Binding DeviceInfo.PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DeviceTextBoxStyle}"/>

                                <TextBlock Grid.Row="2"
                                           Text="{DynamicResource DeviceManager_FieldOsVersion}"
                                           Style="{StaticResource DeviceFormLabelStyle}"/>
                                <TextBox x:Name="DeviceInfoAndroidVersionTextBox"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         Text="{Binding DeviceInfo.AndroidVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DeviceTextBoxStyle}"/>
                                <TextBlock Grid.Row="2"
                                           Grid.Column="2"
                                           Text="{DynamicResource DeviceManager_FieldIccid}"
                                           Style="{StaticResource DeviceFormSecondaryLabelStyle}"/>
                                <TextBox x:Name="DeviceInfoIccidTextBox"
                                         Grid.Row="2"
                                         Grid.Column="3"
                                         Text="{Binding DeviceInfo.Iccid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DeviceTextBoxStyle}"/>

                                <TextBlock Grid.Row="3"
                                           Text="{DynamicResource DeviceManager_FieldSerial}"
                                           Style="{StaticResource DeviceFormLabelStyle}"/>
                                <TextBox x:Name="DeviceInfoSerialTextBox"
                                         Grid.Row="3"
                                         Grid.Column="1"
                                         Text="{Binding DeviceInfo.Serial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DeviceTextBoxStyle}"/>
                                <TextBlock Grid.Row="3"
                                           Grid.Column="2"
                                           Text="{DynamicResource DeviceManager_FieldImsi}"
                                           Style="{StaticResource DeviceFormSecondaryLabelStyle}"/>
                                <TextBox x:Name="DeviceInfoImsiTextBox"
                                         Grid.Row="3"
                                         Grid.Column="3"
                                         Text="{Binding DeviceInfo.Imsi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DeviceTextBoxStyle}"/>

                                <TextBlock Grid.Row="4"
                                           Text="{DynamicResource DeviceManager_FieldImei}"
                                           Style="{StaticResource DeviceFormLabelStyle}"/>
                                <TextBox x:Name="DeviceInfoImeiTextBox"
                                         Grid.Row="4"
                                         Grid.Column="1"
                                         Text="{Binding DeviceInfo.Imei, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DeviceTextBoxStyle}"/>
                                <TextBlock Grid.Row="4"
                                           Grid.Column="2"
                                           Text="{DynamicResource DeviceManager_FieldMac}"
                                           Style="{StaticResource DeviceFormSecondaryLabelStyle}"/>
                                <TextBox x:Name="DeviceInfoMacTextBox"
                                         Grid.Row="4"
                                         Grid.Column="3"
                                         Text="{Binding DeviceInfo.Mac, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DeviceTextBoxStyle}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource DeviceConfigSectionBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Style="{StaticResource DeviceSectionHeaderGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="TuneVariant"
                                                         Style="{StaticResource DeviceSectionIconStyle}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{DynamicResource DeviceManager_DeviceConfigHeader}"
                                           Style="{StaticResource DeviceSectionTitleTextStyle}"/>
                            </Grid>

                            <Grid x:Name="DeviceConfigFormGrid"
                                  Grid.Row="1"
                                  Style="{StaticResource DeviceConfigFormGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="{DynamicResource DeviceManager_FieldBrand}"
                                           Style="{StaticResource DeviceFormLabelStyle}"/>
                                <ComboBox x:Name="BrandComboBox"
                                          Grid.Row="0"
                                          Grid.Column="1"
                                          ItemsSource="{Binding Brands}"
                                          SelectedItem="{Binding SelectedBrand, Mode=TwoWay}"
                                          Style="{StaticResource DeviceComboBoxStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Row="1"
                                           Text="{DynamicResource DeviceManager_FieldOsVersion}"
                                           Style="{StaticResource DeviceFormLabelStyle}"/>
                                <ComboBox x:Name="AndroidVersionComboBox"
                                          Grid.Row="1"
                                          Grid.Column="1"
                                          ItemsSource="{Binding AndroidVersions}"
                                          SelectedItem="{Binding SelectedAndroidVersion, Mode=TwoWay}"
                                          Style="{StaticResource DeviceComboBoxStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Row="2"
                                           Text="{DynamicResource DeviceManager_FieldModel}"
                                           Style="{StaticResource DeviceFormLabelStyle}"/>
                                <TextBox Grid.Row="2"
                                         Grid.Column="1"
                                         Text="{Binding DeviceInfo.Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DeviceTextBoxStyle}"/>

                                <TextBlock Grid.Row="3"
                                           Text="{DynamicResource DeviceManager_FieldCountry}"
                                           Style="{StaticResource DeviceFormLabelStyle}"/>
                                <ComboBox x:Name="CountryComboBox"
                                          Grid.Row="3"
                                          Grid.Column="1"
                                          ItemsSource="{Binding Countries}"
                                          SelectedItem="{Binding SelectedCountry, Mode=TwoWay}"
                                          Style="{StaticResource DeviceComboBoxStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Row="4"
                                           Text="{DynamicResource DeviceManager_FieldCarrier}"
                                           Style="{StaticResource DeviceFormLabelStyle}"/>
                                <ComboBox x:Name="CarrierComboBox"
                                          Grid.Row="4"
                                          Grid.Column="1"
                                          ItemsSource="{Binding Carriers}"
                                          SelectedItem="{Binding SelectedCarrier, Mode=TwoWay}"
                                          Style="{StaticResource DeviceComboBoxStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <CheckBox Grid.Row="5"
                                          Grid.ColumnSpan="2"
                                          Content="{DynamicResource DeviceManager_OptionChangeSim}"
                                          IsChecked="{Binding IsChangeSimEnabled, Mode=TwoWay}"
                                          Style="{StaticResource DeviceCheckBoxStyle}"/>
                                <CheckBox x:Name="UseIntegritySecurityPatchCheckBox"
                                          Grid.Row="6"
                                          Grid.ColumnSpan="2"
                                          Content="{DynamicResource DeviceManager_OptionUseIntegritySecurityPatch}"
                                          IsChecked="{Binding UseIntegritySecurityPatch, Mode=TwoWay}"
                                          Style="{StaticResource DeviceCheckBoxStyle}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource DeviceActionSectionBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Style="{StaticResource DeviceSectionHeaderGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Cog"
                                                         Style="{StaticResource DeviceSectionIconStyle}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{DynamicResource DeviceManager_ActionSingleHeader}"
                                           Style="{StaticResource DeviceSectionTitleTextStyle}"/>
                            </Grid>

                            <Grid x:Name="DeviceActionGrid"
                                  Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                            <Button Grid.Row="0"
                                    Grid.Column="0"
                                    Command="{Binding RandomDeviceCommand}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Cellphone"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource DeviceManager_ActionRandomDevice}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button Grid.Row="0"
                                    Grid.Column="1"
                                    Command="{Binding ChangeDeviceCommand}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="CellphoneCog"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource DeviceManager_ActionChangeDevice}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button Grid.Row="2"
                                    Grid.Column="0"
                                    Command="{Binding RandomAndChangeDeviceCommand}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Sync"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource DeviceManager_ActionRandomAndChangeDevice}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button Grid.Row="1"
                                    Grid.Column="0"
                                    Command="{Binding RandomSimCommand}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="SimCard"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource DeviceManager_ActionRandomSim}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button Grid.Row="1"
                                    Grid.Column="1"
                                    Command="{Binding ChangeSimCommand}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="SimCard"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource DeviceManager_ActionChangeSim}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button Grid.Row="3"
                                    Grid.Column="0"
                                    Command="{Binding ChangeLocationCommand}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="MapMarker"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource DeviceManager_ActionChangeLocation}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button Grid.Row="3"
                                    Grid.Column="1"
                                    Command="{Binding ChangeTimezoneCommand}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="ClockOutline"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource DeviceManager_ActionChangeTimezone}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button Grid.Row="5"
                                    Grid.Column="0"
                                    Command="{Binding UpdateIntegrityCommand}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="ShieldCheck"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource DeviceManager_ActionUpdateIntegrity}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button Grid.Row="2"
                                    Grid.Column="1"
                                    Command="{Binding InstallApkCommand}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Android"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource DeviceManager_ActionInstallApk}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button Grid.Row="4"
                                    Grid.Column="0"
                                    Command="{Binding FakeProxyCommand}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Wifi"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource DeviceManager_ActionFakeProxy}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button Grid.Row="4"
                                    Grid.Column="1"
                                    Command="{Binding StopFakeProxyCommand}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="WifiOff"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource DeviceManager_ActionStopFakeProxy}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            </Grid>
                        </Grid>
                    </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource DeviceManager_TabFlashRom}"
                     Style="{StaticResource DeviceTabItemStyle}">
                <Grid>
                    <TextBlock Text="{DynamicResource DeviceManager_FlashRomPlaceholder}"
                               Style="{StaticResource DeviceFlashPlaceholderTextStyle}"/>
                </Grid>
            </TabItem>
        </TabControl>
        </Grid>
    </ScrollViewer>
</UserControl>
