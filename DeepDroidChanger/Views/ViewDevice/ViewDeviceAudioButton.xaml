<UserControl x:Class="DeepDroidChanger.Views.ViewDeviceAudioButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ViewDeviceControlsResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="AudioButtonStyle" TargetType="Button" BasedOn="{StaticResource ViewDeviceIconButtonStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAudioEnabled}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSelected}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                    </DataTrigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
        <Button Style="{StaticResource AudioButtonStyle}" Command="{Binding ToggleAudioCommand}"
                ToolTip="{DynamicResource ViewDevice_Audio}" AutomationProperties.Name="{DynamicResource ViewDevice_Audio}">
            <materialDesign:PackIcon Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                <materialDesign:PackIcon.Style>
                    <Style TargetType="materialDesign:PackIcon" BasedOn="{StaticResource PrimaryButtonIconStyle}">
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Kind" Value="VolumeOff"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsAudioEnabled}" Value="True"><Setter Property="Kind" Value="VolumeHigh"/></DataTrigger></Style.Triggers>
                    </Style>
                </materialDesign:PackIcon.Style>
            </materialDesign:PackIcon>
        </Button>
</UserControl>
