<Window x:Class="DeepDroidChanger.Views.ViewDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:models="clr-namespace:DeepDroidChanger.ViewDevices.Models;assembly=DeepDroidChanger.ViewDevices"
        xmlns:scrcpy="clr-namespace:ScrcpyNet.Wpf;assembly=ScrcpyNet.Wpf"
        xmlns:views="clr-namespace:DeepDroidChanger.Views"
        mc:Ignorable="d"
        Width="520"
        Height="820"
        MinWidth="320"
        MinHeight="240"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.WindowBackground}"
        TextElement.Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Metric.FontFamily}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <views:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

        <Style x:Key="ViewDeviceToolbarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.SurfaceAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.SurfacePressed}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ViewDeviceStatusDotStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource Brush.Warning}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:ViewDeviceSessionState.Running}">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:ViewDeviceSessionState.Failed}">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Danger}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="HeaderPanel"
                    Grid.Row="0"
                    Height="{StaticResource Metric.ToolbarMinHeight}"
                    Padding="12,0"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding DeviceName}"
                                   MaxWidth="260"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="{StaticResource Metric.FontSize.Body}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Serial}"
                                   Margin="8,0,0,0"
                                   MaxWidth="180"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   FontSize="{StaticResource Metric.FontSize.Micro}"
                                   VerticalAlignment="Center"
                                   ToolTip="{Binding Serial}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Ellipse Width="8"
                                 Height="8"
                                 Margin="0,0,6,0"
                                 Style="{StaticResource ViewDeviceStatusDotStyle}"/>
                        <TextBlock Text="{Binding StatusText}"
                                   MaxWidth="210"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   FontSize="{StaticResource Metric.FontSize.Small}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="ToolbarColumn" Width="54"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="StreamContainer"
                        Grid.Column="0"
                        Margin="8"
                        Background="Black"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Medium}"
                        ClipToBounds="True">
                    <Grid>
                        <scrcpy:ScrcpyDisplay x:Name="ScrcpyDisplay"
                                              Scrcpy="{Binding ScrcpyClient}"
                                              Focusable="True"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              Background="Black"/>

                        <Grid Background="{DynamicResource Brush.WindowBackground}"
                              Visibility="{Binding IsRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        MaxWidth="300"
                                        Margin="24">
                                <materialDesign:PackIcon Kind="Cellphone"
                                                         Width="54"
                                                         Height="54"
                                                         HorizontalAlignment="Center"
                                                         Foreground="{DynamicResource Brush.TextSecondary}"/>
                                <TextBlock Text="{Binding StatusText}"
                                           Margin="0,14,0,12"
                                           FontSize="{StaticResource Metric.FontSize.Body}"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"/>
                                <Button Style="{StaticResource FlatButtonStyle}"
                                        HorizontalAlignment="Center"
                                        Command="{Binding RetryCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Refresh"
                                                                 Width="16"
                                                                 Height="16"
                                                                 Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource ViewDevice_Retry}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="ToolbarPanel"
                        Grid.Column="1"
                        Background="{DynamicResource Brush.SurfaceAlt}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <Button Style="{StaticResource ViewDeviceToolbarButtonStyle}"
                                    Command="{Binding ToggleFullscreenCommand}"
                                    ToolTip="{DynamicResource ViewDevice_Fullscreen}">
                                <materialDesign:PackIcon Kind="Fullscreen"
                                                         Width="20"
                                                         Height="20"/>
                            </Button>
                            <Button Style="{StaticResource ViewDeviceToolbarButtonStyle}"
                                    Command="{Binding RotateCommand}"
                                    ToolTip="{DynamicResource ViewDevice_Rotate}">
                                <materialDesign:PackIcon Kind="ScreenRotation"
                                                         Width="20"
                                                         Height="20"/>
                            </Button>
                            <Separator/>
                            <Button Style="{StaticResource ViewDeviceToolbarButtonStyle}"
                                    Command="{Binding ScreenOnCommand}"
                                    ToolTip="{DynamicResource ViewDevice_ScreenOn}">
                                <materialDesign:PackIcon Kind="Brightness7"
                                                         Width="20"
                                                         Height="20"/>
                            </Button>
                            <Button Style="{StaticResource ViewDeviceToolbarButtonStyle}"
                                    Command="{Binding ScreenOffCommand}"
                                    ToolTip="{DynamicResource ViewDevice_ScreenOff}">
                                <materialDesign:PackIcon Kind="Brightness4"
                                                         Width="20"
                                                         Height="20"/>
                            </Button>
                            <Button Style="{StaticResource ViewDeviceToolbarButtonStyle}"
                                    Command="{Binding PowerCommand}"
                                    ToolTip="{DynamicResource ViewDevice_Power}">
                                <materialDesign:PackIcon Kind="Power"
                                                         Width="20"
                                                         Height="20"/>
                            </Button>
                            <Separator/>
                            <Button Style="{StaticResource ViewDeviceToolbarButtonStyle}"
                                    Command="{Binding VolumeUpCommand}"
                                    ToolTip="{DynamicResource ViewDevice_VolumeUp}">
                                <materialDesign:PackIcon Kind="VolumePlus"
                                                         Width="20"
                                                         Height="20"/>
                            </Button>
                            <Button Style="{StaticResource ViewDeviceToolbarButtonStyle}"
                                    Command="{Binding VolumeDownCommand}"
                                    ToolTip="{DynamicResource ViewDevice_VolumeDown}">
                                <materialDesign:PackIcon Kind="VolumeMinus"
                                                         Width="20"
                                                         Height="20"/>
                            </Button>
                            <Button Style="{StaticResource ViewDeviceToolbarButtonStyle}"
                                    Command="{Binding ScreenshotCommand}"
                                    ToolTip="{DynamicResource ViewDevice_Screenshot}">
                                <materialDesign:PackIcon Kind="Camera"
                                                         Width="20"
                                                         Height="20"/>
                            </Button>
                            <Button Style="{StaticResource ViewDeviceToolbarButtonStyle}"
                                    Command="{Binding ReconnectCommand}"
                                    ToolTip="{DynamicResource ViewDevice_Reconnect}">
                                <materialDesign:PackIcon Kind="Refresh"
                                                         Width="20"
                                                         Height="20"/>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <Separator/>
                            <Button Style="{StaticResource ViewDeviceToolbarButtonStyle}"
                                    Command="{Binding RecentCommand}"
                                    ToolTip="{DynamicResource ViewDevice_Recent}">
                                <materialDesign:PackIcon Kind="Apps"
                                                         Width="20"
                                                         Height="20"/>
                            </Button>
                            <Button Style="{StaticResource ViewDeviceToolbarButtonStyle}"
                                    Command="{Binding HomeCommand}"
                                    ToolTip="{DynamicResource ViewDevice_Home}">
                                <materialDesign:PackIcon Kind="Home"
                                                         Width="20"
                                                         Height="20"/>
                            </Button>
                            <Button Style="{StaticResource ViewDeviceToolbarButtonStyle}"
                                    Command="{Binding BackCommand}"
                                    ToolTip="{DynamicResource ViewDevice_Back}">
                                <materialDesign:PackIcon Kind="ArrowLeft"
                                                         Width="20"
                                                         Height="20"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
