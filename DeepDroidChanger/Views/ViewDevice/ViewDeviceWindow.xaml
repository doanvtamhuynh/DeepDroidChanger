<Window x:Class="DeepDroidChanger.Views.ViewDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:models="clr-namespace:DeepDroidChanger.ViewDevices.Models;assembly=DeepDroidChanger.ViewDevices"
        xmlns:scrcpy="clr-namespace:ScrcpyNet.Wpf;assembly=DeepDroidChanger.ViewDevices"
        xmlns:views="clr-namespace:DeepDroidChanger.Views"
        mc:Ignorable="d"
        Width="520"
        Height="656"
        MinWidth="320"
        MinHeight="240"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.WindowBackground}"
        TextElement.Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Metric.FontFamily}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <views:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

        <Style x:Key="ViewDeviceSettingsButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"
                             Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSelected}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                </DataTrigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ViewDeviceNavigationButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="Height" Value="{StaticResource Metric.DataGridEditorRowHeight}"/>
            <Setter Property="MinHeight" Value="{StaticResource Metric.DataGridEditorRowHeight}"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Small}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ViewDeviceStatusDotStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource Brush.Warning}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:ViewDeviceSessionState.Running}">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:ViewDeviceSessionState.Failed}">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Danger}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="HeaderPanel"
                    Grid.Row="0"
                    Height="{StaticResource Metric.ToolbarMinHeight}"
                    Padding="12,0"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0"
                          MinWidth="0"
                          ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding DeviceName}"
                                   MinWidth="0"
                                   MaxWidth="260"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="{StaticResource Metric.FontSize.Body}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Serial}"
                                   Margin="8,0,0,0"
                                   MinWidth="0"
                                   MaxWidth="120"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   FontSize="{StaticResource Metric.FontSize.Micro}"
                                   VerticalAlignment="Center"
                                   ToolTip="{Binding Serial}"/>
                    </Grid>

                    <StackPanel Grid.Column="1"
                                Margin="12,0,0,0"
                                MaxWidth="206"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Ellipse Width="8"
                                 Height="8"
                                 Margin="0,0,6,0"
                                 Style="{StaticResource ViewDeviceStatusDotStyle}"/>
                        <TextBlock Text="{Binding StatusText}"
                                   MaxWidth="190"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   FontSize="{StaticResource Metric.FontSize.Small}"/>
                    </StackPanel>

                    <Button x:Name="SettingsButton"
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            Style="{StaticResource ViewDeviceSettingsButtonStyle}"
                            ToolTip="{DynamicResource ViewDevice_ToggleTools}"
                            Click="OnSettingsClick">
                        <materialDesign:PackIcon Kind="Cog"
                                                 Width="19"
                                                 Height="19"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="StreamContainer"
                        Grid.Row="0"
                        Margin="8"
                        Background="Black"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Medium}"
                        AllowDrop="True"
                        PreviewDragEnter="OnPreviewDragEnter"
                        PreviewDragLeave="OnPreviewDragLeave"
                        PreviewDragOver="OnPreviewDragOver"
                        Drop="OnDrop"
                        ClipToBounds="True">
                    <Grid>
                        <Grid x:Name="RotatedDisplayHost"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">
                            <Grid.LayoutTransform>
                                <RotateTransform x:Name="ViewRotationTransform"
                                                 Angle="0"/>
                            </Grid.LayoutTransform>
                            <scrcpy:ScrcpyDisplay x:Name="ScrcpyDisplay"
                                                  Scrcpy="{Binding ScrcpyClient}"
                                                  Focusable="True"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  Background="Black"/>
                        </Grid>

                        <Grid Background="{DynamicResource Brush.WindowBackground}"
                              Visibility="{Binding IsRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        MaxWidth="300"
                                        Margin="24">
                                <materialDesign:PackIcon Kind="Cellphone"
                                                         Width="54"
                                                         Height="54"
                                                         HorizontalAlignment="Center"
                                                         Foreground="{DynamicResource Brush.TextSecondary}"/>
                                <TextBlock Text="{Binding StatusText}"
                                           Margin="0,14,0,12"
                                           FontSize="{StaticResource Metric.FontSize.Body}"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"/>
                                <Button Style="{StaticResource FlatButtonStyle}"
                                        HorizontalAlignment="Center"
                                        Command="{Binding RetryCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Refresh"
                                                                 Width="16"
                                                                 Height="16"
                                                                 Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource ViewDevice_Retry}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border x:Name="PackageDropOverlay"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Brush.Overlay}"
                                BorderBrush="{DynamicResource Brush.Accent}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Overlay}"
                                Padding="18,12"
                                Margin="16">
                            <TextBlock Text="{DynamicResource ViewDevice_DropPackageOverlay}"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </Border>

                <Grid x:Name="NavigationPanel"
                      Grid.Row="1"
                      Margin="8,0,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="RecentButton"
                            Grid.Column="0"
                            Style="{StaticResource ViewDeviceNavigationButtonStyle}"
                            Command="{Binding RecentCommand}">
                        <StackPanel HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="Apps"
                                                     Width="16"
                                                     Height="16"
                                                     HorizontalAlignment="Center"
                                                     Margin="0,0,0,2"/>
                            <TextBlock Text="{DynamicResource ViewDevice_Recent}"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="HomeButton"
                            Grid.Column="2"
                            Style="{StaticResource ViewDeviceNavigationButtonStyle}"
                            Command="{Binding HomeCommand}">
                        <StackPanel HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="Home"
                                                     Width="16"
                                                     Height="16"
                                                     HorizontalAlignment="Center"
                                                     Margin="0,0,0,2"/>
                            <TextBlock Text="{DynamicResource ViewDevice_Home}"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BackButton"
                            Grid.Column="4"
                            Style="{StaticResource ViewDeviceNavigationButtonStyle}"
                            Command="{Binding BackCommand}">
                        <StackPanel HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="ArrowLeft"
                                                     Width="16"
                                                     Height="16"
                                                     HorizontalAlignment="Center"
                                                     Margin="0,0,0,2"/>
                            <TextBlock Text="{DynamicResource ViewDevice_Back}"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
