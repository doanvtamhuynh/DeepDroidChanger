<Window x:Class="DeepDroidChanger.Views.ViewDeviceToolDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource ViewDevice_DeviceTools}"
        Width="350"
        MinWidth="320"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        TextElement.Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{DynamicResource Metric.FontFamily}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="DetailButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="MinHeight" Value="{DynamicResource Metric.ControlHeight}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="{DynamicResource Metric.FontSize.Small}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DetailFileActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="MinHeight" Value="{DynamicResource Metric.ControlHeight}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        </Style>

        <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Metric.FontSize.Small}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        </Style>

        <Style x:Key="DetailPanelStyle" TargetType="Border">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="{StaticResource Metric.BorderThickness.Uniform}"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}"/>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Margin="8"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="{StaticResource Metric.BorderThickness.Uniform}"
            CornerRadius="{StaticResource Radius.Overlay}">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource Color.Overlay}"
                              BlurRadius="{StaticResource Metric.Elevation.FloatingBlurRadius}"
                              ShadowDepth="{StaticResource Metric.Elevation.FloatingShadowDepth}"
                              Direction="270"
                              Opacity="{StaticResource Metric.Elevation.FloatingShadowOpacity}"/>
        </Border.Effect>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="{StaticResource Spacing.CardPadding.Compact}">
                <Border x:Name="RenameContent"
                        Style="{StaticResource DetailPanelStyle}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ViewDevice_RenameConfig}"
                                   Style="{StaticResource DetailLabelStyle}"/>
                        <TextBox x:Name="RenameTextBox"
                                 Text="{Binding RenameName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FlatTextBoxStyle}"
                                 Margin="0,8,0,8"/>
                        <Button x:Name="RenameSaveButton"
                                Style="{StaticResource DetailButtonStyle}"
                                HorizontalAlignment="Right"
                                Command="{Binding SaveRenameConfigCommand}"
                                Content="{DynamicResource ViewDevice_Save}"/>
                    </StackPanel>
                </Border>

                <Border x:Name="InputAdbContent"
                        Style="{StaticResource DetailPanelStyle}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ViewDevice_InputTextPrompt}"
                                   Style="{StaticResource DetailLabelStyle}"/>
                        <TextBox x:Name="InputTextBox"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FlatTextBoxStyle}"
                                 Margin="0,8,0,4"/>
                        <Button x:Name="InputButton"
                                Style="{StaticResource DetailButtonStyle}"
                                HorizontalAlignment="Right"
                                Command="{Binding InputDeviceTextCommand}"
                                Content="{DynamicResource ViewDevice_Input}"/>
                        <TextBlock Text="{DynamicResource ViewDevice_AdbShellPrompt}"
                                   Style="{StaticResource DetailLabelStyle}"
                                   Margin="0,10,0,0"/>
                        <TextBox x:Name="AdbShellCommandTextBox"
                                 Text="{Binding AdbShellCommand, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FlatTextBoxStyle}"
                                 Margin="0,8,0,4"/>
                        <Button x:Name="RunAdbShellButton"
                                Style="{StaticResource DetailButtonStyle}"
                                HorizontalAlignment="Right"
                                Command="{Binding RunAdbShellCommand}"
                                Content="{DynamicResource ViewDevice_Run}"/>
                    </StackPanel>
                </Border>

                <Border x:Name="FileTransferContent"
                        Style="{StaticResource DetailPanelStyle}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ViewDevice_ImportExportTitle}"
                                   Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Text="{DynamicResource ViewDevice_ComputerFilePath}"
                                   Style="{StaticResource DetailLabelStyle}"
                                   Margin="0,10,0,0"/>
                        <Grid Margin="0,6,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ComputerFilePathTextBox"
                                     Grid.Column="0"
                                     Text="{Binding ComputerFilePath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FlatTextBoxStyle}"
                                     Margin="0,0,4,0"/>
                            <Button x:Name="BrowseComputerFileButton"
                                    Grid.Column="1"
                                    MinWidth="78"
                                    Style="{StaticResource DetailButtonStyle}"
                                    Command="{Binding BrowseComputerFileCommand}"
                                    Content="{DynamicResource ViewDevice_Browse}"/>
                        </Grid>
                        <TextBlock Text="{DynamicResource ViewDevice_AndroidFilePath}"
                                   Style="{StaticResource DetailLabelStyle}"/>
                        <TextBox x:Name="AndroidFilePathTextBox"
                                 Text="{Binding AndroidFilePath, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FlatTextBoxStyle}"
                                 Margin="0,6,0,8"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ImportButton"
                                    Grid.Column="0"
                                    Style="{StaticResource DetailFileActionButtonStyle}"
                                    Command="{Binding ImportFileCommand}">
                                <DockPanel LastChildFill="True">
                                    <materialDesign:PackIcon Kind="Upload"
                                                             VerticalAlignment="Center" Width="15"
                                                             Height="15"
                                                             Margin="0,0,5,0"/>
                                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="{DynamicResource Metric.FontSize.Small}" Text="{DynamicResource ViewDevice_Import}"/>
                                </DockPanel>
                            </Button>
                            <Button x:Name="ExportButton"
                                    Grid.Column="2"
                                    Style="{StaticResource DetailFileActionButtonStyle}"
                                    Command="{Binding ExportFileCommand}">
                                <DockPanel LastChildFill="True">
                                    <materialDesign:PackIcon Kind="Download"
                                                             VerticalAlignment="Center" Width="15"
                                                             Height="15"
                                                             Margin="0,0,5,0"/>
                                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="{DynamicResource Metric.FontSize.Small}" Text="{DynamicResource ViewDevice_Export}"/>
                                </DockPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="DetailStatusText"
                           Text="{Binding ToolStatusText}"
                           Visibility="{Binding HasToolStatus, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           TextWrapping="Wrap"
                           Margin="2,8,2,0"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
