<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <GridLength x:Key="ViewDevice.ControlGap">8</GridLength>
    <Thickness x:Key="ViewDevice.ControlSpacing">8,0,0,0</Thickness>
    <Thickness x:Key="ViewDevice.ControlBottomSpacing">0,0,0,8</Thickness>
    <Thickness x:Key="ViewDevice.ControlCellSpacing">4</Thickness>

    <Style x:Key="ViewDeviceOutlinedButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Metric.BorderThickness.Uniform}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ViewDeviceIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ViewDeviceOutlinedButtonStyle}">
        <Setter Property="Width" Value="{StaticResource Metric.ControlHeight}"/>
        <Setter Property="Height" Value="{StaticResource Metric.ControlHeight}"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>
