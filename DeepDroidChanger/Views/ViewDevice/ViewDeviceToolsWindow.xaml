<Window x:Class="DeepDroidChanger.Views.ViewDeviceToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource ViewDevice_DeviceTools}"
        Width="310"
        MinWidth="280"
        Height="656"
        MinHeight="240"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        TextElement.Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Metric.FontFamily}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="ViewDeviceToolActionStyle"
               TargetType="Button"
               BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.SurfacePressed}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ViewDeviceToolQuickButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.SurfacePressed}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ViewDeviceToolInlineButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Small}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        </Style>

        <Style x:Key="ViewDeviceToolIconStyle" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                             Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ViewDeviceToolTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Metric.FontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                             Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ViewDeviceToolQuickTitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource ViewDeviceToolTitleStyle}">
            <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Small}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ViewDeviceToolScreenQuickTitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource ViewDeviceToolQuickTitleStyle}">
            <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Micro}"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Margin="8"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="{StaticResource Metric.BorderThickness.Uniform}"
            CornerRadius="{StaticResource Radius.Overlay}">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource Color.Overlay}"
                              BlurRadius="{StaticResource Metric.Elevation.FloatingBlurRadius}"
                              ShadowDepth="{StaticResource Metric.Elevation.FloatingShadowDepth}"
                              Direction="270"
                              Opacity="{StaticResource Metric.Elevation.FloatingShadowOpacity}"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="HeaderPanel"
                    Grid.Row="0"
                    Height="{StaticResource Metric.ToolbarMinHeight}"
                    Padding="12,0"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="CellphoneCog"
                                             Width="20"
                                             Height="20"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource Brush.Accent}"/>
                    <TextBlock Grid.Column="1"
                               Text="{DynamicResource ViewDevice_DeviceTools}"
                               Margin="10,0,0,0"
                               FontSize="{StaticResource Metric.FontSize.Subtitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <ScrollViewer x:Name="ActionsScrollViewer"
                          Grid.Row="1"
                          Padding="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="True">
                <StackPanel x:Name="ActionsPanel"
                            Margin="{StaticResource Spacing.CardPadding.Compact}">
                    <Grid x:Name="QuickControlsPanel" Margin="0,0,0,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="VolumeDownButton"
                                Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource ViewDeviceToolQuickButtonStyle}"
                                Command="{Binding VolumeDownCommand}"
                                ToolTip="{DynamicResource ViewDevice_VolumeDownDescription}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Minus"
                                                         Width="15"
                                                         Height="15"
                                                         Margin="0,0,5,0"
                                                         Foreground="{DynamicResource Brush.Accent}"/>
                                <TextBlock Text="{DynamicResource ViewDevice_VolumeShort}"
                                           Style="{StaticResource ViewDeviceToolQuickTitleStyle}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="VolumeUpButton"
                                Grid.Row="0"
                                Grid.Column="1"
                                Style="{StaticResource ViewDeviceToolQuickButtonStyle}"
                                Command="{Binding VolumeUpCommand}"
                                ToolTip="{DynamicResource ViewDevice_VolumeUpDescription}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus"
                                                         Width="15"
                                                         Height="15"
                                                         Margin="0,0,5,0"
                                                         Foreground="{DynamicResource Brush.Accent}"/>
                                <TextBlock Text="{DynamicResource ViewDevice_VolumeShort}"
                                           Style="{StaticResource ViewDeviceToolQuickTitleStyle}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="PowerButton"
                                Grid.Row="0"
                                Grid.Column="2"
                                Style="{StaticResource ViewDeviceToolQuickButtonStyle}"
                                Command="{Binding PowerCommand}"
                                ToolTip="{DynamicResource ViewDevice_PowerDescription}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Power"
                                                         Width="15"
                                                         Height="15"
                                                         Margin="0,0,5,0"
                                                         Foreground="{DynamicResource Brush.Accent}"/>
                                <TextBlock Text="{DynamicResource ViewDevice_Power}"
                                           Style="{StaticResource ViewDeviceToolQuickTitleStyle}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ReconnectButton"
                                Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource ViewDeviceToolQuickButtonStyle}"
                                Command="{Binding ReconnectCommand}"
                                ToolTip="{DynamicResource ViewDevice_ReconnectDescription}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh"
                                                         Width="14"
                                                         Height="14"
                                                         Margin="0,0,4,0"
                                                         Foreground="{DynamicResource Brush.Accent}"/>
                                <TextBlock Text="{DynamicResource ViewDevice_Reconnect}"
                                           Style="{StaticResource ViewDeviceToolQuickTitleStyle}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ScreenButton"
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource ViewDeviceToolQuickButtonStyle}"
                                Command="{Binding ToggleScreenCommand}"
                                IsEnabled="{Binding IsScreenActionAvailable}"
                                ToolTip="{DynamicResource ViewDevice_ScreenToggleDescription}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Monitor"
                                                         Width="14"
                                                         Height="14"
                                                         Margin="0,0,3,0"
                                                         Foreground="{DynamicResource Brush.Accent}"/>
                                <TextBlock Text="{DynamicResource ViewDevice_ScreenOnOff}"
                                           Style="{StaticResource ViewDeviceToolScreenQuickTitleStyle}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="RebootButton"
                                Grid.Row="1"
                                Grid.Column="2"
                                Style="{StaticResource ViewDeviceToolQuickButtonStyle}"
                                Command="{Binding RebootDeviceCommand}"
                                ToolTip="{DynamicResource ViewDevice_RestartDescription}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Restart"
                                                         Width="14"
                                                         Height="14"
                                                         Margin="0,0,5,0"
                                                         Foreground="{DynamicResource Brush.Warning}"/>
                                <TextBlock Text="{DynamicResource ViewDevice_Reboot}"
                                           Style="{StaticResource ViewDeviceToolQuickTitleStyle}"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Button x:Name="RenameConfigButton"
                            Style="{StaticResource ViewDeviceToolActionStyle}"
                            Command="{Binding RenameConfigCommand}"
                            ToolTip="{DynamicResource ViewDevice_RenameConfigDescription}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Pencil"
                                                     Style="{StaticResource ViewDeviceToolIconStyle}"/>
                            <TextBlock Text="{DynamicResource ViewDevice_RenameConfig}"
                                       Style="{StaticResource ViewDeviceToolTitleStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="InputAdbButton"
                            Style="{StaticResource ViewDeviceToolActionStyle}"
                            Command="{Binding InputAdbCommand}"
                            ToolTip="{DynamicResource ViewDevice_InputAdbDescription}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Console"
                                                     Style="{StaticResource ViewDeviceToolIconStyle}"/>
                            <TextBlock Text="{DynamicResource ViewDevice_InputAdb}"
                                       Style="{StaticResource ViewDeviceToolTitleStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="RotateScreenButton"
                            Style="{StaticResource ViewDeviceToolActionStyle}"
                            Command="{Binding RotateViewCommand}"
                            ToolTip="{DynamicResource ViewDevice_RotateScreenDescription}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="RotateRight"
                                                     Style="{StaticResource ViewDeviceToolIconStyle}"/>
                            <TextBlock Text="{DynamicResource ViewDevice_RotateScreen}"
                                       Style="{StaticResource ViewDeviceToolTitleStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="FileTransferButton"
                            Style="{StaticResource ViewDeviceToolActionStyle}"
                            Command="{Binding FileTransferCommand}"
                            ToolTip="{DynamicResource ViewDevice_ImportExportDescription}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="SwapHorizontal"
                                                     Style="{StaticResource ViewDeviceToolIconStyle}"/>
                            <TextBlock Text="{DynamicResource ViewDevice_ImportExport}"
                                       Style="{StaticResource ViewDeviceToolTitleStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="WifiButton"
                            Style="{StaticResource ViewDeviceToolActionStyle}"
                            Command="{Binding ToggleWifiCommand}"
                            IsEnabled="{Binding IsWifiActionAvailable}"
                            ToolTip="{DynamicResource ViewDevice_WifiDescription}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Wifi"
                                                     Style="{StaticResource ViewDeviceToolIconStyle}"/>
                            <TextBlock Text="{Binding WifiActionText}"
                                       Style="{StaticResource ViewDeviceToolTitleStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ScreenshotButton"
                            Style="{StaticResource ViewDeviceToolActionStyle}"
                            Command="{Binding ScreenshotCommand}"
                            ToolTip="{DynamicResource ViewDevice_ScreenshotDescription}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Camera"
                                                     Style="{StaticResource ViewDeviceToolIconStyle}"/>
                            <TextBlock Text="{DynamicResource ViewDevice_Screenshot}"
                                       Style="{StaticResource ViewDeviceToolTitleStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="InstallPackageButton"
                            Style="{StaticResource ViewDeviceToolActionStyle}"
                            Command="{Binding InstallPackageCommand}"
                            ToolTip="{DynamicResource ViewDevice_InstallPackageDescription}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PackageVariant"
                                                     Style="{StaticResource ViewDeviceToolIconStyle}"/>
                            <TextBlock Text="{DynamicResource ViewDevice_InstallPackage}"
                                       Style="{StaticResource ViewDeviceToolTitleStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="GmsButton"
                            Style="{StaticResource ViewDeviceToolActionStyle}"
                            Command="{Binding ToggleGmsCommand}"
                            IsEnabled="{Binding IsGmsActionAvailable}"
                            ToolTip="{DynamicResource ViewDevice_GmsDescription}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Google"
                                                     Style="{StaticResource ViewDeviceToolIconStyle}"/>
                            <TextBlock Text="{Binding GmsActionText}"
                                       Style="{StaticResource ViewDeviceToolTitleStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="PlayStoreButton"
                            Style="{StaticResource ViewDeviceToolActionStyle}"
                            Command="{Binding TogglePlayStoreCommand}"
                            IsEnabled="{Binding IsPlayStoreActionAvailable}"
                            ToolTip="{DynamicResource ViewDevice_PlayStoreDescription}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="GooglePlay"
                                                     Style="{StaticResource ViewDeviceToolIconStyle}"/>
                            <TextBlock Text="{Binding PlayStoreActionText}"
                                       Style="{StaticResource ViewDeviceToolTitleStyle}"/>
                        </StackPanel>
                    </Button>

                    <TextBlock x:Name="ToolStatusText"
                               Text="{Binding ToolStatusText}"
                               Visibility="{Binding HasToolStatus, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               TextWrapping="Wrap"
                               Margin="2,8,2,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
