
<UserControl x:Class="DeepDroidChanger.Views.ChangeSingleDeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:DeepDroidChanger.Behaviors"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:models="clr-namespace:DeepDroidChanger.Models"
             Background="Transparent">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="ChangeSingleDeviceGridStyle"
               TargetType="DataGrid"
               BasedOn="{StaticResource FlatDataGridStyle}">
            <Setter Property="MinHeight"
                    Value="220"/>
            <Setter Property="RowHeight"
                    Value="{StaticResource Metric.DataGridEditorRowHeight}"/>
            <Setter Property="MaxHeight"
                    Value="412"/>
            <Setter Property="GridLinesVisibility"
                    Value="All"/>
            <Setter Property="AlternationCount"
                    Value="2"/>
            <Setter Property="HorizontalGridLinesBrush"
                    Value="{DynamicResource Brush.Border}"/>
            <Setter Property="VerticalGridLinesBrush"
                    Value="{DynamicResource Brush.Border}"/>
            <Setter Property="ColumnHeaderStyle"
                    Value="{StaticResource DeviceTableColumnHeaderStyle}"/>
            <Setter Property="CellStyle"
                    Value="{StaticResource DeviceTableCellStyle}"/>
            <Setter Property="HorizontalScrollBarVisibility"
                    Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility"
                    Value="Auto"/>
            <Setter Property="RowStyle"
                    Value="{DynamicResource DeviceGridRowContextMenuStyle}"/>
        </Style>

        <Style x:Key="DeviceGridRowContextMenuStyle"
               TargetType="DataGridRow"
               BasedOn="{StaticResource DeviceTableRowStyle}">
            <EventSetter Event="ContextMenuOpening"
                         Handler="OnDeviceRowContextMenuOpening"/>
            <Setter Property="FocusVisualStyle"
                    Value="{StaticResource AppFocusVisualStyle}"/>
            <Setter Property="Tag"
                    Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
            <Setter Property="ContextMenu"
                    Value="{DynamicResource DeviceActionsContextMenu}"/>
        </Style>

        <Thickness x:Key="DeviceProfilePanelContentMargin">0,0,16,0</Thickness>

        <Style x:Key="ChangeSingleDeviceCellStretchStyle"
               TargetType="DataGridCell"
               BasedOn="{StaticResource DeviceTableCellStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="ChangeSingleDeviceStopCellStyle"
               TargetType="DataGridCell"
               BasedOn="{StaticResource ChangeSingleDeviceCellStretchStyle}">
            <!-- The Stop button owns the two-pixel inset explicitly. Keeping the cell
                 padding at zero avoids doubling the inset when a theme template binds it. -->
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="ChangeSingleDeviceSelectionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style x:Key="DeviceSectionBorderStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource Brush.SurfaceAlt}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="{StaticResource Radius.Medium}"/>
            <Setter Property="Padding"
                    Value="14,12"/>
        </Style>

        <Style x:Key="DeviceInfoSectionBorderStyle"
               TargetType="Border"
               BasedOn="{StaticResource DeviceSectionBorderStyle}">
            <Setter Property="Margin"
                    Value="0,0,12,0"/>
        </Style>

        <Style x:Key="DeviceActionSectionBorderStyle"
               TargetType="Border"
               BasedOn="{StaticResource DeviceSectionBorderStyle}">
            <Setter Property="Padding"
                    Value="10,12,10,8"/>
        </Style>

        <Style x:Key="DeviceSectionHeaderGridStyle"
               TargetType="Grid">
            <!-- Keep every panel header at the tallest standard control height so
                 each separator lands on the same horizontal line. -->
            <Setter Property="Height"
                    Value="{StaticResource Metric.ControlHeight}"/>
            <!-- Leave a five-pixel breathing space between the title and line. -->
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="DeviceSectionHeaderSeparatorStyle"
               TargetType="Border">
            <Setter Property="Height"
                    Value="{StaticResource Metric.BorderThickness}"/>
            <Setter Property="Background"
                    Value="{DynamicResource Brush.Border}"/>
            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>
            <Setter Property="VerticalAlignment"
                    Value="Bottom"/>
        </Style>

        <Style x:Key="DeviceSectionIconStyle"
               TargetType="materialDesign:PackIcon">
            <Setter Property="Width"
                    Value="20"/>
            <Setter Property="Height"
                    Value="20"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="Margin"
                    Value="0,0,10,0"/>
        </Style>

        <Style x:Key="DeviceSectionTitleTextStyle"
               TargetType="TextBlock">
            <Setter Property="FontFamily"
                    Value="{StaticResource Metric.FontFamily}"/>
            <Setter Property="FontSize"
                    Value="{StaticResource Metric.FontSize.Body}"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="ExternalDeviceActionBadgeStyle"
               TargetType="Border"
               BasedOn="{StaticResource DeviceTableBadgeStyle}">
            <Setter Property="Background"
                    Value="{DynamicResource Brush.DeviceStatusNegativeBackground}"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MaxWidth" Value="260"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextElement.Foreground"
                    Value="{DynamicResource Brush.Danger}"/>
        </Style>

        <Style x:Key="ExternalDeviceActionBadgeTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource DeviceTableBadgeTextStyle}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextAlignment" Value="Left"/>
        </Style>

        <Style x:Key="DeviceInfoFormGridStyle"
               TargetType="Grid">
            <Setter Property="VerticalAlignment"
                    Value="Top"/>
        </Style>

        <Style x:Key="DeviceFormLabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource AppLabelTextStyle}">
            <Setter Property="Margin"
                    Value="0,0,8,0"/>
            <Setter Property="TextWrapping"
                    Value="NoWrap"/>
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="DeviceFormSecondaryLabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource DeviceFormLabelStyle}">
            <Setter Property="Margin"
                    Value="10,0,8,0"/>
        </Style>

        <Style x:Key="DeviceTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource FlatTextBoxStyle}">
            <Setter Property="Margin"
                    Value="0,0,0,8"/>
            <Setter Property="materialDesign:HintAssist.Foreground"
                    Value="{DynamicResource Brush.TextDisabled}"/>
        </Style>

        <Style x:Key="DeviceComboBoxItemStyle"
               TargetType="ComboBoxItem"
               BasedOn="{StaticResource FlatComboBoxItemStyle}">
            <Setter Property="Padding"
                    Value="10,6"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>
        </Style>

        <Style x:Key="DeviceComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource FlatComboBoxStyle}">
            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>
            <Setter Property="Margin"
                    Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>
            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource DeviceComboBoxItemStyle}"/>
        </Style>

        <Style x:Key="DeviceActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource MaterialPrimaryButtonStyle}">
            <Setter Property="Background"
                    Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="BorderBrush"

                    Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource Brush.AccentForeground}"/>
            <Setter Property="Height"
                    Value="36"/>
            <Setter Property="Margin"
                    Value="0,0,5,4"/>
            <Setter Property="Padding"
                    Value="8,0"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius"
                    Value="{StaticResource Radius.Medium}"/>
            <Setter Property="materialDesign:RippleAssist.Feedback"
                    Value="{DynamicResource Brush.AccentForeground}"/>
            <Setter Property="materialDesign:RippleAssist.RippleOnTop"
                    Value="True"/>
            <Setter Property="materialDesign:ElevationAssist.Elevation"
                    Value="Dp1"/>
        </Style>

        <Style x:Key="DeviceStopActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DeviceActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource Brush.Danger}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="materialDesign:RippleAssist.Feedback"
                    Value="{DynamicResource Brush.AccentForeground}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.DangerHover}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.DangerPressed}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerPressed}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeviceActionButtonTextStyle"
               TargetType="TextBlock">
            <Setter Property="FontFamily"
                    Value="{StaticResource Metric.FontFamily}"/>
            <Setter Property="FontSize"
                    Value="{StaticResource Metric.FontSize.Small}"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="TextWrapping"
                    Value="NoWrap"/>
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>
            <Setter Property="TextAlignment"
                    Value="Left"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>

        <Style x:Key="DeviceInfoDetailsButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DeviceActionButtonStyle}">
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>

    <Style x:Key="DeviceLoadToolbarStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <Style x:Key="DeviceLoadButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource MaterialPrimaryButtonStyle}">
        <Setter Property="Background"
                Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="16,0,16,0"/>
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="{StaticResource Radius.ExtraSmall}"/>
        <Setter Property="materialDesign:RippleAssist.Feedback" Value="{DynamicResource Brush.AccentForeground}"/>
        <Setter Property="materialDesign:RippleAssist.RippleOnTop" Value="True"/>
        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2"/>
    </Style>

    <Style x:Key="DeviceLoadButtonContentStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DeviceLoadCountTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="10,0,0,0"/>
    </Style>

    <Style x:Key="DeviceFilterLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style x:Key="DeviceFilterComboBoxStyle"
           TargetType="ComboBox"
           BasedOn="{StaticResource FlatComboBoxStyle}">
        <Setter Property="Width"
                Value="156"/>
        <Setter Property="VerticalAlignment"
                Value="Center"/>
        <Setter Property="HorizontalContentAlignment"
                Value="Left"/>
        <Setter Property="ItemContainerStyle"
                Value="{StaticResource DeviceComboBoxItemStyle}"/>
    </Style>
    <Style x:Key="DeviceSearchTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DialogSearchTextBoxStyle}">
        <Setter Property="MaxWidth" Value="340"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="14,0,14,0"/>
    </Style>

    </UserControl.Resources>
    <Grid>
        <Grid x:Name="ChangeSingleDeviceRootGrid"
              Style="{StaticResource PageRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"
                           MinHeight="220"/>
            <RowDefinition Height="312"
                           MinHeight="312"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0"
              Style="{StaticResource DeviceLoadToolbarStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{Binding AddNewDevicesCommand}"
                    ToolTip="{DynamicResource Shared_TooltipAction}"
                    Style="{StaticResource DeviceLoadButtonStyle}">
                <StackPanel Style="{StaticResource DeviceLoadButtonContentStyle}">
                    <materialDesign:PackIcon Kind="Plus"
                                             Style="{StaticResource PrimaryButtonIconStyle}"/>
                    <TextBlock Text="{DynamicResource ChangeSingleDevice_AddNewDevices}"
                               Style="{StaticResource PrimaryButtonTextStyle}"/>
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1"
                       Text="{Binding NewDeviceCountText}"
                       Style="{StaticResource DeviceLoadCountTextStyle}"/>

            <TextBox Grid.Column="2"
                     Text="{Binding DeviceSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{DynamicResource Shared_TooltipSearch}"
                     AutomationProperties.Name="{DynamicResource ChangeSingleDevice_DeviceSearchName}"
                     materialDesign:HintAssist.Hint="{DynamicResource ChangeSingleDevice_DeviceSearchHint}"
                     Style="{StaticResource DeviceSearchTextBoxStyle}"/>

            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource ChangeSingleDevice_FilterLabel}"
                           Style="{StaticResource DeviceFilterLabelStyle}"/>
                <ComboBox SelectedValue="{Binding SelectedDeviceFilter, Mode=TwoWay}"
                          SelectedValuePath="Tag"
                          ToolTip="{DynamicResource ChangeSingleDevice_FilterTooltip}"
                          Style="{StaticResource DeviceFilterComboBoxStyle}">
                    <ComboBoxItem Tag="All"
                                  Content="{DynamicResource ChangeSingleDevice_FilterAll}"
                                  Style="{StaticResource DeviceComboBoxItemStyle}"/>
                    <ComboBoxItem Tag="Online"
                                  Content="{DynamicResource ChangeSingleDevice_FilterOnline}"
                                  Style="{StaticResource DeviceComboBoxItemStyle}"/>
                    <ComboBoxItem Tag="Offline"
                                  Content="{DynamicResource ChangeSingleDevice_FilterOffline}"
                                  Style="{StaticResource DeviceComboBoxItemStyle}"/>
                    <ComboBoxItem Tag="Active"
                                  Content="{DynamicResource ChangeSingleDevice_FilterActive}"
                                  Style="{StaticResource DeviceComboBoxItemStyle}"/>
                    <ComboBoxItem Tag="Inactive"
                                  Content="{DynamicResource ChangeSingleDevice_FilterInactive}"
                                  Style="{StaticResource DeviceComboBoxItemStyle}"/>
                </ComboBox>
            </StackPanel>
        </Grid>
        <DataGrid x:Name="DeviceGrid"
                  Grid.Row="1"
                  ItemsSource="{Binding Devices}"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  PreviewMouseRightButtonDown="OnDeviceGridPreviewMouseRightButtonDown"
                  behaviors:DeviceTableColumnLayoutBehavior.PersistColumnRatios="True"
                  behaviors:DeviceTableColumnLayoutBehavior.ColumnRatios="{Binding DeviceTableColumnRatios}"
                  behaviors:DeviceTableColumnLayoutBehavior.SaveColumnRatiosCommand="{Binding SaveSingleDeviceColumnRatiosCommand}"
                  Style="{StaticResource ChangeSingleDeviceGridStyle}">
            <DataGrid.Columns>
                <DataGridTemplateColumn behaviors:DeviceTableColumnLayoutBehavior.ColumnKey="Selected"
                                        Width="0.55*"
                                        MinWidth="72"
                                        CellStyle="{StaticResource ChangeSingleDeviceCellStretchStyle}">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{DynamicResource ChangeSingleDevice_ColumnSelected}"
                                   Style="{StaticResource DataGridColumnHeaderTextStyle}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.ToggleDeviceSelectionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="{DynamicResource ChangeSingleDevice_ColumnSelected}"
                    ToolTip="{DynamicResource Shared_TooltipSelectRow}"
                                    Style="{StaticResource ChangeSingleDeviceSelectionButtonStyle}">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}"
                                          IsHitTestVisible="False"
                                          Focusable="False"
                                          ToolTip="{DynamicResource Shared_TooltipSelectRow}"
                                          Style="{StaticResource DataGridCheckBoxStyle}"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Binding="{Binding Serial}"
                                    behaviors:DeviceTableColumnLayoutBehavior.ColumnKey="Serial"
                                    Width="1.05*"
                                    MinWidth="110"
                                    IsReadOnly="True"
                                    ElementStyle="{StaticResource DataGridLeftCellTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource ChangeSingleDevice_ColumnSerial}"
                                   Style="{StaticResource DataGridColumnHeaderTextStyle}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTemplateColumn behaviors:DeviceTableColumnLayoutBehavior.ColumnKey="Name"
                                        Width="1.05*"
                                        MinWidth="110"
                                        CellStyle="{StaticResource ChangeSingleDeviceCellStretchStyle}">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{DynamicResource ChangeSingleDevice_ColumnName}"
                                   Style="{StaticResource DataGridColumnHeaderTextStyle}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanEdit}"
                                     ToolTip="{DynamicResource Shared_TooltipDeviceName}"
                                     Style="{StaticResource InlineDataGridTextBoxStyle}"
                                     materialDesign:HintAssist.Hint="{DynamicResource Shared_DeviceNameHint}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn behaviors:DeviceTableColumnLayoutBehavior.ColumnKey="Type"
                                        Width="0.9*"
                                        MinWidth="90"
                                        CellStyle="{StaticResource ChangeSingleDeviceCellStretchStyle}">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{DynamicResource ChangeSingleDevice_ColumnType}"
                                   Style="{StaticResource DataGridColumnHeaderTextStyle}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.TypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedItem="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanEdit}"
                                      ToolTip="{DynamicResource Shared_TooltipDeviceType}"
                                      Style="{StaticResource InlineDataGridComboBoxStyle}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn SortMemberPath="Active"
                                        behaviors:DeviceTableColumnLayoutBehavior.ColumnKey="Active"
                                        Width="1.05*"
                                        MinWidth="110"
                                        IsReadOnly="True">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{DynamicResource ChangeSingleDevice_ColumnActive}"
                                   Style="{StaticResource DataGridColumnHeaderTextStyle}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DeviceTableActiveBadgeStyle}">
                                <TextBlock Text="{Binding Active}" Style="{StaticResource DeviceTableBadgeTextStyle}" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn SortMemberPath="Status"
                                        behaviors:DeviceTableColumnLayoutBehavior.ColumnKey="Status"
                                        Width="1*"
                                        MinWidth="100"
                                        IsReadOnly="True">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{DynamicResource ChangeSingleDevice_ColumnStatus}"
                                   Style="{StaticResource DataGridColumnHeaderTextStyle}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DeviceTableStatusBadgeStyle}">
                                <TextBlock Text="{Binding Status}" Style="{StaticResource DeviceTableBadgeTextStyle}" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Binding="{Binding Process}"
                                    behaviors:DeviceTableColumnLayoutBehavior.ColumnKey="Process"
                                    Width="1.95*"
                                    MinWidth="150"
                                    IsReadOnly="True"
                                    ElementStyle="{StaticResource DeviceTableProcessTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource ChangeSingleDevice_ColumnProcess}"
                                   Style="{StaticResource DataGridColumnHeaderTextStyle}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTemplateColumn behaviors:DeviceTableColumnLayoutBehavior.ColumnKey="Stop"
                                        Width="84"
                                        MinWidth="84"
                                        CellStyle="{StaticResource ChangeSingleDeviceStopCellStyle}"
                                        IsReadOnly="True">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{DynamicResource ChangeSingleDevice_ColumnStop}"
                                   Style="{StaticResource DataGridColumnHeaderTextStyle}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.StopDeviceActionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding HasActionStopButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    IsEnabled="{Binding CanStopAction}"
                                    ToolTip="{DynamicResource ChangeSingleDevice_StopActionTooltip}"
                                    Padding="2"
                                    Margin="2"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Style="{StaticResource DeviceStopActionButtonStyle}">
                                <Grid HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Stop"
                                                             Width="14"
                                                             Height="14"
                                                             Foreground="{DynamicResource Brush.AccentForeground}"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,4,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource ChangeSingleDevice_StopAction}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <ScrollViewer x:Name="DeviceProfilePanelScrollViewer"
                      Grid.Row="2"
                      Margin="0,8,0,0"
                      MinHeight="300"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="DeviceProfilePanelContentGrid"
                          Margin="{StaticResource DeviceProfilePanelContentMargin}"
                          MinHeight="260">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="1.45*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource DeviceInfoSectionBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid x:Name="DeviceInfoHeaderGrid"
                                  Grid.Row="0"
                                  Style="{StaticResource DeviceSectionHeaderGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="CellphoneCog"
                                                         Style="{StaticResource DeviceSectionIconStyle}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{DynamicResource ChangeSingleDevice_DeviceInfoHeader}"
                                           Style="{StaticResource DeviceSectionTitleTextStyle}"/>
                                <Button x:Name="ViewAllDeviceInfoButton"
                                        Grid.Column="2"
                                        Command="{Binding ViewRandomDeviceInfoCommand}"
                                        ToolTip="{DynamicResource Shared_TooltipAction}"
                                        Style="{StaticResource DeviceInfoDetailsButtonStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="InformationOutline"
                                                                 Style="{StaticResource PrimaryButtonIconStyle}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{DynamicResource ChangeSingleDevice_ActionViewAllDeviceInfo}"
                                                   Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                    </Grid>
                                </Button>
                            </Grid>

                            <Border Grid.Row="1"
                                    Style="{StaticResource DeviceSectionHeaderSeparatorStyle}"/>

                            <Grid Grid.Row="2"
                                  Margin="0,5,0,0"
                                  IsEnabled="{Binding CanEditSelectedDeviceConfiguration}"
                                  Style="{StaticResource DeviceInfoFormGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="{DynamicResource ChangeSingleDevice_FieldName}"
                                           Style="{StaticResource DeviceFormLabelStyle}"/>
                                <TextBox x:Name="DeviceInfoNameTextBox"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Text="{Binding DeviceInfo.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{DynamicResource Shared_TooltipDeviceField}"
                                         Style="{StaticResource DeviceTextBoxStyle}"/>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="2"
                                           Text="{DynamicResource ChangeSingleDevice_FieldImei}"
                                           Style="{StaticResource DeviceFormSecondaryLabelStyle}"/>
                                <TextBox x:Name="DeviceInfoImeiTextBox"
                                         Grid.Row="0"
                                         Grid.Column="3"
                                         Text="{Binding DeviceInfo.Imei, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{DynamicResource Shared_TooltipDeviceField}"
                                         Style="{StaticResource DeviceTextBoxStyle}"/>

                                <TextBlock Grid.Row="1"
                                           Text="{DynamicResource ChangeSingleDevice_FieldHardware}"
                                           Style="{StaticResource DeviceFormLabelStyle}"/>
                                <TextBox x:Name="DeviceInfoHardwareTextBox"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Text="{Binding DeviceInfo.Hardware, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{DynamicResource Shared_TooltipDeviceField}"
                                         Style="{StaticResource DeviceTextBoxStyle}"/>
                                <TextBlock Grid.Row="1"
                                           Grid.Column="2"
                                           Text="{DynamicResource ChangeSingleDevice_FieldOperator}"
                                           Style="{StaticResource DeviceFormSecondaryLabelStyle}"/>
                                <TextBox x:Name="DeviceInfoOperatorTextBox"
                                         Grid.Row="1"
                                         Grid.Column="3"
                                         Text="{Binding DeviceInfo.Operator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{DynamicResource Shared_TooltipDeviceField}"
                                         Style="{StaticResource DeviceTextBoxStyle}"/>

                                <TextBlock Grid.Row="2"
                                           Text="{DynamicResource ChangeSingleDevice_FieldFingerprint}"
                                           Style="{StaticResource DeviceFormLabelStyle}"/>
                                <TextBox x:Name="DeviceInfoFingerprintTextBox"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         Text="{Binding DeviceInfo.Fingerprint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{DynamicResource Shared_TooltipDeviceField}"
                                         Style="{StaticResource DeviceTextBoxStyle}"/>
                                <TextBlock Grid.Row="2"
                                           Grid.Column="2"
                                           Text="{DynamicResource ChangeSingleDevice_FieldPhoneNumber}"
                                           Style="{StaticResource DeviceFormSecondaryLabelStyle}"/>
                                <TextBox x:Name="DeviceInfoPhoneNumberTextBox"
                                         Grid.Row="2"
                                         Grid.Column="3"
                                         Text="{Binding DeviceInfo.PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{DynamicResource Shared_TooltipDeviceField}"
                                         Style="{StaticResource DeviceTextBoxStyle}"/>

                                <TextBlock Grid.Row="3"
                                           Text="{DynamicResource ChangeSingleDevice_FieldOsVersion}"
                                           Style="{StaticResource DeviceFormLabelStyle}"/>
                                <TextBox x:Name="DeviceInfoAndroidVersionTextBox"
                                         Grid.Row="3"
                                         Grid.Column="1"
                                         Text="{Binding DeviceInfo.AndroidVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{DynamicResource Shared_TooltipDeviceField}"
                                         Style="{StaticResource DeviceTextBoxStyle}"/>
                                <TextBlock Grid.Row="3"
                                           Grid.Column="2"
                                           Text="{DynamicResource ChangeSingleDevice_FieldIccid}"
                                           Style="{StaticResource DeviceFormSecondaryLabelStyle}"/>
                                <TextBox x:Name="DeviceInfoIccidTextBox"
                                         Grid.Row="3"
                                         Grid.Column="3"
                                         Text="{Binding DeviceInfo.Iccid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{DynamicResource Shared_TooltipDeviceField}"
                                         Style="{StaticResource DeviceTextBoxStyle}"/>

                                <TextBlock Grid.Row="4"
                                           Text="{DynamicResource ChangeSingleDevice_FieldBrand}"
                                           Style="{StaticResource DeviceFormLabelStyle}"/>
                                <TextBox x:Name="DeviceInfoBrandTextBox"
                                         Grid.Row="4"
                                         Grid.Column="1"
                                         Text="{Binding DeviceInfo.Brand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{DynamicResource Shared_TooltipDeviceField}"
                                         Style="{StaticResource DeviceTextBoxStyle}"/>
                                <TextBlock Grid.Row="4"
                                           Grid.Column="2"
                                           Text="{DynamicResource ChangeSingleDevice_FieldImsi}"
                                           Style="{StaticResource DeviceFormSecondaryLabelStyle}"/>
                                <TextBox x:Name="DeviceInfoImsiTextBox"
                                         Grid.Row="4"
                                         Grid.Column="3"
                                         Text="{Binding DeviceInfo.Imsi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{DynamicResource Shared_TooltipDeviceField}"
                                         Style="{StaticResource DeviceTextBoxStyle}"/>

                                <TextBlock Grid.Row="5"
                                           Text="{DynamicResource ChangeSingleDevice_FieldSerial}"
                                           Style="{StaticResource DeviceFormLabelStyle}"/>
                                <TextBox x:Name="DeviceInfoSerialTextBox"
                                         Grid.Row="5"
                                         Grid.Column="1"

                                         Text="{Binding DeviceInfo.Serial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{DynamicResource Shared_TooltipDeviceField}"
                                         Style="{StaticResource DeviceTextBoxStyle}"/>
                                <TextBlock Grid.Row="5"
                                           Grid.Column="2"
                                           Text="{DynamicResource ChangeSingleDevice_FieldMac}"
                                           Style="{StaticResource DeviceFormSecondaryLabelStyle}"/>
                                <TextBox x:Name="DeviceInfoMacTextBox"
                                         Grid.Row="5"
                                         Grid.Column="3"
                                         Text="{Binding DeviceInfo.Mac, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{DynamicResource Shared_TooltipDeviceField}"
                                         Style="{StaticResource DeviceTextBoxStyle}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource DeviceInfoSectionBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid x:Name="DeviceConfigHeaderGrid"
                                  Grid.Row="0"
                                  Style="{StaticResource DeviceSectionHeaderGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="TuneVariant"
                                                         Style="{StaticResource DeviceSectionIconStyle}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{DynamicResource ChangeSingleDevice_DeviceConfigHeader}"
                                           Style="{StaticResource DeviceSectionTitleTextStyle}"/>
                                <Button x:Name="AdvancedChangeConfigButton"
                                        Grid.Column="2"
                                        Command="{Binding OpenAdvancedChangeConfigCommand}"
                                        ToolTip="{DynamicResource ChangeSingleDevice_AdvancedConfigTooltip}"
                                        Style="{StaticResource DeviceInfoDetailsButtonStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="Tune"
                                                                 Style="{StaticResource PrimaryButtonIconStyle}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{DynamicResource ChangeSingleDevice_ActionAdvancedChangeConfig}"
                                                   Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                    </Grid>
                                </Button>
                            </Grid>

                            <Border Grid.Row="1"
                                    Style="{StaticResource DeviceSectionHeaderSeparatorStyle}"/>

                            <Grid x:Name="DeviceConfigFormGrid"
                                  Grid.Row="2"
                                  Margin="0,5,0,0"
                                  IsEnabled="{Binding CanEditSelectedDeviceConfiguration}"
                                  Style="{StaticResource DeviceInfoFormGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="{DynamicResource ChangeSingleDevice_FieldBrand}"
                                           Style="{StaticResource DeviceFormLabelStyle}"/>
                                <ComboBox x:Name="BrandComboBox"
                                          Grid.Row="0"
                                          Grid.Column="1"
                                          ItemsSource="{Binding Brands}"
                                          SelectedItem="{Binding SelectedBrand, Mode=TwoWay}"
                                          ToolTip="{DynamicResource Shared_TooltipProfileSelection}"
                                          Style="{StaticResource DeviceComboBoxStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Row="1"
                                           Text="{DynamicResource ChangeSingleDevice_FieldOsVersion}"
                                           Style="{StaticResource DeviceFormLabelStyle}"/>
                                <ComboBox x:Name="AndroidVersionComboBox"
                                          Grid.Row="1"
                                          Grid.Column="1"
                                          ItemsSource="{Binding AndroidVersions}"
                                          SelectedItem="{Binding SelectedAndroidVersion, Mode=TwoWay}"
                                          ToolTip="{DynamicResource Shared_TooltipProfileSelection}"
                                          Style="{StaticResource DeviceComboBoxStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Row="2"
                                           Text="{DynamicResource ChangeSingleDevice_FieldModel}"
                                           Style="{StaticResource DeviceFormLabelStyle}"/>
                                <TextBox Grid.Row="2"
                                         Grid.Column="1"
                                         Text="{Binding DeviceInfo.Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{DynamicResource Shared_TooltipDeviceField}"
                                         Style="{StaticResource DeviceTextBoxStyle}"/>

                                <TextBlock Grid.Row="3"
                                           Text="{DynamicResource ChangeSingleDevice_FieldCountry}"
                                           Style="{StaticResource DeviceFormLabelStyle}"/>
                                <ComboBox x:Name="CountryComboBox"
                                          Grid.Row="3"
                                          Grid.Column="1"
                                          ItemsSource="{Binding Countries}"
                                          SelectedItem="{Binding SelectedCountry, Mode=TwoWay}"
                                          ToolTip="{DynamicResource Shared_TooltipProfileSelection}"
                                          Style="{StaticResource DeviceComboBoxStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Row="4"
                                           Text="{DynamicResource ChangeSingleDevice_FieldCarrier}"
                                           Style="{StaticResource DeviceFormLabelStyle}"/>
                                <ComboBox x:Name="CarrierComboBox"
                                          Grid.Row="4"
                                          Grid.Column="1"
                                          ItemsSource="{Binding Carriers}"
                                          SelectedItem="{Binding SelectedCarrier, Mode=TwoWay}"
                                          ToolTip="{DynamicResource Shared_TooltipProfileSelection}"
                                          Style="{StaticResource DeviceComboBoxStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <CheckBox Grid.Row="5"
                                          Grid.ColumnSpan="2"
                                          Content="{DynamicResource ChangeSingleDevice_OptionChangeSim}"
                                          IsChecked="{Binding IsChangeSimEnabled, Mode=TwoWay}"
                                          ToolTip="{DynamicResource Shared_TooltipOption}"
                                          Style="{StaticResource FormCheckBoxStyle}"/>
                                <CheckBox x:Name="UseDefaultChangeModeCheckBox"
                                          Grid.Row="6"
                                          Grid.ColumnSpan="2"
                                          Content="{DynamicResource ChangeSingleDevice_OptionDefaultChangeMode}"
                                          IsChecked="{Binding UseDefaultChangeMode, Mode=TwoWay}"
                                          ToolTip="{DynamicResource Shared_TooltipOption}"
                                          Style="{StaticResource FormCheckBoxStyle}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource DeviceActionSectionBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Style="{StaticResource DeviceSectionHeaderGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Cog"
                                                         Style="{StaticResource DeviceSectionIconStyle}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{DynamicResource ChangeSingleDevice_ActionSingleHeader}"
                                           Style="{StaticResource DeviceSectionTitleTextStyle}"/>
                            </Grid>

                            <Border Grid.Row="1"
                                    Style="{StaticResource DeviceSectionHeaderSeparatorStyle}"/>

                            <Grid x:Name="DeviceActionGrid"
                                  Grid.Row="2"
                                  Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                            <Button x:Name="RandomDeviceButton"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Command="{Binding RandomDeviceCommand}"
                                    ToolTip="{DynamicResource ChangeSingleDevice_ActionRandomDeviceTooltip}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Cellphone"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource ChangeSingleDevice_ActionRandomDevice}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button x:Name="ChangeWithoutWipeButton"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Command="{Binding ChangeWithoutWipeCommand}"
                                    ToolTip="{DynamicResource ChangeSingleDevice_ActionChangeWithoutWipeTooltip}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="CellphoneText"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource ChangeSingleDevice_ActionChangeWithoutWipe}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button x:Name="ChangeDeviceButton"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Command="{Binding ChangeDeviceCommand}"
                                    ToolTip="{DynamicResource ChangeSingleDevice_ActionChangeDeviceTooltip}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="CellphoneCog"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource ChangeSingleDevice_ActionChangeDevice}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button x:Name="WipeWithoutChangeButton"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Command="{Binding WipeWithoutChangeCommand}"
                                    ToolTip="{DynamicResource ChangeSingleDevice_ActionWipeWithoutChangeTooltip}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="DeleteSweep"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource ChangeSingleDevice_ActionWipeWithoutChange}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button Grid.Row="3"
                                    Grid.Column="0"
                                    Command="{Binding RandomChangeAndWipeDeviceCommand}"
                                    ToolTip="{DynamicResource ChangeSingleDevice_ActionRandomChangeAndWipeTooltip}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Sync"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource ChangeSingleDevice_ActionRandomChangeAndWipe}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button x:Name="RandomSimButton"
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Command="{Binding RandomSimCommand}"
                                    ToolTip="{DynamicResource ChangeSingleDevice_ActionRandomSimTooltip}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="SimCard"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource ChangeSingleDevice_ActionRandomSim}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button x:Name="ChangeSimButton"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Command="{Binding ChangeSimCommand}"
                                    ToolTip="{DynamicResource ChangeSingleDevice_ActionChangeSimTooltip}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="SimCard"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource ChangeSingleDevice_ActionChangeSim}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button Grid.Row="4"
                                    Grid.Column="0"
                                    Command="{Binding ChangeLocationCommand}"
                                    ToolTip="{DynamicResource Shared_TooltipAction}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="MapMarker"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource ChangeSingleDevice_ActionChangeLocation}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button Grid.Row="4"
                                    Grid.Column="1"
                                    Command="{Binding ChangeTimezoneCommand}"
                                    ToolTip="{DynamicResource Shared_TooltipAction}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="ClockOutline"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource ChangeSingleDevice_ActionChangeTimezone}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button Grid.Row="6"
                                    Grid.Column="0"
                                    Command="{Binding UpdateIntegrityCommand}"
                                    ToolTip="{DynamicResource Shared_TooltipAction}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="ShieldCheck"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource ChangeSingleDevice_ActionUpdateIntegrity}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button Grid.Row="3"
                                    Grid.Column="1"
                                    Command="{Binding InstallApkCommand}"
                                    ToolTip="{DynamicResource Shared_TooltipAction}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Android"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource ChangeSingleDevice_ActionInstallApk}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button Grid.Row="5"
                                    Grid.Column="0"
                                    Command="{Binding FakeProxyCommand}"
                                    ToolTip="{DynamicResource Shared_TooltipAction}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Wifi"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource ChangeSingleDevice_ActionFakeProxy}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            <Button Grid.Row="5"
                                    Grid.Column="1"
                                    Command="{Binding StopFakeProxyCommand}"
                                    ToolTip="{DynamicResource Shared_TooltipAction}"
                                    Style="{StaticResource DeviceActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="WifiOff"
                                                             Width="16"
                                                             Height="16"

                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource ChangeSingleDevice_ActionStopFakeProxy}"
                                               Style="{StaticResource DeviceActionButtonTextStyle}"/>
                                </Grid>
                            </Button>
                            </Grid>
                        </Grid>
                    </Border>
                    </Grid>
        </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
