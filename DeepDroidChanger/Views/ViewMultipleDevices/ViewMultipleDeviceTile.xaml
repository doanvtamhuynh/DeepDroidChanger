<UserControl x:Class="DeepDroidChanger.Views.ViewMultipleDeviceTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:scrcpy="clr-namespace:ScrcpyNet.Wpf;assembly=DeepDroidChanger.ViewDevices"
             xmlns:views="clr-namespace:DeepDroidChanger.Views"
             Background="Transparent"
             Width="{Binding TileWidth}"
             PreviewKeyDown="OnPreviewKeyDown"
             FontFamily="{StaticResource Metric.FontFamily}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ViewMultipleDevicesResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <views:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

            <Style x:Key="ViewMultipleDeviceOpenViewButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource FlatButtonStyle}">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="{StaticResource Metric.BorderThickness.Uniform}"
            CornerRadius="{StaticResource Radius.Medium}"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    MinHeight="{StaticResource ViewMultipleDevices.TileHeaderHeight}"
                    Padding="{StaticResource Spacing.CardPadding.Compact}"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="{Binding DeviceName}"
                               Style="{StaticResource DialogHeaderTextStyle}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,8,0"/>

                    <Button x:Name="OpenViewDeviceButton"
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource ViewMultipleDeviceOpenViewButtonStyle}"
                            Command="{Binding OpenViewDeviceCommand}"
                            AutomationProperties.Name="{DynamicResource ViewMultipleDevices_OpenView}"
                            ToolTip="{DynamicResource ViewMultipleDevices_OpenViewDevice}">
                        <materialDesign:PackIcon Kind="OpenInNew"
                                                 Width="16"
                                                 Height="16"/>
                    </Button>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Text="{Binding Serial}"
                               Style="{StaticResource AppLabelTextStyle}"
                               FontSize="{StaticResource Metric.FontSize.Small}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,4,0,0"/>
                </Grid>
            </Border>

            <Grid x:Name="StreamViewport"
                  Grid.Row="1"
                  Background="{DynamicResource Brush.WindowBackground}"
                  ClipToBounds="True"
                  MinHeight="1"
                  SizeChanged="OnStreamViewportSizeChanged">
                <scrcpy:ScrcpyDisplay x:Name="ScrcpyDisplay"
                                      Scrcpy="{Binding ScrcpyClient}"
                                      Focusable="True"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <Grid Background="{DynamicResource Brush.WindowBackground}"
                      IsHitTestVisible="False"
                      Visibility="{Binding IsRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="220"
                                Margin="{StaticResource Spacing.CardPadding}">
                        <materialDesign:PackIcon Kind="CellphoneLink"
                                                 Width="36"
                                                 Height="36"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource Brush.TextSecondary}"/>
                        <TextBlock Text="{Binding StatusText}"
                                   Margin="0,10,0,0"
                                   Style="{StaticResource AppLabelTextStyle}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
