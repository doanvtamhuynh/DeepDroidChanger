<UserControl x:Class="DeepDroidChanger.Views.ViewMultipleDeviceTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:views="clr-namespace:DeepDroidChanger.Views"
             Background="Transparent"
             Width="{Binding TileWidth}"
             FontFamily="{StaticResource Metric.FontFamily}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ViewMultipleDevicesResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <views:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

            <Style x:Key="ViewMultipleDeviceStatusPillStyle"
                   TargetType="Border">
                <Setter Property="Padding"
                        Value="8,3"/>
                <Setter Property="CornerRadius"
                        Value="{StaticResource Radius.Interactive}"/>
                <Setter Property="Background"
                        Value="{DynamicResource Brush.SurfaceAlt}"/>
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Brush.Border}"/>
                <Setter Property="BorderThickness"
                        Value="{StaticResource Metric.BorderThickness.Uniform}"/>
                <Setter Property="TextElement.Foreground"
                        Value="{DynamicResource Brush.TextSecondary}"/>
                <Setter Property="TextElement.FontSize"
                        Value="{StaticResource Metric.FontSize.Small}"/>
                <Setter Property="TextElement.FontWeight"
                        Value="SemiBold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRunning}"
                                 Value="True">
                        <Setter Property="Background"
                                Value="{DynamicResource Brush.DeviceStatusPositiveBackground}"/>
                        <Setter Property="BorderBrush"
                                Value="{DynamicResource Brush.DeviceStatusPositiveForeground}"/>
                        <Setter Property="TextElement.Foreground"
                                Value="{DynamicResource Brush.DeviceStatusPositiveForeground}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsFailed}"
                                 Value="True">
                        <Setter Property="Background"
                                Value="{DynamicResource Brush.DeviceStatusNegativeBackground}"/>
                        <Setter Property="BorderBrush"
                                Value="{DynamicResource Brush.DeviceStatusNegativeForeground}"/>
                        <Setter Property="TextElement.Foreground"
                                Value="{DynamicResource Brush.DeviceStatusNegativeForeground}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ViewMultipleDeviceStatusDotStyle"
                   TargetType="Ellipse">
                <Setter Property="Fill"
                        Value="{DynamicResource Brush.TextDisabled}"/>
                <Setter Property="Width"
                        Value="8"/>
                <Setter Property="Height"
                        Value="8"/>
                <Setter Property="VerticalAlignment"
                        Value="Center"/>
                <Setter Property="Margin"
                        Value="0,0,5,0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRunning}"
                                 Value="True">
                        <Setter Property="Fill"
                                Value="{DynamicResource Brush.Success}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsFailed}"
                                 Value="True">
                        <Setter Property="Fill"
                                Value="{DynamicResource Brush.Danger}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="{StaticResource Metric.BorderThickness.Uniform}"
            CornerRadius="{StaticResource Radius.Medium}"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    MinHeight="{StaticResource ViewMultipleDevices.TileHeaderHeight}"
                    Padding="{StaticResource Spacing.CardPadding.Compact}"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="{Binding DeviceName}"
                               Style="{StaticResource DialogHeaderTextStyle}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,8,0"/>

                    <Border Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource ViewMultipleDeviceStatusPillStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource ViewMultipleDeviceStatusDotStyle}"/>
                            <TextBlock Text="{Binding StatusText}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Text="{Binding Serial}"
                               Style="{StaticResource AppLabelTextStyle}"
                               FontSize="{StaticResource Metric.FontSize.Small}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,4,0,0"/>
                </Grid>
            </Border>

            <Grid x:Name="StreamViewport"
                  Grid.Row="1"
                  Background="{DynamicResource Brush.WindowBackground}"
                  ClipToBounds="True"
                  MinHeight="1"
                  SizeChanged="OnStreamViewportSizeChanged">
                <views:ScrcpyWindowHost x:Name="NativeHost"
                                        Focusable="True"
                                        IsHitTestVisible="True"
                                        IsInteractive="True"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <Grid Background="{DynamicResource Brush.WindowBackground}"
                      IsHitTestVisible="False"
                      Visibility="{Binding IsRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="220"
                                Margin="{StaticResource Spacing.CardPadding}">
                        <materialDesign:PackIcon Kind="CellphoneLink"
                                                 Width="36"
                                                 Height="36"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource Brush.TextSecondary}"/>
                        <TextBlock Text="{Binding StatusText}"
                                   Margin="0,10,0,0"
                                   Style="{StaticResource AppLabelTextStyle}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
