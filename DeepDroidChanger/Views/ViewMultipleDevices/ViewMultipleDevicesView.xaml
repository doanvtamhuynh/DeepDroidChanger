<UserControl x:Class="DeepDroidChanger.Views.ViewMultipleDevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DeepDroidChanger.Views"
             Background="Transparent" FontFamily="{StaticResource Metric.FontFamily}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ViewMultipleDevicesResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <views:InverseBooleanToVisibilityConverter x:Key="InverseBooleanVisibility"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource PageRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12" LastChildFill="True">
            <TextBlock Text="{DynamicResource ViewMultipleDevices_Title}" Style="{StaticResource PageHeaderTextStyle}"/>
            <TextBlock Style="{StaticResource AppLabelTextStyle}" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Margin="16,0,0,0">
                <Run Text="{DynamicResource ViewMultipleDevices_Showing}"/><Run Text=" "/>
                <Run Text="{Binding ShowingStart, Mode=OneWay}"/><Run Text="–"/>
                <Run Text="{Binding ShowingEnd, Mode=OneWay}"/><Run Text=" / "/>
                <Run Text="{Binding CatalogDeviceCount, Mode=OneWay}"/>
            </TextBlock>
        </DockPanel>
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="DeviceScrollViewer" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"
                          SizeChanged="OnDeviceViewportSizeChanged" ScrollChanged="OnDeviceScrollChanged">
                <ItemsControl ItemsSource="{Binding VisibleDevices}"
                              Visibility="{Binding HasOnlineDevices, Converter={StaticResource MultipleDevicesBooleanVisibility}}"
                              Width="{Binding ViewportWidth, ElementName=DeviceScrollViewer}"
                              HorizontalAlignment="Left" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" HorizontalAlignment="Stretch"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="{StaticResource ViewMultipleDevices.TileMargin}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><views:ViewMultipleDeviceTile/></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="{DynamicResource ViewMultipleDevices_NoOnlineDevices}"
                       Style="{StaticResource AppLabelTextStyle}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Margin="{StaticResource Spacing.CardPadding}"
                       Visibility="{Binding HasOnlineDevices, Converter={StaticResource InverseBooleanVisibility}}"/>
            <Canvas x:Name="ControlOverlay" ClipToBounds="True">
                <views:ViewMultipleDevicesControlPanel/>
            </Canvas>
        </Grid>
    </Grid>
</UserControl>
