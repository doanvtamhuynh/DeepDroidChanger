<UserControl x:Class="DeepDroidChanger.Views.ViewMultipleDevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:views="clr-namespace:DeepDroidChanger.Views"
             Background="Transparent"
             FontFamily="{StaticResource Metric.FontFamily}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ViewMultipleDevicesResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <views:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

            <Style x:Key="ViewMultipleDevicesToolbarButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource FlatButtonStyle}">
                <Setter Property="Width"
                        Value="38"/>
                <Setter Property="Height"
                        Value="{StaticResource Metric.ControlHeight}"/>
                <Setter Property="Padding"
                        Value="0"/>
                <Setter Property="Margin"
                        Value="0,0,6,0"/>
            </Style>

            <Style x:Key="ViewMultipleDevicesPaginationButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource FlatButtonStyle}">
                <Setter Property="MinWidth"
                        Value="88"/>
                <Setter Property="Height"
                        Value="{StaticResource Metric.ControlHeight}"/>
                <Setter Property="Padding"
                        Value="{StaticResource Spacing.ControlPadding}"/>
                <Setter Property="Margin"
                        Value="4,0"/>
            </Style>

            <Style x:Key="ViewMultipleDevicesButtonTextStyle"
                   TargetType="TextBlock">
                <Setter Property="FontFamily"
                        Value="{StaticResource Metric.FontFamily}"/>
                <Setter Property="FontSize"
                        Value="{StaticResource Metric.FontSize.Body}"/>
                <Setter Property="FontWeight"
                        Value="SemiBold"/>
                <Setter Property="VerticalAlignment"
                        Value="Center"/>
                <Setter Property="Foreground"
                        Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"
                           MinHeight="{StaticResource Metric.ToolbarMinHeight}"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="0,0,0,12"
                Margin="0,0,0,12">
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource ViewMultipleDevices_Title}"
                           Style="{StaticResource PageHeaderTextStyle}"/>
                <TextBlock Style="{StaticResource AppLabelTextStyle}"
                           Margin="0,4,0,0">
                    <Run Text="{Binding OnlineDeviceCount, Mode=OneWay}"/>
                    <Run Text=" "/>
                    <Run Text="{DynamicResource ViewMultipleDevices_OnlineDevices}"/>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource ViewMultipleDevices_Zoom}"
                           Style="{StaticResource AppLabelTextStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <Button Command="{Binding ZoomOutCommand}"
                        ToolTip="{DynamicResource ViewMultipleDevices_ZoomOut}"
                        Style="{StaticResource ViewMultipleDevicesToolbarButtonStyle}">
                    <materialDesign:PackIcon Kind="Minus"
                                             Width="18"
                                             Height="18"/>
                </Button>

                <Border MinWidth="66"
                        Height="{StaticResource Metric.ControlHeight}"
                        Margin="0,0,6,0"
                        Padding="{StaticResource Spacing.ControlPadding}"
                        Background="{DynamicResource Brush.SurfaceAlt}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="{StaticResource Metric.BorderThickness.Uniform}"
                        CornerRadius="{StaticResource Radius.Medium}">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center">
                        <Run Text="{Binding ZoomPercent, Mode=OneWay}"/>
                        <Run Text="%"/>
                    </TextBlock>
                </Border>

                <Button Command="{Binding ZoomInCommand}"
                        ToolTip="{DynamicResource ViewMultipleDevices_ZoomIn}"
                        Style="{StaticResource ViewMultipleDevicesToolbarButtonStyle}">
                    <materialDesign:PackIcon Kind="Plus"
                                             Width="18"
                                             Height="18"/>
                </Button>

                <Button Command="{Binding FitCommand}"
                        ToolTip="{DynamicResource ViewMultipleDevices_Fit}"
                        Style="{StaticResource FlatButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Fullscreen"
                                                 Width="16"
                                                 Height="16"
                                                 Margin="0,0,6,0"/>
                        <TextBlock Text="{DynamicResource ViewMultipleDevices_Fit}"
                                   Style="{StaticResource ViewMultipleDevicesButtonTextStyle}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="DeviceScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          SizeChanged="OnDeviceViewportSizeChanged"
                          ScrollChanged="OnDeviceScrollChanged">
                <ItemsControl ItemsSource="{Binding VisibleDevices}"
                              Visibility="{Binding HasOnlineDevices, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Width="{Binding ViewportWidth, ElementName=DeviceScrollViewer}"
                              HorizontalAlignment="Left"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"
                                       HorizontalAlignment="Stretch"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="{x:Type ContentPresenter}">
                            <Setter Property="Margin"
                                    Value="{StaticResource ViewMultipleDevices.TileMargin}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:ViewMultipleDeviceTile/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="{DynamicResource ViewMultipleDevices_NoOnlineDevices}"
                       Style="{StaticResource AppLabelTextStyle}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="{StaticResource Spacing.CardPadding}"
                       Visibility="{Binding HasOnlineDevices, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Style="{StaticResource AppLabelTextStyle}"
                           VerticalAlignment="Center">
                    <Run Text="{DynamicResource ViewMultipleDevices_Showing}"/>
                    <Run Text=" "/>
                    <Run Text="{Binding ShowingStart, Mode=OneWay}"/>
                    <Run Text="–"/>
                    <Run Text="{Binding ShowingEnd, Mode=OneWay}"/>
                    <Run Text=" "/>
                    <Run Text="{DynamicResource ViewMultipleDevices_Of}"/>
                    <Run Text=" "/>
                    <Run Text="{Binding CatalogDeviceCount, Mode=OneWay}"/>
                    <Run Text=" "/>
                    <Run Text="{DynamicResource ViewMultipleDevices_Devices}"/>
                </TextBlock>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Command="{Binding PreviousPageCommand}"
                            ToolTip="{DynamicResource ViewMultipleDevices_Previous}"
                            Style="{StaticResource ViewMultipleDevicesPaginationButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChevronLeft"
                                                     Width="16"
                                                     Height="16"
                                                     Margin="0,0,5,0"/>
                            <TextBlock Text="{DynamicResource ViewMultipleDevices_Previous}"
                                       Style="{StaticResource ViewMultipleDevicesButtonTextStyle}"/>
                        </StackPanel>
                    </Button>

                    <TextBlock MinWidth="86"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Style="{StaticResource AppLabelTextStyle}">
                        <Run Text="{DynamicResource ViewMultipleDevices_Page}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                        <Run Text=" / "/>
                        <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                    </TextBlock>

                    <Button Command="{Binding NextPageCommand}"
                            ToolTip="{DynamicResource ViewMultipleDevices_Next}"
                            Style="{StaticResource ViewMultipleDevicesPaginationButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource ViewMultipleDevices_Next}"
                                       Style="{StaticResource ViewMultipleDevicesButtonTextStyle}"
                                       Margin="0,0,5,0"/>
                            <materialDesign:PackIcon Kind="ChevronRight"
                                                     Width="16"
                                                     Height="16"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
