<UserControl x:Class="DeepDroidChanger.Views.ViewMultipleDevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DeepDroidChanger.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent" FontFamily="{DynamicResource Metric.FontFamily}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ViewMultipleDevicesResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <views:InverseBooleanToVisibilityConverter x:Key="InverseBooleanVisibility"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource PageRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="ViewDashboardOutline" Width="24" Height="24" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBlock Text="{DynamicResource ViewMultipleDevices_Title}" Style="{StaticResource AppTitleTextStyle}"/>
            </StackPanel>
            <TextBlock Text="{DynamicResource Workspace_MonitorDescription}" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0"/>
            <TextBlock Style="{StaticResource AppLabelTextStyle}" HorizontalAlignment="Left"
                       VerticalAlignment="Center" Margin="0,8,0,0">
                <Run Text="{DynamicResource ViewMultipleDevices_Showing}"/><Run Text=" "/>
                <Run Text="{Binding ShowingStart, Mode=OneWay}"/><Run Text="–"/>
                <Run Text="{Binding ShowingEnd, Mode=OneWay}"/><Run Text=" / "/>
                <Run Text="{Binding CatalogDeviceCount, Mode=OneWay}"/>
            </TextBlock>
        </StackPanel>
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="DeviceScrollViewer" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"
                          SizeChanged="OnDeviceViewportSizeChanged" ScrollChanged="OnDeviceScrollChanged">
                <ItemsControl ItemsSource="{Binding VisibleDevices}"
                              Visibility="{Binding HasOnlineDevices, Converter={StaticResource MultipleDevicesBooleanVisibility}}"
                              Width="{Binding ViewportWidth, ElementName=DeviceScrollViewer}"
                              HorizontalAlignment="Left" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" HorizontalAlignment="Stretch"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="{StaticResource ViewMultipleDevices.TileMargin}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><views:ViewMultipleDeviceTile/></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{StaticResource Spacing.CardPadding}"
                        Visibility="{Binding HasOnlineDevices, Converter={StaticResource InverseBooleanVisibility}}">
                <materialDesign:PackIcon Kind="CellphoneLinkOff" Width="40" Height="40" Foreground="{DynamicResource Brush.TextDisabled}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="{DynamicResource ViewMultipleDevices_NoOnlineDevices}" Style="{StaticResource SubtitleTextStyle}" TextAlignment="Center"/>
                <TextBlock Text="{DynamicResource Workspace_OnlineHint}" Style="{StaticResource SecondaryTextStyle}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
            <Canvas x:Name="ControlOverlay" ClipToBounds="True">
                <views:ViewMultipleDevicesControlPanel/>
            </Canvas>
        </Grid>
    </Grid>
</UserControl>
