<UserControl x:Class="DeepDroidChanger.Views.ChangeMultipleDevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:DeepDroidChanger.Behaviors"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Thickness x:Key="MultipleDeviceProfilePanelContentMargin">0,0,16,0</Thickness>

        <Style x:Key="MultipleDeviceGridRowContextMenuStyle"
               TargetType="DataGridRow"
               BasedOn="{StaticResource DeviceTableRowStyle}">
            <EventSetter Event="ContextMenuOpening"
                         Handler="OnDeviceRowContextMenuOpening"/>
            <Setter Property="FocusVisualStyle"
                    Value="{StaticResource AppFocusVisualStyle}"/>
            <Setter Property="Tag"
                    Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
            <Setter Property="ContextMenu"
                    Value="{DynamicResource DeviceActionsContextMenu}"/>
        </Style>

        <Style x:Key="MultipleDeviceGridStyle"
               TargetType="DataGrid"
               BasedOn="{StaticResource FlatDataGridStyle}">
            <Setter Property="MinHeight" Value="220"/>
            <Setter Property="RowHeight"
                    Value="{StaticResource Metric.DataGridEditorRowHeight}"/>
            <Setter Property="MaxHeight" Value="412"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="HorizontalGridLinesBrush"
                    Value="{DynamicResource Brush.Border}"/>
            <Setter Property="VerticalGridLinesBrush"
                    Value="{DynamicResource Brush.Border}"/>
            <Setter Property="ColumnHeaderStyle"
                    Value="{StaticResource DeviceTableColumnHeaderStyle}"/>
            <Setter Property="CellStyle"
                    Value="{StaticResource DeviceTableCellStyle}"/>
            <Setter Property="RowStyle"
                    Value="{StaticResource MultipleDeviceGridRowContextMenuStyle}"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="MultipleDeviceCellStretchStyle"
               TargetType="DataGridCell"
               BasedOn="{StaticResource DeviceTableCellStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="MultipleDeviceStopCellStyle"
               TargetType="DataGridCell"
               BasedOn="{StaticResource MultipleDeviceCellStretchStyle}">
            <!-- The Stop button owns the two-pixel inset explicitly. Keeping the cell
                 padding at zero avoids doubling the inset when a theme template binds it. -->
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="MultipleDeviceSelectionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style x:Key="MultipleDeviceSectionBorderStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource Brush.SurfaceAlt}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness"
                    Value="{StaticResource Metric.BorderThickness.Uniform}"/>
            <Setter Property="CornerRadius"
                    Value="{StaticResource Radius.Medium}"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>

        <Style x:Key="MultipleDeviceInfoSectionBorderStyle"
               TargetType="Border"
               BasedOn="{StaticResource MultipleDeviceSectionBorderStyle}">
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <Style x:Key="MultipleDeviceActionSectionBorderStyle"
               TargetType="Border"
               BasedOn="{StaticResource MultipleDeviceSectionBorderStyle}">
            <Setter Property="Padding" Value="10,12,10,8"/>
        </Style>

        <Style x:Key="MultipleDeviceSectionHeaderGridStyle"
               TargetType="Grid">
            <!-- Keep every panel header at the tallest standard control height so
                 each separator lands on the same horizontal line. -->
            <Setter Property="Height"
                    Value="{StaticResource Metric.ControlHeight}"/>
            <!-- Leave a five-pixel breathing space between the title and line. -->
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="MultipleDeviceSectionHeaderSeparatorStyle"
               TargetType="Border">
            <Setter Property="Height"
                    Value="{StaticResource Metric.BorderThickness}"/>
            <Setter Property="Background"
                    Value="{DynamicResource Brush.Border}"/>
            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>
            <Setter Property="VerticalAlignment"
                    Value="Bottom"/>
        </Style>

        <Style x:Key="MultipleDeviceSectionIconStyle"
               TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="MultipleDeviceSectionTitleTextStyle"
               TargetType="TextBlock">
            <Setter Property="FontFamily"
                    Value="{StaticResource Metric.FontFamily}"/>
            <Setter Property="FontSize"
                    Value="{StaticResource Metric.FontSize.Body}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="RunningActionListBoxItemStyle"
               TargetType="ListBoxItem"
               BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Background"
                    Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="{StaticResource Radius.Small}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource Brush.SurfaceHover}"/>
                                <Setter TargetName="ItemBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Brush.BorderStrong}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource Brush.SurfaceSelected}"/>
                                <Setter TargetName="ItemBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Brush.TextDisabled}"/>
                                <Setter TargetName="ItemBorder"
                                        Property="Opacity"
                                        Value="0.62"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MultipleDeviceInfoFormGridStyle"
               TargetType="Grid">
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="MultipleDeviceFormLabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource AppLabelTextStyle}">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="MultipleDeviceTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource FlatTextBoxStyle}">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="materialDesign:HintAssist.Foreground"
                    Value="{DynamicResource Brush.TextDisabled}"/>
        </Style>

        <Style x:Key="MultipleDeviceComboBoxItemStyle"
               TargetType="ComboBoxItem"
               BasedOn="{StaticResource FlatComboBoxItemStyle}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="MultipleDeviceComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource FlatComboBoxStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource MultipleDeviceComboBoxItemStyle}"/>
        </Style>

        <Style x:Key="MultipleDeviceActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource MaterialPrimaryButtonStyle}">
            <Setter Property="Background"
                    Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource Brush.AccentForeground}"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,5,4"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius"
                    Value="{StaticResource Radius.Medium}"/>
            <Setter Property="materialDesign:RippleAssist.Feedback"
                    Value="{DynamicResource Brush.AccentForeground}"/>
            <Setter Property="materialDesign:RippleAssist.RippleOnTop"
                    Value="True"/>
            <Setter Property="materialDesign:ElevationAssist.Elevation"
                    Value="Dp1"/>
        </Style>

        <Style x:Key="MultipleDeviceStopActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource MultipleDeviceActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource Brush.Danger}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="materialDesign:RippleAssist.Feedback"
                    Value="{DynamicResource Brush.AccentForeground}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.DangerHover}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.DangerPressed}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerPressed}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MultipleDeviceActionButtonTextStyle"
               TargetType="TextBlock">
            <Setter Property="FontFamily"
                    Value="{StaticResource Metric.FontFamily}"/>
            <Setter Property="FontSize"
                    Value="{StaticResource Metric.FontSize.Small}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RunningActionNameTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource MultipleDeviceActionButtonTextStyle}">
            <Setter Property="Foreground"
                    Value="{DynamicResource Brush.Warning}"/>
        </Style>

        <Style x:Key="MultipleDeviceInfoDetailsButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource MultipleDeviceActionButtonStyle}">
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>

        <Style x:Key="MultipleDeviceLoadToolbarStyle"
               TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="MultipleDeviceLoadButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource MaterialPrimaryButtonStyle}">
            <Setter Property="Background"
                    Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource Brush.AccentForeground}"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0,16,0"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius"
                    Value="{StaticResource Radius.ExtraSmall}"/>
            <Setter Property="materialDesign:RippleAssist.Feedback"
                    Value="{DynamicResource Brush.AccentForeground}"/>
            <Setter Property="materialDesign:RippleAssist.RippleOnTop"
                    Value="True"/>
            <Setter Property="materialDesign:ElevationAssist.Elevation"
                    Value="Dp2"/>
        </Style>

        <Style x:Key="MultipleDeviceLoadButtonContentStyle"
               TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MultipleDeviceLoadCountTextStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="{StaticResource Metric.FontSize.Body}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>

        <Style x:Key="MultipleDeviceFilterLabelStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="{StaticResource Metric.FontSize.Body}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="MultipleDeviceFilterComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource FlatComboBoxStyle}">
            <Setter Property="Width" Value="156"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource MultipleDeviceComboBoxItemStyle}"/>
        </Style>
        <Style x:Key="MultipleDeviceSearchTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DialogSearchTextBoxStyle}">
            <Setter Property="MaxWidth" Value="340"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="14,0,14,0"/>
        </Style>

        <Style x:Key="MultipleDeviceSelectAllCheckBoxStyle"
               TargetType="CheckBox"
               BasedOn="{StaticResource FormCheckBoxStyle}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MultipleDeviceSelectAllContainerStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource Brush.SurfaceAlt}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness"
                    Value="{StaticResource Metric.BorderThickness.Uniform}"/>
            <Setter Property="CornerRadius"
                    Value="{StaticResource Radius.Medium}"/>
            <Setter Property="Height"
                    Value="{StaticResource Metric.ControlHeight.Comfortable}"/>
            <Setter Property="Padding"
                    Value="{StaticResource Spacing.ButtonPadding}"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="MultipleDevicesRootGrid"
              Style="{StaticResource PageRootGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="220"/>
                <RowDefinition Height="312" MinHeight="312"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Style="{StaticResource MultipleDeviceLoadToolbarStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="MultipleAddDevicesButton"
                        Grid.Column="0"
                        Command="{Binding AddNewDevicesCommand}"
                        ToolTip="{DynamicResource Shared_TooltipAction}"
                        Style="{StaticResource MultipleDeviceLoadButtonStyle}">
                    <StackPanel Style="{StaticResource MultipleDeviceLoadButtonContentStyle}">
                        <materialDesign:PackIcon Kind="Plus"
                                                 Style="{StaticResource PrimaryButtonIconStyle}"/>
                        <TextBlock Text="{DynamicResource ChangeMultipleDevices_AddDevices}"
                                   Style="{StaticResource PrimaryButtonTextStyle}"/>
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="1"
                           Text="{Binding NewDeviceCountText}"
                           Style="{StaticResource MultipleDeviceLoadCountTextStyle}"/>

                <TextBox Grid.Column="2"
                         Text="{Binding DeviceSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{DynamicResource Shared_TooltipSearch}"
                         AutomationProperties.Name="{DynamicResource ChangeMultipleDevices_DeviceSearchName}"
                         materialDesign:HintAssist.Hint="{DynamicResource ChangeMultipleDevices_DeviceSearchHint}"
                         Style="{StaticResource MultipleDeviceSearchTextBoxStyle}"/>

                <StackPanel x:Name="MultipleDeviceFilterPanel"
                            Grid.Column="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Border x:Name="MultipleSelectAllDevicesContainer"
                            Style="{StaticResource MultipleDeviceSelectAllContainerStyle}">
                        <CheckBox x:Name="MultipleSelectAllDevicesCheckBox"
                                  Content="{DynamicResource ChangeMultipleDevices_SelectAllDevices}"
                                  IsChecked="{Binding AllDevicesSelectionState, Mode=OneWay}"
                                  Command="{Binding ToggleSelectAllDevicesCommand}"
                                  ToolTip="{DynamicResource Shared_TooltipSelectRow}"
                                  Style="{StaticResource MultipleDeviceSelectAllCheckBoxStyle}"/>
                    </Border>
                    <TextBlock Text="{DynamicResource ChangeMultipleDevices_FilterLabel}"
                               Style="{StaticResource MultipleDeviceFilterLabelStyle}"/>
                    <ComboBox x:Name="MultipleDeviceFilterComboBox"
                              SelectedValue="{Binding SelectedDeviceFilter, Mode=TwoWay}"
                              SelectedValuePath="Tag"
                              ToolTip="{DynamicResource ChangeMultipleDevices_FilterTooltip}"
                              Style="{StaticResource MultipleDeviceFilterComboBoxStyle}">
                        <ComboBoxItem Tag="All"
                                      Content="{DynamicResource ChangeMultipleDevices_FilterAll}"
                                      Style="{StaticResource MultipleDeviceComboBoxItemStyle}"/>
                        <ComboBoxItem Tag="Online"
                                      Content="{DynamicResource ChangeMultipleDevices_FilterOnline}"
                                      Style="{StaticResource MultipleDeviceComboBoxItemStyle}"/>
                        <ComboBoxItem Tag="Offline"
                                      Content="{DynamicResource ChangeMultipleDevices_FilterOffline}"
                                      Style="{StaticResource MultipleDeviceComboBoxItemStyle}"/>
                        <ComboBoxItem Tag="Active"
                                      Content="{DynamicResource ChangeMultipleDevices_FilterActive}"
                                      Style="{StaticResource MultipleDeviceComboBoxItemStyle}"/>
                        <ComboBoxItem Tag="Inactive"
                                      Content="{DynamicResource ChangeMultipleDevices_FilterInactive}"
                                      Style="{StaticResource MultipleDeviceComboBoxItemStyle}"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <DataGrid x:Name="MultipleDeviceGrid"
                      Grid.Row="1"
                      ItemsSource="{Binding Devices}"
                      SelectionMode="Single"
                  SelectionUnit="FullRow"
                  PreviewMouseRightButtonDown="OnDeviceGridPreviewMouseRightButtonDown"
                      behaviors:DeviceTableColumnLayoutBehavior.PersistColumnRatios="True"
                      behaviors:DeviceTableColumnLayoutBehavior.ColumnRatios="{Binding DeviceTableColumnRatios}"
                      behaviors:DeviceTableColumnLayoutBehavior.SaveColumnRatiosCommand="{Binding SaveMultipleDeviceColumnRatiosCommand}"
                      Style="{StaticResource MultipleDeviceGridStyle}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn behaviors:DeviceTableColumnLayoutBehavior.ColumnKey="Selected"
                                            Width="0.55*"
                                            MinWidth="72"
                                            CellStyle="{StaticResource MultipleDeviceCellStretchStyle}">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="{DynamicResource ChangeMultipleDevices_ColumnSelected}"
                                       Style="{StaticResource DataGridColumnHeaderTextStyle}"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ToggleDeviceSelectionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="{DynamicResource ChangeMultipleDevices_ColumnSelected}"
                                        ToolTip="{DynamicResource Shared_TooltipSelectRow}"
                                        Style="{StaticResource MultipleDeviceSelectionButtonStyle}">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}"
                                              IsHitTestVisible="False"
                                              Focusable="False"
                                              ToolTip="{DynamicResource Shared_TooltipSelectRow}"
                                              Style="{StaticResource DataGridCheckBoxStyle}"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Binding="{Binding Serial}"
                                        behaviors:DeviceTableColumnLayoutBehavior.ColumnKey="Serial"
                                        Width="1.05*"
                                        MinWidth="110"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource DataGridLeftCellTextStyle}">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource ChangeMultipleDevices_ColumnSerial}"
                                       Style="{StaticResource DataGridColumnHeaderTextStyle}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn behaviors:DeviceTableColumnLayoutBehavior.ColumnKey="Name"
                                            Width="1.05*"
                                            MinWidth="110"
                                            CellStyle="{StaticResource MultipleDeviceCellStretchStyle}">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="{DynamicResource ChangeMultipleDevices_ColumnName}"
                                       Style="{StaticResource DataGridColumnHeaderTextStyle}"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{DynamicResource Shared_TooltipDeviceName}"
                                         Style="{StaticResource InlineDataGridTextBoxStyle}"
                                         materialDesign:HintAssist.Hint="{DynamicResource Shared_DeviceNameHint}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn behaviors:DeviceTableColumnLayoutBehavior.ColumnKey="Type"
                                            Width="0.9*"
                                            MinWidth="90"
                                            CellStyle="{StaticResource MultipleDeviceCellStretchStyle}">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="{DynamicResource ChangeMultipleDevices_ColumnType}"
                                       Style="{StaticResource DataGridColumnHeaderTextStyle}"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.TypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="{DynamicResource Shared_TooltipDeviceType}"
                                          Style="{StaticResource InlineDataGridComboBoxStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn SortMemberPath="Active"
                                            behaviors:DeviceTableColumnLayoutBehavior.ColumnKey="Active"
                                            Width="1.05*"
                                            MinWidth="110"
                                            IsReadOnly="True">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="{DynamicResource ChangeMultipleDevices_ColumnActive}"
                                       Style="{StaticResource DataGridColumnHeaderTextStyle}"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DeviceTableActiveBadgeStyle}">
                                    <TextBlock Text="{Binding Active}" Style="{StaticResource DeviceTableBadgeTextStyle}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn SortMemberPath="Status"
                                            behaviors:DeviceTableColumnLayoutBehavior.ColumnKey="Status"
                                            Width="1*"
                                            MinWidth="100"
                                            IsReadOnly="True">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="{DynamicResource ChangeMultipleDevices_ColumnStatus}"
                                       Style="{StaticResource DataGridColumnHeaderTextStyle}"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DeviceTableStatusBadgeStyle}">
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource DeviceTableBadgeTextStyle}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Binding="{Binding Process}"
                                        behaviors:DeviceTableColumnLayoutBehavior.ColumnKey="Process"
                                        Width="1.95*"
                                        MinWidth="150"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource DeviceTableProcessTextStyle}">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource ChangeMultipleDevices_ColumnProcess}"
                                       Style="{StaticResource DataGridColumnHeaderTextStyle}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn behaviors:DeviceTableColumnLayoutBehavior.ColumnKey="Stop"
                                            Width="84"
                                            MinWidth="84"
                                            CellStyle="{StaticResource MultipleDeviceStopCellStyle}"
                                            IsReadOnly="True">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="{DynamicResource ChangeMultipleDevices_ColumnStop}"
                                       Style="{StaticResource DataGridColumnHeaderTextStyle}"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.StopDeviceActionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding HasActionStopButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        IsEnabled="{Binding CanStopAction}"
                                        ToolTip="{DynamicResource ChangeMultipleDevices_StopActionTooltip}"
                                        Padding="2"
                                        Margin="2"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Style="{StaticResource MultipleDeviceStopActionButtonStyle}">
                                    <Grid HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="Stop"
                                                                 Width="14"
                                                                 Height="14"
                                                                 Foreground="{DynamicResource Brush.AccentForeground}"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,4,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{DynamicResource ChangeMultipleDevices_StopAction}"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource MultipleDeviceActionButtonTextStyle}"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <ScrollViewer x:Name="MultipleDeviceProfilePanelScrollViewer"
                          Grid.Row="2"
                          Margin="0,8,0,0"
                          MinHeight="300"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="MultipleDeviceProfilePanelContentGrid"
                      Margin="{StaticResource MultipleDeviceProfilePanelContentMargin}"
                      MinHeight="260">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="1.45*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="RunningActionsPanel"
                            Grid.Column="0"
                            Style="{StaticResource MultipleDeviceInfoSectionBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0"
                                  Style="{StaticResource MultipleDeviceSectionHeaderGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Play"
                                                         Style="{StaticResource MultipleDeviceSectionIconStyle}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{DynamicResource ChangeMultipleDevices_RunningActionsHeader}"
                                           Style="{StaticResource MultipleDeviceSectionTitleTextStyle}"/>
                            </Grid>
                            <Border Grid.Row="1"
                                    Style="{StaticResource MultipleDeviceSectionHeaderSeparatorStyle}"/>
                            <ListBox Grid.Row="2"
                                     Margin="0,5,0,0"
                                     ItemsSource="{Binding RunningActions}"
                                     ItemContainerStyle="{StaticResource RunningActionListBoxItemStyle}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ToolTip="{DynamicResource ChangeMultipleDevices_RunningActionsHeader}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel ToolTip="{Binding DeviceTooltip}">
                                                <TextBlock Text="{Binding ActionName}"
                                                           Style="{StaticResource RunningActionNameTextStyle}"/>
                                                <TextBlock Text="{Binding DeviceSummary}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Command="{Binding DataContext.StopRunningActionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding CanStop}"
                                                    ToolTip="{DynamicResource ChangeMultipleDevices_StopRunningActionTooltip}"
                                                    Width="118"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Style="{StaticResource MultipleDeviceStopActionButtonStyle}">
                                                <Grid HorizontalAlignment="Center"
                                                      VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <materialDesign:PackIcon Kind="Stop"
                                                                             Width="14"
                                                                             Height="14"
                                                                             Foreground="{DynamicResource Brush.AccentForeground}"
                                                                             VerticalAlignment="Center"
                                                                             Margin="0,0,4,0"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{DynamicResource ChangeMultipleDevices_StopAction}"
                                                               TextAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Style="{StaticResource MultipleDeviceActionButtonTextStyle}"/>
                                                </Grid>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border x:Name="MultipleDeviceConfigurationPanel"
                            Grid.Column="1"
                            Style="{StaticResource MultipleDeviceInfoSectionBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Style="{StaticResource MultipleDeviceSectionHeaderGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="TuneVariant"
                                                         Style="{StaticResource MultipleDeviceSectionIconStyle}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{DynamicResource ChangeMultipleDevices_ChangeConfigurationHeader}"
                                           Style="{StaticResource MultipleDeviceSectionTitleTextStyle}"/>
                                <Button x:Name="MultipleAdvancedChangeConfigButton"
                                        Grid.Column="2"
                                        Command="{Binding OpenAdvancedChangeConfigCommand}"
                                        ToolTip="{DynamicResource ChangeMultipleDevices_AdvancedConfigTooltip}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Style="{StaticResource MultipleDeviceInfoDetailsButtonStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="Tune"
                                                                 Style="{StaticResource PrimaryButtonIconStyle}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{DynamicResource ChangeMultipleDevices_AdvancedConfig}"
                                                   Style="{StaticResource MultipleDeviceActionButtonTextStyle}"/>
                                    </Grid>
                                </Button>
                            </Grid>

                            <Border Grid.Row="1"
                                    Style="{StaticResource MultipleDeviceSectionHeaderSeparatorStyle}"/>

                            <Grid x:Name="MultipleDeviceConfigurationFormGrid"
                                  Grid.Row="2"
                                  Margin="0,5,0,0"
                                  Style="{StaticResource MultipleDeviceInfoFormGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="{DynamicResource ChangeMultipleDevices_FieldBrand}"
                                           Style="{StaticResource MultipleDeviceFormLabelStyle}"/>
                                <ComboBox x:Name="MultipleBrandComboBox"
                                          Grid.Row="0"
                                          Grid.Column="1"
                                          ItemsSource="{Binding Brands}"
                                          SelectedItem="{Binding SelectedBrand, Mode=TwoWay}"
                                          ToolTip="{DynamicResource Shared_TooltipProfileSelection}"
                                          Style="{StaticResource MultipleDeviceComboBoxStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Row="1"
                                           Text="{DynamicResource ChangeMultipleDevices_FieldAndroidVersion}"
                                           Style="{StaticResource MultipleDeviceFormLabelStyle}"/>
                                <ComboBox x:Name="MultipleAndroidVersionComboBox"
                                          Grid.Row="1"
                                          Grid.Column="1"
                                          ItemsSource="{Binding AndroidVersions}"
                                          SelectedItem="{Binding SelectedAndroidVersion, Mode=TwoWay}"
                                          ToolTip="{DynamicResource Shared_TooltipProfileSelection}"
                                          Style="{StaticResource MultipleDeviceComboBoxStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Row="2"
                                           Text="{DynamicResource ChangeMultipleDevices_FieldModel}"
                                           Style="{StaticResource MultipleDeviceFormLabelStyle}"/>
                                <TextBox x:Name="MultipleModelTextBox"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         Text="{Binding SelectedModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{DynamicResource Shared_TooltipDeviceField}"
                                         Style="{StaticResource MultipleDeviceTextBoxStyle}"/>

                                <TextBlock Grid.Row="3"
                                           Text="{DynamicResource ChangeMultipleDevices_FieldCountry}"
                                           Style="{StaticResource MultipleDeviceFormLabelStyle}"/>
                                <ComboBox x:Name="MultipleCountryComboBox"
                                          Grid.Row="3"
                                          Grid.Column="1"
                                          ItemsSource="{Binding Countries}"
                                          SelectedItem="{Binding SelectedCountry, Mode=TwoWay}"
                                          ToolTip="{DynamicResource Shared_TooltipProfileSelection}"
                                          Style="{StaticResource MultipleDeviceComboBoxStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Row="4"
                                           Text="{DynamicResource ChangeMultipleDevices_FieldCarrier}"
                                           Style="{StaticResource MultipleDeviceFormLabelStyle}"/>
                                <ComboBox x:Name="MultipleCarrierComboBox"
                                          Grid.Row="4"
                                          Grid.Column="1"
                                          ItemsSource="{Binding Carriers}"
                                          SelectedItem="{Binding SelectedCarrier, Mode=TwoWay}"
                                          ToolTip="{DynamicResource Shared_TooltipProfileSelection}"
                                          Style="{StaticResource MultipleDeviceComboBoxStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <CheckBox Grid.Row="5"
                                          Grid.ColumnSpan="2"
                                          Content="{DynamicResource ChangeMultipleDevices_OptionChangeSim}"
                                          IsChecked="{Binding IsChangeSimEnabled, Mode=TwoWay}"
                                          ToolTip="{DynamicResource Shared_TooltipOption}"
                                          Style="{StaticResource FormCheckBoxStyle}"/>
                                <CheckBox x:Name="MultipleUseDefaultChangeModeCheckBox"
                                          Grid.Row="6"
                                          Grid.ColumnSpan="2"
                                          Content="{DynamicResource ChangeMultipleDevices_OptionDefaultMode}"
                                          IsChecked="{Binding UseDefaultChangeMode, Mode=TwoWay}"
                                          ToolTip="{DynamicResource Shared_TooltipOption}"
                                          Style="{StaticResource FormCheckBoxStyle}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border x:Name="MultipleDeviceActionsPanel"
                            Grid.Column="2"
                            Style="{StaticResource MultipleDeviceActionSectionBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Style="{StaticResource MultipleDeviceSectionHeaderGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Cog"
                                                         Style="{StaticResource MultipleDeviceSectionIconStyle}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{DynamicResource ChangeMultipleDevices_ActionsHeader}"
                                           Style="{StaticResource MultipleDeviceSectionTitleTextStyle}"/>
                            </Grid>

                            <Border Grid.Row="1"
                                    Style="{StaticResource MultipleDeviceSectionHeaderSeparatorStyle}"/>

                            <Grid x:Name="MultipleDeviceActionsContent"
                                  Grid.Row="2"
                                  Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Button Grid.Row="0"
                                        Grid.Column="0"
                                        Command="{Binding RandomSelectedDevicesCommand}"
                                        ToolTip="{DynamicResource ChangeMultipleDevices_ActionRandomSelectedTooltip}"
                                        Style="{StaticResource MultipleDeviceActionButtonStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="Cellphone" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="1" Text="{DynamicResource ChangeMultipleDevices_ActionRandomSelected}" Style="{StaticResource MultipleDeviceActionButtonTextStyle}"/>
                                    </Grid>
                                </Button>
                                <Button Grid.Row="0"
                                        Grid.Column="1"
                                        Command="{Binding ChangeSelectedDevicesCommand}"
                                        ToolTip="{DynamicResource ChangeMultipleDevices_ActionChangeAndWipeTooltip}"
                                        Style="{StaticResource MultipleDeviceActionButtonStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="CellphoneCog" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="1" Text="{DynamicResource ChangeMultipleDevices_ActionChangeAndWipe}" Style="{StaticResource MultipleDeviceActionButtonTextStyle}"/>
                                    </Grid>
                                </Button>
                                <Button Grid.Row="1"
                                        Grid.Column="0"
                                        Command="{Binding WipeSelectedDevicesWithoutChangeCommand}"
                                        ToolTip="{DynamicResource ChangeMultipleDevices_ActionWipeWithoutChangeTooltip}"
                                        Style="{StaticResource MultipleDeviceActionButtonStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="DeleteSweep" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="1" Text="{DynamicResource ChangeMultipleDevices_ActionWipeWithoutChange}" Style="{StaticResource MultipleDeviceActionButtonTextStyle}"/>
                                    </Grid>
                                </Button>
                                <Button Grid.Row="1"
                                        Grid.Column="1"
                                        Command="{Binding ChangeSelectedDevicesWithoutWipeCommand}"
                                        ToolTip="{DynamicResource ChangeMultipleDevices_ActionChangeWithoutWipeTooltip}"
                                        Style="{StaticResource MultipleDeviceActionButtonStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="CellphoneText" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="1" Text="{DynamicResource ChangeMultipleDevices_ActionChangeWithoutWipe}" Style="{StaticResource MultipleDeviceActionButtonTextStyle}"/>
                                    </Grid>
                                </Button>
                                <Button Grid.Row="2"
                                        Grid.Column="0"
                                        Command="{Binding RandomSelectedSimsCommand}"
                                        ToolTip="{DynamicResource ChangeMultipleDevices_ActionRandomSimTooltip}"
                                        Style="{StaticResource MultipleDeviceActionButtonStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="SimCard" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="1" Text="{DynamicResource ChangeMultipleDevices_ActionRandomSim}" Style="{StaticResource MultipleDeviceActionButtonTextStyle}"/>
                                    </Grid>
                                </Button>
                                <Button Grid.Row="2"
                                        Grid.Column="1"
                                        Command="{Binding ChangeSelectedSimsCommand}"
                                        ToolTip="{DynamicResource ChangeMultipleDevices_ActionChangeSimTooltip}"
                                        Style="{StaticResource MultipleDeviceActionButtonStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="SimCard" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="1" Text="{DynamicResource ChangeMultipleDevices_ActionChangeSim}" Style="{StaticResource MultipleDeviceActionButtonTextStyle}"/>
                                    </Grid>
                                </Button>
                                <Button Grid.Row="3"
                                        Grid.Column="0"
                                        Command="{Binding RandomChangeAndWipeSelectedDevicesCommand}"
                                        ToolTip="{DynamicResource ChangeMultipleDevices_ActionRandomChangeAndWipeTooltip}"
                                        Style="{StaticResource MultipleDeviceActionButtonStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="Sync" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="1" Text="{DynamicResource ChangeMultipleDevices_ActionRandomChangeAndWipe}" Style="{StaticResource MultipleDeviceActionButtonTextStyle}"/>
                                    </Grid>
                                </Button>
                                <Button Grid.Row="3"
                                        Grid.Column="1"
                                        Command="{Binding InstallSelectedPackagesCommand}"
                                        ToolTip="{DynamicResource ChangeMultipleDevices_ActionInstallApkTooltip}"
                                        Style="{StaticResource MultipleDeviceActionButtonStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="Android" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{DynamicResource ChangeMultipleDevices_ActionInstallApk}"
                                                   Style="{StaticResource MultipleDeviceActionButtonTextStyle}"/>
                                    </Grid>
                                </Button>
                                <Button Grid.Row="4"
                                        Grid.Column="0"
                                        Command="{Binding ChangeSelectedLocationsCommand}"
                                        ToolTip="{DynamicResource ChangeMultipleDevices_ActionChangeLocationTooltip}"
                                        Style="{StaticResource MultipleDeviceActionButtonStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="MapMarker" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="1" Text="{DynamicResource ChangeMultipleDevices_ActionChangeLocation}" Style="{StaticResource MultipleDeviceActionButtonTextStyle}"/>
                                    </Grid>
                                </Button>
                                <Button Grid.Row="4"
                                        Grid.Column="1"
                                        Command="{Binding ChangeSelectedTimezonesCommand}"
                                        ToolTip="{DynamicResource ChangeMultipleDevices_ActionChangeTimezoneTooltip}"
                                        Style="{StaticResource MultipleDeviceActionButtonStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="ClockOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="1" Text="{DynamicResource ChangeMultipleDevices_ActionChangeTimezone}" Style="{StaticResource MultipleDeviceActionButtonTextStyle}"/>
                                    </Grid>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
        </ScrollViewer>
    </Grid>
    </Grid>
</UserControl>
