                            <Style TargetType="Border" BasedOn="{StaticResource SettingsCardStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedSection}" Value="Storage"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <materialDesign:PackIcon Kind="FolderOutline" Style="{StaticResource SettingsSectionIconStyle}"/>
                                <TextBlock Text="{DynamicResource Settings_Storage}" Style="{StaticResource SettingsSectionTitleStyle}"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Settings_StorageDescription}" Style="{StaticResource SettingsBodyStyle}" Margin="0,0,0,24"/>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock x:Name="ScreenshotDestinationChoiceLabel" Text="{DynamicResource Settings_ScreenshotDestination}" Style="{StaticResource SettingsHeadingStyle}"/>
                                <TextBlock Text="{DynamicResource Settings_ScreenshotDescription}" Style="{StaticResource SettingsCaptionStyle}" Margin="0,4,0,10"/>
                                <ComboBox x:Name="ScreenshotDestinationChoice" SelectedValuePath="Tag" SelectedValue="{Binding Draft.ScreenshotDestination, Mode=TwoWay}"
                                          AutomationProperties.LabeledBy="{Binding ElementName=ScreenshotDestinationChoiceLabel}" Style="{StaticResource SettingsDraftChoiceStyle}">
                                    <ComboBoxItem Tag="Ask" Content="{DynamicResource Settings_AskEachTime}"/>
                                    <ComboBoxItem Tag="Custom" Content="{DynamicResource Settings_UseFolder}"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock x:Name="ScreenshotFolderInputLabel" Text="{DynamicResource Settings_ScreenshotFolder}" Style="{StaticResource SettingsHeadingStyle}"/>
                                <TextBlock Text="{DynamicResource Settings_FolderHint}" Style="{StaticResource SettingsCaptionStyle}" Margin="0,4,0,10"/>
                                <Grid>
                                    <DockPanel LastChildFill="True"><Button DockPanel.Dock="Right" Content="{DynamicResource Settings_Browse}" Command="{Binding BrowseFolderCommand}" CommandParameter="Screenshot" Style="{StaticResource FlatButtonStyle}" Margin="8,0,0,0"/><TextBox x:Name="ScreenshotFolderInput" Text="{Binding Draft.ScreenshotFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding Draft.UseScreenshotFolder}"
                                             AutomationProperties.LabeledBy="{Binding ElementName=ScreenshotFolderInputLabel}" ToolTip="{DynamicResource Settings_PathTooltip}"/></DockPanel>
                                    <TextBlock Text="{DynamicResource Settings_PathPlaceholder}" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsCaptionStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding Draft.ScreenshotFolder}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock x:Name="ExportDestinationChoiceLabel" Text="{DynamicResource Settings_ExportDestination}" Style="{StaticResource SettingsHeadingStyle}"/>
                                <TextBlock Text="{DynamicResource Settings_ExportDescription}" Style="{StaticResource SettingsCaptionStyle}" Margin="0,4,0,10"/>
                                <ComboBox x:Name="ExportDestinationChoice" SelectedValuePath="Tag" SelectedValue="{Binding Draft.ExportDestination, Mode=TwoWay}"
                                          AutomationProperties.LabeledBy="{Binding ElementName=ExportDestinationChoiceLabel}" Style="{StaticResource SettingsDraftChoiceStyle}">
                                    <ComboBoxItem Tag="Ask" Content="{DynamicResource Settings_AskEachTime}"/>
                                    <ComboBoxItem Tag="Custom" Content="{DynamicResource Settings_UseFolder}"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock x:Name="ExportFolderInputLabel" Text="{DynamicResource Settings_ExportFolder}" Style="{StaticResource SettingsHeadingStyle}"/>
                                <TextBlock Text="{DynamicResource Settings_FolderHint}" Style="{StaticResource SettingsCaptionStyle}" Margin="0,4,0,10"/>
                                <Grid>
                                    <DockPanel LastChildFill="True"><Button DockPanel.Dock="Right" Content="{DynamicResource Settings_Browse}" Command="{Binding BrowseFolderCommand}" CommandParameter="Export" Style="{StaticResource FlatButtonStyle}" Margin="8,0,0,0"/><TextBox x:Name="ExportFolderInput" Text="{Binding Draft.ExportFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding Draft.UseExportFolder}"
                                             AutomationProperties.LabeledBy="{Binding ElementName=ExportFolderInputLabel}" ToolTip="{DynamicResource Settings_PathTooltip}"/></DockPanel>
                                    <TextBlock Text="{DynamicResource Settings_PathPlaceholder}" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsCaptionStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding Draft.ExportFolder}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock x:Name="BackupFolderInputLabel" Text="{DynamicResource Settings_BackupFolder}" Style="{StaticResource SettingsHeadingStyle}"/>
                                <TextBlock Text="{DynamicResource Settings_BackupDescription}" Style="{StaticResource SettingsCaptionStyle}" Margin="0,4,0,10"/>
                                <Grid>
                                    <DockPanel LastChildFill="True"><Button DockPanel.Dock="Right" Content="{DynamicResource Settings_Browse}" Command="{Binding BrowseFolderCommand}" CommandParameter="Backup" Style="{StaticResource FlatButtonStyle}" Margin="8,0,0,0"/><TextBox x:Name="BackupFolderInput" Text="{Binding Draft.BackupFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"

                                             AutomationProperties.LabeledBy="{Binding ElementName=BackupFolderInputLabel}" ToolTip="{DynamicResource Settings_PathTooltip}"/></DockPanel>
                                    <TextBlock Text="{DynamicResource Settings_PathPlaceholder}" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsCaptionStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding Draft.BackupFolder}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel><TextBlock Text="{DynamicResource Settings_StorageNotice}" Style="{StaticResource SettingsCaptionStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="AboutPanel" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top" Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings_AboutHeader}" Style="{StaticResource SettingsSectionTitleStyle}" Margin="0,0,0,24"/>
                            <Border Width="56" Height="56" HorizontalAlignment="Left" Background="{DynamicResource Brush.BadgeInfoBackground}"
                                    CornerRadius="{StaticResource Radius.Large}" Margin="0,0,0,16">
                                <materialDesign:PackIcon Kind="Robot" Width="30" Height="30" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{DynamicResource AppName}" Style="{StaticResource SettingsSectionTitleStyle}"/>
                            <TextBlock Text="{DynamicResource Settings_AppDescription}" Style="{StaticResource SettingsBodyStyle}" Margin="0,6,0,16"/>
                            <Border HorizontalAlignment="Left" Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{StaticResource Radius.Small}" Padding="8,4">
                                <TextBlock Style="{StaticResource SettingsCaptionStyle}"><Run Text="{DynamicResource Version}"/><Run Text=" "/><Run Text="{DynamicResource AppVersion}"/></TextBlock>
                            </Border>
                            <Border Style="{StaticResource SettingsDividerStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Laptop" Width="18" Height="18" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,2,10,0"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Settings_LocalNotice}" Style="{StaticResource SettingsCaptionStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
            <Border Grid.Row="4" Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{StaticResource Radius.Large}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="{StaticResource Metric.BorderThickness.Uniform}" Padding="{StaticResource Spacing.CardPadding}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid x:Name="FooterStatus">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Style="{StaticResource SettingsStatusIconStyle}"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource SettingsStatusStyle}"/>
                            <TextBlock Text="{DynamicResource Settings_DraftNotice}" Style="{StaticResource SettingsDraftStyle}"/>
                        </StackPanel>
                    </Grid>
                    <WrapPanel x:Name="FooterActions" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button Command="{Binding DiscardChangesCommand}" ToolTip="{DynamicResource Settings_DiscardTooltip}" Style="{StaticResource FlatButtonStyle}" Margin="0,0,12,0"
                                Content="{DynamicResource Settings_Discard}" ContentTemplate="{StaticResource SettingsButtonLabelTemplate}"/>
                        <Button Command="{Binding SaveCommand}" ToolTip="{DynamicResource Settings_SaveTooltip}" Style="{StaticResource PrimaryButtonStyle}"
                                Content="{DynamicResource Settings_Save}" ContentTemplate="{StaticResource SettingsButtonLabelTemplate}"/>
                    </WrapPanel>
                </Grid>
            </Border>


        </Grid>
    </Grid>
</UserControl>
