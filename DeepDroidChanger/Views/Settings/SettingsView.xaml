
<UserControl x:Class="DeepDroidChanger.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>

        <Style x:Key="SettingsPlaceholderTitleTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource AppTitleTextStyle}">
            <Setter Property="FontSize"
                    Value="{StaticResource Metric.FontSize.Body}"/>
        </Style>

        <Style x:Key="SettingsDescriptionTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource AppLabelTextStyle}">
            <Setter Property="TextWrapping"
                    Value="Wrap"/>
            <Setter Property="Margin"
                    Value="0,8,0,0"/>
        </Style>
    </UserControl.Resources>
    <Grid Style="{StaticResource PageRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"
                           MinHeight="{StaticResource Metric.ToolbarMinHeight}"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource Settings_Title}"
                   Style="{StaticResource PageHeaderTextStyle}"/>

        <GroupBox Grid.Row="1"
                  Header="{DynamicResource Settings_GeneralHeader}"
                  Style="{StaticResource PagePanelGroupBoxStyle}"
                  Margin="0,16,0,0"
                  MaxWidth="520"
                  HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="{DynamicResource Settings_PlaceholderTitle}"
                           Style="{StaticResource SettingsPlaceholderTitleTextStyle}"/>
                <TextBlock Text="{DynamicResource Settings_PlaceholderDescription}"
                           Style="{StaticResource SettingsDescriptionTextStyle}"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
