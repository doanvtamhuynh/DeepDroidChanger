<UserControl x:Class="DeepDroidChanger.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent" SizeChanged="OnSizeChanged"
             FontFamily="{DynamicResource Metric.FontFamily}"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="SettingsBodyStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Metric.FontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource Metric.FontSize.Body}"/>
            <Setter Property="FontWeight" Value="{DynamicResource Metric.FontWeight}"/><Setter Property="FontStyle" Value="{DynamicResource Metric.FontStyle}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SettingsHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingsBodyStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        </Style>
        <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingsHeadingStyle}">
            <Setter Property="FontSize" Value="{DynamicResource Metric.FontSize.Subtitle}"/>
        </Style>
        <Style x:Key="SettingsCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingsBodyStyle}">
            <Setter Property="FontSize" Value="{DynamicResource Metric.FontSize.Small}"/>
        </Style>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="{StaticResource Metric.BorderThickness.Uniform}"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Large}"/>
            <Setter Property="Padding" Value="{StaticResource Spacing.CardPadding}"/>
        </Style>
        <Style x:Key="SettingsSectionIconStyle" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="SettingsDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Margin" Value="0,20,0,20"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
        <Style x:Key="SettingsThemeCardStyle" TargetType="RadioButton" BasedOn="{StaticResource CardRadioButtonStyle}">
            <Setter Property="Padding" Value="{StaticResource Spacing.CardPadding.Compact}"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2"
                                Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Medium}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Stretch"/>
                                <Border x:Name="SelectedBadge" Visibility="Collapsed" Width="24" Height="24"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                        CornerRadius="{StaticResource Radius.Circle}" Background="{DynamicResource Brush.Accent}">
                                    <materialDesign:PackIcon Kind="Check" Width="16" Height="16"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.SurfaceSelected}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                <Setter TargetName="SelectedBadge" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.SurfacePressed}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Focus}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Card" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="SettingsThemePreviewTemplate" TargetType="ContentControl">
            <Border Height="92" CornerRadius="{StaticResource Radius.Small}" Background="{DynamicResource Brush.WindowBackground}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" ClipToBounds="True" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{StaticResource Radius.Small}">
                        <StackPanel Margin="9,12">
                            <Border Height="10" Width="10" HorizontalAlignment="Left" CornerRadius="{StaticResource Radius.ExtraSmall}"
                                    Background="{DynamicResource Brush.Accent}" Margin="0,0,0,12"/>
                            <Border Height="4" Background="{DynamicResource Brush.BorderStrong}" CornerRadius="2" Margin="0,0,0,7"/>
                            <Border Height="4" Background="{DynamicResource Brush.Accent}" CornerRadius="2" Margin="0,0,0,7"/>
                            <Border Height="4" Background="{DynamicResource Brush.BorderStrong}" CornerRadius="2"/>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Column="1" Margin="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Height="6" Width="54" HorizontalAlignment="Left" Background="{DynamicResource Brush.TextPrimary}"
                                Opacity="0.75" CornerRadius="2" Margin="0,0,0,10"/>
                        <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1" CornerRadius="{StaticResource Radius.ExtraSmall}" Padding="8">
                            <StackPanel>
                                <Border Height="4" Background="{DynamicResource Brush.BorderStrong}" CornerRadius="2" Margin="0,0,16,8"/>
                                <Border Height="4" Background="{DynamicResource Brush.Border}" CornerRadius="2" Margin="0,0,32,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </ControlTemplate>
        <Style x:Key="SettingsToggleStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="44" Height="26" Background="Transparent">
                            <Border x:Name="Track" Background="{DynamicResource Brush.SurfacePressed}" BorderBrush="{DynamicResource Brush.BorderStrong}"
                                    BorderThickness="1" CornerRadius="{StaticResource Radius.Circle}"/>
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="{DynamicResource Brush.TextSecondary}"
                                     HorizontalAlignment="Left" Margin="4,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Focus}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Brush.AccentForeground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.AccentPressed}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Focus}"/>
                                <Setter TargetName="Track" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsStatusIconStyle" TargetType="materialDesign:PackIcon">
            <Setter Property="Kind" Value="CheckCircleOutline"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Margin" Value="0,2,10,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasChanges}" Value="True">
                    <Setter Property="Kind" Value="CircleEditOutline"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSaving}" Value="True"><Setter Property="Kind" Value="ContentSaveOutline"/></DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Kind" Value="AlertCircleOutline"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsStatusStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingsHeadingStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsDraftStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingsCaptionStyle}">
            <Setter Property="Margin" Value="0,4,0,0"/><Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasChanges}" Value="True"/>

                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsButtonTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingsHeadingStyle}">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Style>
        <Style x:Key="SettingsDraftChoiceStyle" TargetType="ComboBox" BasedOn="{StaticResource FlatComboBoxStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}"/>

        </Style>

        <Style x:Key="SettingsAppearanceOnlyStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding SelectedSection}" Value="Appearance"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="SettingsNavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="{StaticResource Spacing.ItemPadding}"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Tab" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent"
                                Background="Transparent" CornerRadius="{StaticResource Radius.Medium}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="{DynamicResource Brush.SurfaceSelected}"/>
                                <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Brush.Focus}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Tab" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
<BooleanToVisibilityConverter x:Key="SettingsBooleanToVisibility"/>
        <DataTemplate x:Key="SettingsButtonLabelTemplate">
            <TextBlock Text="{Binding}" Style="{StaticResource SettingsButtonTextStyle}"/>
        </DataTemplate>
        <Style x:Key="SettingsColorErrorStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingsCaptionStyle}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
        </Style>
        <Style x:Key="SettingsSliderRepeatStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent"><Border Height="4" Background="{TemplateBinding Background}" VerticalAlignment="Center" CornerRadius="{StaticResource Radius.Circle}"/></Grid>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsFontSizeSliderStyle" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}"/>
            <Setter Property="SmallChange" Value="1"/>
            <Setter Property="LargeChange" Value="2"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Border x:Name="FocusBorder" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource Radius.Medium}">
                            <Track x:Name="PART_Track" Margin="8,0" Orientation="Horizontal" IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="{DynamicResource Brush.Accent}" Style="{StaticResource SettingsSliderRepeatStyle}"/></Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Brush.Surface}" BorderThickness="2" CornerRadius="{StaticResource Radius.Circle}"/>
                                                </ControlTemplate></Setter.Value></Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.AccentHover}"/></Trigger>
                                                    <Trigger Property="IsDragging" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.AccentPressed}"/></Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Background="{DynamicResource Brush.Border}" Style="{StaticResource SettingsSliderRepeatStyle}"/></Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource Brush.Focus}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="FocusBorder" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsSampleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingsBodyStyle}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="FontFamily" Value="{Binding Draft.Appearance.FontFamily}"/>
            <Setter Property="FontSize" Value="{Binding Draft.Appearance.FontSize}"/>
            <Setter Property="FontWeight" Value="{Binding Draft.Appearance.SampleFontWeight}"/>
            <Setter Property="FontStyle" Value="{Binding Draft.Appearance.SampleFontStyle}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Draft.Appearance.HasCustomTextColor}" Value="True">
                    <Setter Property="Foreground" Value="{Binding Draft.Appearance.TextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsSampleButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Height" Value="{Binding Draft.Appearance.ButtonHeight}"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontFamily" Value="{Binding Draft.Appearance.FontFamily}"/>
            <Setter Property="FontSize" Value="{Binding Draft.Appearance.FontSize}"/>
            <Setter Property="FontWeight" Value="{Binding Draft.Appearance.SampleFontWeight}"/>
            <Setter Property="FontStyle" Value="{Binding Draft.Appearance.SampleFontStyle}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Button}}"
                                   FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                   FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"
                                   FontStyle="{Binding FontStyle, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SampleBorder" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Medium}" Background="Transparent">
                            <Grid>
                                <Border x:Name="SampleFill" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Medium}"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Draft.Appearance.ButtonVariant}" Value="Soft"><Setter TargetName="SampleFill" Property="Opacity" Value="0.14"/></DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SampleBorder" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="SampleBorder" Property="Opacity" Value="0.7"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SampleBorder" Property="BorderBrush" Value="{DynamicResource Brush.Focus}"/>
                                <Setter TargetName="SampleBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SampleBorder" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Draft.Appearance.HasCustomButtonColor}" Value="True">
                    <Setter Property="Background" Value="{Binding Draft.Appearance.ButtonBrush}"/>
                    <Setter Property="BorderBrush" Value="{Binding Draft.Appearance.ButtonBrush}"/>
                    <Setter Property="Foreground" Value="{Binding Draft.Appearance.ButtonForeground}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Draft.Appearance.ButtonVariant}" Value="Outlined">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Draft.Appearance.ButtonVariant}" Value="Soft">
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Draft.Appearance.HasCustomButtonColor}" Value="True"/>
                        <Condition Binding="{Binding Draft.Appearance.ButtonVariant}" Value="Outlined"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{Binding Draft.Appearance.ButtonTextBrush}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Draft.Appearance.HasCustomButtonColor}" Value="True"/>
                        <Condition Binding="{Binding Draft.Appearance.ButtonVariant}" Value="Soft"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{Binding Draft.Appearance.ButtonTextBrush}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource Spacing.PageMargin}">
        <Grid MaxWidth="1100" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="{DynamicResource Settings_Title}" Foreground="{DynamicResource Brush.TextPrimary}"
                           FontFamily="{DynamicResource Metric.FontFamily}" FontSize="{DynamicResource Metric.FontSize.Display}" FontWeight="Bold"/>
                <TextBlock Text="{DynamicResource Settings_Description}" Style="{StaticResource SettingsBodyStyle}" Margin="0,8,0,0"/>
            </StackPanel>
            <ListBox x:Name="SettingsSections" Grid.Row="1" SelectedValuePath="Tag" SelectedValue="{Binding SelectedSection, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,14"
                     ItemContainerStyle="{StaticResource SettingsNavItemStyle}" IsEnabled="{Binding CanEdit}"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="{DynamicResource Settings_Sections}">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBoxItem Tag="Appearance" Content="{DynamicResource Settings_AppearanceHeader}">
                    <ListBoxItem.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PaletteOutline" Width="18" Height="18" Margin="0,0,8,0"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <TextBlock Text="{Binding}" Style="{StaticResource SettingsHeadingStyle}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBoxItem.ContentTemplate>
                </ListBoxItem>
                <ListBoxItem Tag="Account" Content="{DynamicResource Settings_Account}">
                    <ListBoxItem.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountOutline" Width="18" Height="18" Margin="0,0,8,0"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <TextBlock Text="{Binding}" Style="{StaticResource SettingsHeadingStyle}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBoxItem.ContentTemplate>
                </ListBoxItem>
                <ListBoxItem Tag="DeviceView" Content="{DynamicResource Settings_DeviceView}">
                    <ListBoxItem.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CellphoneLink" Width="18" Height="18" Margin="0,0,8,0"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <TextBlock Text="{Binding}" Style="{StaticResource SettingsHeadingStyle}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBoxItem.ContentTemplate>
                </ListBoxItem>
                <ListBoxItem Tag="Batch" Content="{DynamicResource Settings_Batch}">
                    <ListBoxItem.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewGridOutline" Width="18" Height="18" Margin="0,0,8,0"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <TextBlock Text="{Binding}" Style="{StaticResource SettingsHeadingStyle}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBoxItem.ContentTemplate>
                </ListBoxItem>
                <ListBoxItem Tag="Storage" Content="{DynamicResource Settings_Storage}">
                    <ListBoxItem.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderOutline" Width="18" Height="18" Margin="0,0,8,0"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <TextBlock Text="{Binding}" Style="{StaticResource SettingsHeadingStyle}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBoxItem.ContentTemplate>
                </ListBoxItem>

            </ListBox>
            <ScrollViewer x:Name="SettingsScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" IsEnabled="{Binding CanEdit}">
                <Grid VerticalAlignment="Top" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="AboutColumn" Width="288"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel x:Name="AppearancePanel" Style="{StaticResource SettingsAppearanceOnlyStyle}">
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="PaletteOutline" Style="{StaticResource SettingsSectionIconStyle}"/>
                                    <TextBlock Text="{DynamicResource Settings_AppearanceHeader}" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="{DynamicResource Settings_StylingShortcut}" Click="OnShowStylingClick"
                                        Style="{StaticResource FlatButtonStyle}" ContentTemplate="{StaticResource SettingsButtonLabelTemplate}"/>
                            </Grid>
                            <StackPanel IsEnabled="{Binding CanEdit}">
