<UserControl x:Class="DeepDroidChanger.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Style="{StaticResource SettingsRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"
                           MinHeight="{StaticResource Metric.ToolbarMinHeight}"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource Settings_Title}"
                   Style="{StaticResource SettingsHeaderTextStyle}"/>

        <GroupBox Grid.Row="1"
                  Header="{DynamicResource Settings_GeneralHeader}"
                  Style="{StaticResource SettingsPanelStyle}"
                  Margin="0,16,0,0"
                  MaxWidth="520"
                  HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="{DynamicResource Settings_PlaceholderTitle}"
                           Style="{StaticResource SettingsPlaceholderTitleTextStyle}"/>
                <TextBlock Text="{DynamicResource Settings_PlaceholderDescription}"
                           Style="{StaticResource SettingsDescriptionTextStyle}"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
