
<Window x:Class="DeepDroidChanger.Views.DeviceViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewModels="clr-namespace:DeepDroidChanger.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="590"
        Height="660"
        MinWidth="350"
        MinHeight="660"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.WindowBackground}"
        TextElement.Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Metric.FontFamily}"
        d:DataContext="{d:DesignInstance viewModels:DeviceViewerViewModel}">

    <Window.Resources>

        <PathGeometry x:Key="PhoneBodyGeometry">
            M 30,0
            L 90,0
            Q 120,0 120,30
            L 120,210
            Q 120,240 90,240
            L 30,240
            Q 0,240 0,210
            L 0,30
            Q 0,0 30,0 Z
        </PathGeometry>

        <PathGeometry x:Key="PhoneScreenGeometry">
            M 14,30 L 106,30 L 106,196 L 14,196 Z
        </PathGeometry>

        <sys:Double x:Key="DeviceViewerTitleBarMinHeight">40</sys:Double>
        <sys:Double x:Key="DeviceViewerStatusBarMinHeight">22</sys:Double>

        <Style x:Key="DeviceViewerRootBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="DeviceViewerTitleBarStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style x:Key="DeviceViewerPanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="DeviceViewerInfoPillStyle" TargetType="Border">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}"/>
        </Style>

        <Style x:Key="DeviceViewerTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Metric.FontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DeviceViewerSmallTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Metric.FontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DeviceViewerButtonTextStyle" TargetType="TextBlock"
               BasedOn="{StaticResource DeviceViewerSmallTextStyle}">
            <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
        </Style>

        <Style x:Key="DeviceViewerMutedTextStyle" TargetType="TextBlock"
               BasedOn="{StaticResource DeviceViewerSmallTextStyle}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        </Style>

        <Style x:Key="DeviceViewerInfoPillTextStyle" TargetType="TextBlock"
               BasedOn="{StaticResource DeviceViewerSmallTextStyle}">
            <Setter Property="MaxWidth" Value="150"/>
        </Style>

        <Style x:Key="DeviceViewerSectionLabelStyle" TargetType="TextBlock"
               BasedOn="{StaticResource DeviceViewerMutedTextStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="DeviceViewerIconStyle" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DeviceViewerButtonIconStyle" TargetType="materialDesign:PackIcon"
               BasedOn="{StaticResource DeviceViewerIconStyle}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
        </Style>

        <Style x:Key="DeviceViewerLeftButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Medium}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Brush.AccentHover}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Brush.AccentHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Brush.AccentPressed}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Brush.SurfacePressed}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeviceViewerNavButtonStyle" TargetType="Button"
               BasedOn="{StaticResource DeviceViewerLeftButtonStyle}">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <Style x:Key="DeviceViewerActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Medium}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Brush.AccentHover}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Brush.AccentHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Brush.AccentPressed}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Brush.SurfacePressed}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeviceViewerInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Brush.SurfaceSelected}"/>
            <Setter Property="FontFamily" Value="{StaticResource Metric.FontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="materialDesign:HintAssist.Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
        </Style>

        <Style x:Key="DeviceViewerStatusBarTextStyle" TargetType="TextBlock"
               BasedOn="{StaticResource DeviceViewerSmallTextStyle}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        </Style>

        <Style x:Key="DeviceViewerPlaceholderStyle" TargetType="Grid">
            <Setter Property="Background" Value="{DynamicResource Brush.DeviceViewerCanvas}"/>
            <Setter Property="Visibility" Value="Visible"/>
        </Style>

        <Style x:Key="DeviceViewerPlaceholderIconContainerStyle" TargetType="Canvas">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="240"/>
        </Style>

        <Style x:Key="DeviceViewerPhoneBodyStyle" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource PhoneBodyGeometry}"/>
            <Setter Property="Fill" Value="{DynamicResource Brush.DeviceViewerBody}"/>
            <Setter Property="Stroke" Value="Transparent"/>
        </Style>

        <Style x:Key="DeviceViewerPhoneScreenStyle" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource PhoneScreenGeometry}"/>
            <Setter Property="Fill" Value="{DynamicResource Brush.DeviceViewerScreen}"/>
        </Style>

        <Style x:Key="DeviceViewerPhoneHomeStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource Brush.DeviceViewerScreen}"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Canvas.Left" Value="50"/>
            <Setter Property="Canvas.Top" Value="210"/>
        </Style>

        <Style x:Key="DeviceViewerStatusPillStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}"/>
        </Style>
    </Window.Resources>
    <Border Style="{StaticResource DeviceViewerRootBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"
                               MinHeight="{StaticResource DeviceViewerTitleBarMinHeight}"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"
                               MinHeight="{StaticResource DeviceViewerStatusBarMinHeight}"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource DeviceViewerTitleBarStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            VerticalAlignment="Center"
                            Padding="12,4"
                            Style="{DynamicResource DeviceViewerStatusPillStyle}">
                        <TextBlock Text="{DynamicResource DeviceViewerStatusUnavailable}"
                                   Style="{StaticResource DeviceViewerSmallTextStyle}"/>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="ActionsColumn" Width="315"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Background="{DynamicResource Brush.WindowBackground}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>

                        <RowDefinition Height="58"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" x:Name="ViewerContainer" SizeChanged="ViewerContainer_SizeChanged" Background="{DynamicResource Brush.DeviceViewerCanvas}">
                        <Border x:Name="ViewerFrame"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Brush.DeviceViewerCanvas}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Small}"
                                ClipToBounds="True">
                            <Grid>
                                <Grid IsHitTestVisible="False"
                                      Style="{StaticResource DeviceViewerPlaceholderStyle}">
                                    <Viewbox Width="100" Height="200"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Stretch="Uniform">
                                        <Canvas Style="{StaticResource DeviceViewerPlaceholderIconContainerStyle}">
                                            <Path Style="{StaticResource DeviceViewerPhoneBodyStyle}"/>

                                            <Path Style="{StaticResource DeviceViewerPhoneScreenStyle}"/>

                                            <Ellipse Style="{StaticResource DeviceViewerPhoneHomeStyle}"/>

                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource DeviceViewerNavButtonStyle}"
                                IsEnabled="False"
                                ToolTip="{DynamicResource Shared_TooltipAction}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewGrid"
                                                         Style="{StaticResource DeviceViewerButtonIconStyle}"
                                                         Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource DeviceViewerRecent}"
                                           Style="{StaticResource DeviceViewerButtonTextStyle}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DeviceViewerNavButtonStyle}"
                                IsEnabled="False"
                                ToolTip="{DynamicResource Shared_TooltipAction}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Home"
                                                         Style="{StaticResource DeviceViewerButtonIconStyle}"
                                                         Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource DeviceViewerHome}"
                                           Style="{StaticResource DeviceViewerButtonTextStyle}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DeviceViewerNavButtonStyle}"
                                IsEnabled="False"
                                ToolTip="{DynamicResource Shared_TooltipAction}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ArrowLeft"
                                                         Style="{StaticResource DeviceViewerButtonIconStyle}"
                                                         Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource DeviceViewerBack}"
                                           Style="{StaticResource DeviceViewerButtonTextStyle}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Column="1"
                        Style="{StaticResource DeviceViewerPanelBorderStyle}"
                        BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid x:Name="ExpandedActionsPanel">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActionsPanelExpanded}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource DeviceViewerTitleBarStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="LightningBolt"
                                                                 Style="{StaticResource DeviceViewerIconStyle}"
                                                                 Margin="0,0,7,0"/>
                                        <TextBlock Text="{DynamicResource DeviceViewerActions}"
                                                   Style="{StaticResource DeviceViewerTitleTextStyle}"/>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Width="32"
                                            Height="28"
                                            Margin="6,0,0,0"
                                            Padding="0"
                                            Background="{DynamicResource Brush.SurfacePressed}"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            Foreground="{DynamicResource Brush.TextPrimary}"
                                            Style="{StaticResource FlatButtonStyle}"
                                            Command="{Binding ToggleActionsPanelCommand}"
                                            ToolTip="{DynamicResource DeviceViewerCollapseActions}">
                                        <materialDesign:PackIcon Kind="ChevronDoubleLeft"
                                                                 Width="16"
                                                                 Height="16"
                                                                 Foreground="{DynamicResource Brush.TextPrimary}"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1"
                                          IsEnabled="False"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="12,10">
                                <StackPanel Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Keyboard"
                                                                 Style="{StaticResource DeviceViewerIconStyle}"
                                                                 Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource DeviceViewerInputText}"
                                                   Style="{StaticResource DeviceViewerSectionLabelStyle}"/>
                                    </StackPanel>
                                    <TextBox Height="74"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             ToolTip="{DynamicResource Shared_TooltipTextInput}"
                                             Style="{StaticResource DeviceViewerInputStyle}"
                                             materialDesign:HintAssist.Hint="{DynamicResource DeviceViewerInputTextHint}"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                Style="{StaticResource DeviceViewerActionButtonStyle}"
                                                ToolTip="{DynamicResource Shared_TooltipAction}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Send"
                                                                         Style="{StaticResource DeviceViewerButtonIconStyle}"
                                                                         Margin="0,0,5,0"/>
                                                <TextBlock Text="{DynamicResource DeviceViewerSend}"
                                                           Style="{StaticResource DeviceViewerButtonTextStyle}"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="2"
                                                Style="{StaticResource DeviceViewerActionButtonStyle}"
                                                ToolTip="{DynamicResource Shared_TooltipAction}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="KeyboardReturn"
                                                                         Style="{StaticResource DeviceViewerButtonIconStyle}"
                                                                         Margin="0,0,5,0"/>
                                                <TextBlock Text="{DynamicResource DeviceViewerEnter}"
                                                           Style="{StaticResource DeviceViewerButtonTextStyle}"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ConsoleLine"
                                                                 Style="{StaticResource DeviceViewerIconStyle}"
                                                                 Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource DeviceViewerAdbShell}"
                                                   Style="{StaticResource DeviceViewerSectionLabelStyle}"/>
                                    </StackPanel>
                                    <TextBox Height="74"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             ToolTip="{DynamicResource Shared_TooltipTextInput}"
                                             Style="{StaticResource DeviceViewerInputStyle}"
                                             materialDesign:HintAssist.Hint="{DynamicResource DeviceViewerShellCommandHint}"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Style="{StaticResource DeviceViewerActionButtonStyle}"
                                                ToolTip="{DynamicResource Shared_TooltipAction}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Send"
                                                                         Style="{StaticResource DeviceViewerButtonIconStyle}"
                                                                         Margin="0,0,5,0"/>
                                                <TextBlock Text="{DynamicResource DeviceViewerSend}"
                                                           Style="{StaticResource DeviceViewerButtonTextStyle}"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                </StackPanel>

                                <StackPanel Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <materialDesign:PackIcon Kind="CellphoneSettings"
                                                                 Style="{StaticResource DeviceViewerIconStyle}"
                                                                 Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource DeviceViewerDeviceControls}"
                                                   Style="{StaticResource DeviceViewerSectionLabelStyle}"
                                                   Margin="0"/>
                                    </StackPanel>
                                    <UniformGrid Columns="2" Margin="0,6,0,0">
                                        <Button Style="{StaticResource DeviceViewerActionButtonStyle}"
                                                ToolTip="{DynamicResource Shared_TooltipAction}"
                                                Margin="0,0,4,6">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="VolumeMinus"
                                                                         Style="{StaticResource DeviceViewerButtonIconStyle}"
                                                                         Margin="0,0,5,0"/>
                                                <TextBlock Text="{DynamicResource DeviceViewerVolumeDown}"
                                                           Style="{StaticResource DeviceViewerButtonTextStyle}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource DeviceViewerActionButtonStyle}"
                                                ToolTip="{DynamicResource Shared_TooltipAction}"
                                                Margin="4,0,0,6">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="VolumePlus"
                                                                         Style="{StaticResource DeviceViewerButtonIconStyle}"
                                                                         Margin="0,0,5,0"/>
                                                <TextBlock Text="{DynamicResource DeviceViewerVolumeUp}"
                                                           Style="{StaticResource DeviceViewerButtonTextStyle}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource DeviceViewerActionButtonStyle}"
                                                ToolTip="{DynamicResource Shared_TooltipAction}"
                                                Margin="0,0,4,6">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Camera"
                                                                         Style="{StaticResource DeviceViewerButtonIconStyle}"
                                                                         Margin="0,0,5,0"/>
                                                <TextBlock Text="{DynamicResource DeviceViewerScreenshot}"
                                                           Style="{StaticResource DeviceViewerButtonTextStyle}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource DeviceViewerActionButtonStyle}"
                                                ToolTip="{DynamicResource Shared_TooltipAction}"
                                                Margin="4,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Power"
                                                                         Style="{StaticResource DeviceViewerButtonIconStyle}"
                                                                         Margin="0,0,5,0"/>
                                                <TextBlock Text="{DynamicResource DeviceViewerPower}"
                                                           Style="{StaticResource DeviceViewerButtonTextStyle}"/>
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <Grid x:Name="CollapsedActionsRail">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActionsPanelExpanded}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Margin="0,6">
                                <Button Width="34"
                                        Height="28"
                                        Margin="0,0,0,8"
                                        Padding="0"
                                        Background="{DynamicResource Brush.SurfacePressed}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                        Style="{StaticResource FlatButtonStyle}"
                                        Command="{Binding ToggleActionsPanelCommand}"
                                        ToolTip="{DynamicResource DeviceViewerExpandActions}">
                                    <materialDesign:PackIcon Kind="ChevronDoubleRight"
                                                             Width="16"
                                                             Height="16"
                                                             Foreground="{DynamicResource Brush.TextPrimary}"/>
                                </Button>

                                <Button Style="{StaticResource DeviceViewerLeftButtonStyle}"
                                        IsEnabled="False"
                                        ToolTip="{DynamicResource DeviceViewerVolumeDown}">
                                    <materialDesign:PackIcon Kind="VolumeMinus"
                                                             Style="{StaticResource DeviceViewerButtonIconStyle}"/>
                                </Button>
                                <Button Style="{StaticResource DeviceViewerLeftButtonStyle}"
                                        IsEnabled="False"
                                        ToolTip="{DynamicResource DeviceViewerVolumeUp}">
                                    <materialDesign:PackIcon Kind="VolumePlus"
                                                             Style="{StaticResource DeviceViewerButtonIconStyle}"/>
                                </Button>
                                <Button Style="{StaticResource DeviceViewerLeftButtonStyle}"
                                        IsEnabled="False"
                                        ToolTip="{DynamicResource DeviceViewerScreenshot}">
                                    <materialDesign:PackIcon Kind="Camera"
                                                             Style="{StaticResource DeviceViewerButtonIconStyle}"/>
                                </Button>
                                <Button Style="{StaticResource DeviceViewerLeftButtonStyle}"
                                        IsEnabled="False"
                                        ToolTip="{DynamicResource DeviceViewerPower}">
                                    <materialDesign:PackIcon Kind="Power"
                                                             Style="{StaticResource DeviceViewerButtonIconStyle}"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,1,0,0"
                    Padding="12,0">
                <Grid>
                    <StackPanel Orientation="Horizontal"
