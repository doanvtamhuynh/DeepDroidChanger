
<Window x:Class="DeepDroidChanger.Views.DeviceViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewModels="clr-namespace:DeepDroidChanger.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="893"
        Height="700"
        MinWidth="833"
        MinHeight="640"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.WindowBackground}"
        TextElement.Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Metric.FontFamily}"
        d:DataContext="{d:DesignInstance viewModels:DeviceViewerViewModel}">

    <Window.Resources>

        <PathGeometry x:Key="PhoneBodyGeometry">
            M 30,0
            L 90,0
            Q 120,0 120,30
            L 120,210
            Q 120,240 90,240
            L 30,240
            Q 0,240 0,210
            L 0,30
            Q 0,0 30,0 Z
        </PathGeometry>

        <PathGeometry x:Key="PhoneScreenGeometry">
            M 14,30 L 106,30 L 106,196 L 14,196 Z
        </PathGeometry>

        <PathGeometry x:Key="ArrowUpGeometry">
            M 60,60 L 60,140
            M 60,60 L 44,80
            M 60,60 L 76,80
        </PathGeometry>

        <PathGeometry x:Key="ArrowDownGeometry">
            M 72,90 L 72,170
            M 72,170 L 56,150
            M 72,170 L 88,150
        </PathGeometry>

        <sys:Double x:Key="DeviceViewerTitleBarMinHeight">40</sys:Double>
        <sys:Double x:Key="DeviceViewerStatusBarMinHeight">22</sys:Double>

        <Style x:Key="DeviceViewerRootBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="DeviceViewerTitleBarStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style x:Key="DeviceViewerPanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="DeviceViewerInfoPillStyle" TargetType="Border">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}"/>
        </Style>

        <Style x:Key="DeviceViewerTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Metric.FontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DeviceViewerSmallTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Metric.FontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DeviceViewerButtonTextStyle" TargetType="TextBlock"
               BasedOn="{StaticResource DeviceViewerSmallTextStyle}">
            <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
        </Style>

        <Style x:Key="DeviceViewerMutedTextStyle" TargetType="TextBlock"
               BasedOn="{StaticResource DeviceViewerSmallTextStyle}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        </Style>

        <Style x:Key="DeviceViewerInfoPillTextStyle" TargetType="TextBlock"
               BasedOn="{StaticResource DeviceViewerSmallTextStyle}">
            <Setter Property="MaxWidth" Value="150"/>
        </Style>

        <Style x:Key="DeviceViewerSectionLabelStyle" TargetType="TextBlock"
               BasedOn="{StaticResource DeviceViewerMutedTextStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="DeviceViewerIconStyle" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DeviceViewerButtonIconStyle" TargetType="materialDesign:PackIcon"
               BasedOn="{StaticResource DeviceViewerIconStyle}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
        </Style>

        <Style x:Key="DeviceViewerLeftButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Medium}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Brush.AccentHover}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Brush.AccentHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Brush.AccentPressed}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Brush.SurfacePressed}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeviceViewerNavButtonStyle" TargetType="Button"
               BasedOn="{StaticResource DeviceViewerLeftButtonStyle}">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <Style x:Key="DeviceViewerActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Medium}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Brush.AccentHover}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Brush.AccentHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Brush.AccentPressed}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Brush.SurfacePressed}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeviceViewerInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Brush.SurfaceSelected}"/>
            <Setter Property="FontFamily" Value="{StaticResource Metric.FontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="materialDesign:HintAssist.Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
        </Style>

        <Style x:Key="DeviceViewerStreamStatusStyle" TargetType="TextBlock"
               BasedOn="{StaticResource DeviceViewerMutedTextStyle}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DeviceViewerStreamErrorStyle" TargetType="TextBlock"
               BasedOn="{StaticResource DeviceViewerStreamStatusStyle}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
        </Style>

        <Style x:Key="DeviceViewerStatusBarTextStyle" TargetType="TextBlock"
               BasedOn="{StaticResource DeviceViewerSmallTextStyle}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        </Style>

        <Style x:Key="DeviceViewerDisconnectedOverlayStyle" TargetType="Grid">
            <Setter Property="Background" Value="{DynamicResource Brush.DeviceViewerStream}"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWaitingForDevice}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeviceViewerDisconnectedIconContainerStyle" TargetType="Canvas">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="240"/>
        </Style>

        <Style x:Key="DeviceViewerPhoneBodyStyle" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource PhoneBodyGeometry}"/>
            <Setter Property="Fill" Value="{DynamicResource Brush.DeviceViewerBody}"/>
            <Setter Property="Stroke" Value="Transparent"/>
        </Style>

        <Style x:Key="DeviceViewerPhoneScreenStyle" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource PhoneScreenGeometry}"/>
            <Setter Property="Fill" Value="{DynamicResource Brush.DeviceViewerScreen}"/>
        </Style>

        <Style x:Key="DeviceViewerPhoneHomeStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource Brush.DeviceViewerScreen}"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Canvas.Left" Value="50"/>
            <Setter Property="Canvas.Top" Value="210"/>
        </Style>

        <Style x:Key="DeviceViewerArrowUpStyle" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource ArrowUpGeometry}"/>
            <Setter Property="Stroke" Value="{DynamicResource Brush.DeviceViewerGlyph}"/>
            <Setter Property="StrokeThickness" Value="8"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Fill" Value="Transparent"/>
        </Style>

        <Style x:Key="DeviceViewerArrowDownStyle" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource ArrowDownGeometry}"/>
            <Setter Property="Stroke" Value="{DynamicResource Brush.DeviceViewerGlyph}"/>
            <Setter Property="StrokeThickness" Value="8"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Fill" Value="Transparent"/>
        </Style>

        <Style x:Key="DeviceViewerDisconnectedBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Circle}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Danger}"/>

            <Setter Property="Canvas.Left" Value="84"/>
            <Setter Property="Canvas.Top" Value="204"/>
        </Style>

        <Style x:Key="DeviceViewerDisconnectedXStyle" TargetType="Path">
            <Setter Property="Data" Value="M 10,10 L 34,34 M 34,10 L 10,34"/>
            <Setter Property="Stroke" Value="{DynamicResource Brush.DeviceViewerGlyph}"/>
            <Setter Property="StrokeThickness" Value="5"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DeviceViewerStatusPillStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSelected}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDeviceDisconnected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border Style="{StaticResource DeviceViewerRootBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"
                               MinHeight="{StaticResource DeviceViewerTitleBarMinHeight}"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"
                               MinHeight="{StaticResource DeviceViewerStatusBarMinHeight}"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource DeviceViewerTitleBarStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Cellphone"
                                                 Style="{StaticResource DeviceViewerIconStyle}"
                                                 Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource DeviceViewerManagerTitle}"
                                   Style="{StaticResource DeviceViewerTitleTextStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Style="{StaticResource DeviceViewerInfoPillStyle}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Usb"
                                                         Style="{StaticResource DeviceViewerIconStyle}"
                                                         Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding DeviceName}"
                                           Style="{StaticResource DeviceViewerSmallTextStyle}"/>
                                <TextBlock Text="{DynamicResource DeviceViewerDeviceSeparator}"
                                           Style="{StaticResource DeviceViewerMutedTextStyle}"/>
                                <TextBlock Text="{Binding Serial}"
                                           Style="{StaticResource DeviceViewerSmallTextStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DeviceViewerInfoPillStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Wifi"
                                                         Style="{StaticResource DeviceViewerIconStyle}"
                                                         Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding DeviceIpText}"
                                           Style="{StaticResource DeviceViewerInfoPillTextStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Column="2"
                            VerticalAlignment="Center"
                            Padding="12,4"
                            Style="{DynamicResource DeviceViewerStatusPillStyle}">
                        <TextBlock Text="{Binding DeviceStatusText}"
                                   Style="{StaticResource DeviceViewerSmallTextStyle}"/>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="315"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Background="{DynamicResource Brush.WindowBackground}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>

                        <RowDefinition Height="58"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" x:Name="StreamContainer" SizeChanged="StreamContainer_SizeChanged" Background="{DynamicResource Brush.DeviceViewerStream}">
                        <Border x:Name="StreamFrame"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Brush.DeviceViewerStream}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Small}"
                                ClipToBounds="True">
                            <Grid>
                                <Border x:Name="DeviceViewerBounds"
                                        Background="{DynamicResource Brush.DeviceViewerStream}"/>

                                <Grid IsHitTestVisible="False"
                                      Background="{DynamicResource Brush.DeviceViewerStream}"
                                      Visibility="Collapsed">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStreamLoading}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <TextBlock Text="{DynamicResource DeviceViewerLoadingStream}"
                                               Style="{StaticResource DeviceViewerStreamStatusStyle}"/>
                                </Grid>

                                <Grid IsHitTestVisible="False"
                                      Background="{DynamicResource Brush.DeviceViewerStream}"
                                      Visibility="Collapsed">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasStreamError}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <TextBlock Text="{DynamicResource DeviceViewerStreamError}"
                                               Style="{StaticResource DeviceViewerStreamErrorStyle}"/>
                                </Grid>

                                <Grid IsHitTestVisible="False"
                                      Style="{StaticResource DeviceViewerDisconnectedOverlayStyle}">
                                    <Viewbox Width="100" Height="200"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Stretch="Uniform">
                                        <Canvas Style="{StaticResource DeviceViewerDisconnectedIconContainerStyle}">

                                            <Path Style="{StaticResource DeviceViewerPhoneBodyStyle}"/>

                                            <Path Style="{StaticResource DeviceViewerPhoneScreenStyle}"/>

                                            <Ellipse Style="{StaticResource DeviceViewerPhoneHomeStyle}"/>

                                            <Path Style="{StaticResource DeviceViewerArrowUpStyle}"/>

                                            <Path Style="{StaticResource DeviceViewerArrowDownStyle}"/>

                                            <Border Style="{StaticResource DeviceViewerDisconnectedBadgeStyle}">
                                                <Path Style="{StaticResource DeviceViewerDisconnectedXStyle}"/>
                                            </Border>

                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource DeviceViewerNavButtonStyle}"
                                Command="{Binding RecentCommand}"
                                ToolTip="{DynamicResource Shared_TooltipAction}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewGrid"
                                                         Style="{StaticResource DeviceViewerButtonIconStyle}"
                                                         Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource DeviceViewerRecent}"
                                           Style="{StaticResource DeviceViewerButtonTextStyle}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DeviceViewerNavButtonStyle}"
                                Command="{Binding HomeCommand}"
                                ToolTip="{DynamicResource Shared_TooltipAction}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Home"
                                                         Style="{StaticResource DeviceViewerButtonIconStyle}"
                                                         Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource DeviceViewerHome}"
                                           Style="{StaticResource DeviceViewerButtonTextStyle}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DeviceViewerNavButtonStyle}"
                                Command="{Binding BackCommand}"
                                ToolTip="{DynamicResource Shared_TooltipAction}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ArrowLeft"
                                                         Style="{StaticResource DeviceViewerButtonIconStyle}"
                                                         Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource DeviceViewerBack}"
                                           Style="{StaticResource DeviceViewerButtonTextStyle}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Column="1"
                        Style="{StaticResource DeviceViewerPanelBorderStyle}"
                        BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource DeviceViewerTitleBarStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="LightningBolt"
                                                         Style="{StaticResource DeviceViewerIconStyle}"
                                                         Margin="0,0,7,0"/>
                                <TextBlock Text="{DynamicResource DeviceViewerActions}"
                                           Style="{StaticResource DeviceViewerTitleTextStyle}"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="12,10">
                                <StackPanel Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Keyboard"
                                                                 Style="{StaticResource DeviceViewerIconStyle}"
                                                                 Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource DeviceViewerInputText}"
                                                   Style="{StaticResource DeviceViewerSectionLabelStyle}"/>
                                    </StackPanel>
                                    <TextBox Height="74"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{DynamicResource Shared_TooltipTextInput}"
                                             Style="{StaticResource DeviceViewerInputStyle}"
                                             materialDesign:HintAssist.Hint="{DynamicResource DeviceViewerInputTextHint}"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="6"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0"
                                                Style="{StaticResource DeviceViewerActionButtonStyle}"
                                                Command="{Binding SendInputTextCommand}"
                                                ToolTip="{DynamicResource Shared_TooltipAction}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Send"
                                                                         Style="{StaticResource DeviceViewerButtonIconStyle}"
                                                                         Margin="0,0,5,0"/>
                                                <TextBlock Text="{DynamicResource DeviceViewerSend}"
                                                           Style="{StaticResource DeviceViewerButtonTextStyle}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Row="2"
                                                Style="{StaticResource DeviceViewerActionButtonStyle}"
                                                Command="{Binding EnterCommand}"
                                                ToolTip="{DynamicResource Shared_TooltipAction}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="KeyboardReturn"
                                                                         Style="{StaticResource DeviceViewerButtonIconStyle}"
                                                                         Margin="0,0,5,0"/>
                                                <TextBlock Text="{DynamicResource DeviceViewerEnter}"
                                                           Style="{StaticResource DeviceViewerButtonTextStyle}"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ConsoleLine"
                                                                 Style="{StaticResource DeviceViewerIconStyle}"
                                                                 Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource DeviceViewerAdbShell}"
                                                   Style="{StaticResource DeviceViewerSectionLabelStyle}"/>
                                    </StackPanel>
                                    <TextBox Height="74"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             Text="{Binding ShellCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{DynamicResource Shared_TooltipTextInput}"
                                             Style="{StaticResource DeviceViewerInputStyle}"
                                             materialDesign:HintAssist.Hint="{DynamicResource DeviceViewerShellCommandHint}"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Style="{StaticResource DeviceViewerActionButtonStyle}"
                                                Command="{Binding RunShellCommandCommand}"
                                                ToolTip="{DynamicResource Shared_TooltipAction}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Send"
                                                                         Style="{StaticResource DeviceViewerButtonIconStyle}"
                                                                         Margin="0,0,5,0"/>
                                                <TextBlock Text="{DynamicResource DeviceViewerSend}"
                                                           Style="{StaticResource DeviceViewerButtonTextStyle}"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                </StackPanel>

                                <StackPanel Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <materialDesign:PackIcon Kind="CellphoneSettings"
                                                                 Style="{StaticResource DeviceViewerIconStyle}"
                                                                 Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource DeviceViewerDeviceControls}"
                                                   Style="{StaticResource DeviceViewerSectionLabelStyle}"
                                                   Margin="0"/>
                                    </StackPanel>
                                    <UniformGrid Columns="2" Margin="0,6,0,0">
                                        <Button Style="{StaticResource DeviceViewerActionButtonStyle}"
                                                Command="{Binding VolumeDownCommand}"
                                                ToolTip="{DynamicResource Shared_TooltipAction}"
                                                Margin="0,0,4,6">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="VolumeMinus"
                                                                         Style="{StaticResource DeviceViewerButtonIconStyle}"
                                                                         Margin="0,0,5,0"/>
                                                <TextBlock Text="{DynamicResource DeviceViewerVolumeDown}"
                                                           Style="{StaticResource DeviceViewerButtonTextStyle}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource DeviceViewerActionButtonStyle}"
                                                Command="{Binding VolumeUpCommand}"
                                                ToolTip="{DynamicResource Shared_TooltipAction}"
                                                Margin="4,0,0,6">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="VolumePlus"
                                                                         Style="{StaticResource DeviceViewerButtonIconStyle}"
                                                                         Margin="0,0,5,0"/>
                                                <TextBlock Text="{DynamicResource DeviceViewerVolumeUp}"
                                                           Style="{StaticResource DeviceViewerButtonTextStyle}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource DeviceViewerActionButtonStyle}"
                                                Command="{Binding ScreenshotCommand}"
                                                ToolTip="{DynamicResource Shared_TooltipAction}"
                                                Margin="0,0,4,6">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Camera"
                                                                         Style="{StaticResource DeviceViewerButtonIconStyle}"
                                                                         Margin="0,0,5,0"/>
                                                <TextBlock Text="{DynamicResource DeviceViewerScreenshot}"
                                                           Style="{StaticResource DeviceViewerButtonTextStyle}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource DeviceViewerActionButtonStyle}"
                                                Command="{Binding PowerCommand}"
                                                ToolTip="{DynamicResource Shared_TooltipAction}"
                                                Margin="4,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Power"
                                                                         Style="{StaticResource DeviceViewerButtonIconStyle}"
                                                                         Margin="0,0,5,0"/>
                                                <TextBlock Text="{DynamicResource DeviceViewerPower}"
                                                           Style="{StaticResource DeviceViewerButtonTextStyle}"/>
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,1,0,0"
                    Padding="12,0">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding StreamLogText}"
                                   Style="{StaticResource DeviceViewerStatusBarTextStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
