<Window x:Class="DeepDroidChanger.Views.ChangeLocationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource ChangeLocation_WindowTitle}"
        Width="640"
        Height="660"
        MinWidth="520"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource Brush.WindowBackground}"
        TextElement.Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Metric.FontFamily}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Style="{StaticResource ChangeLocationRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- DEVICE INFO -->
        <Border Grid.Row="0"
                Style="{StaticResource ChangeLocationDeviceHeaderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Kind="CellphoneCog"
                                         Style="{StaticResource ChangeLocationHeaderIconStyle}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding DeviceInfoText}"
                           Style="{StaticResource ChangeLocationInfoDeviceTextStyle}"/>
            </Grid>
        </Border>

        <!-- MODE SELECTION -->
        <GroupBox Grid.Row="1"
                  Header="{DynamicResource ChangeLocation_ModeGroupHeader}"
                  Style="{StaticResource ChangeLocationModeGroupBoxStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <RadioButton Grid.Row="0"
                             IsChecked="{Binding IsConfigMode, Mode=TwoWay}"
                             Style="{StaticResource ChangeLocationModeRadioStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="SquareEditOutline"
                                                 Width="18" Height="18"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource Brush.Accent}"/>
                        <TextBlock Text="{DynamicResource ChangeLocation_ModeConfig}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton Grid.Row="1"
                             IsChecked="{Binding IsDeviceIpMode, Mode=TwoWay}"
                             Style="{StaticResource ChangeLocationModeRadioStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Web"
                                                 Width="18" Height="18"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource Brush.Accent}"/>
                        <TextBlock Text="{DynamicResource ChangeLocation_ModeDeviceIp}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </Grid>
        </GroupBox>

        <!-- DATA LOCATION SELECTOR (BELOW RADIO BOX & ABOVE LAT/LON) -->
        <Grid Grid.Row="2" Style="{StaticResource ChangeLocationSelectorGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search Box -->
            <TextBox Grid.Row="0"
                     Text="{Binding LocationSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ChangeLocationSearchTextBoxStyle}"
                     materialDesign:HintAssist.Hint="{DynamicResource ChangeLocation_CountrySearchHint}"
                     IsEnabled="{Binding IsConfigMode}"/>

            <!-- Country ComboBox -->
            <ComboBox x:Name="CountryComboBox"
                      Grid.Row="1"
                      ItemsSource="{Binding FilteredCountries}"
                      SelectedItem="{Binding SelectedCountry, Mode=TwoWay}"
                      IsDropDownOpen="{Binding IsCountryDropDownOpen, Mode=TwoWay}"
                      DropDownClosed="CountryComboBox_DropDownClosed"
                      Style="{StaticResource ChangeLocationComboBoxStyle}"
                      IsEnabled="{Binding IsConfigMode}"
                      MaxDropDownHeight="220">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding CountryDisplayText}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Location ComboBox -->
            <ComboBox x:Name="LocationComboBox"
                      Grid.Row="2"
                      ItemsSource="{Binding CountryLocations}"
                      SelectedItem="{Binding SelectedLocation, Mode=TwoWay}"
                      DropDownClosed="LocationComboBox_DropDownClosed"
                      Style="{StaticResource ChangeLocationComboBoxStyle}"
                      IsEnabled="{Binding IsConfigMode}"
                      MaxDropDownHeight="220">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding LocationDisplayText}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <!-- CONFIG INPUTS (LATITUDE / LONGITUDE) -->
        <Grid Grid.Row="3"
              Style="{StaticResource ChangeLocationSelectorGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{DynamicResource ChangeLocation_LatitudeLabel}"
                       Style="{StaticResource ChangeLocationInputLabelStyle}"
                       IsEnabled="{Binding IsConfigMode}"/>
            <TextBox Grid.Row="1" Grid.Column="0"
                     Text="{Binding Latitude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ChangeLocationTextBoxStyle}"
                     IsEnabled="{Binding IsConfigMode}"/>
            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="{DynamicResource ChangeLocation_LatitudeHint}"
                       Style="{StaticResource ChangeLocationHintTextStyle}"/>

            <TextBlock Grid.Row="0" Grid.Column="2"
                       Text="{DynamicResource ChangeLocation_LongitudeLabel}"
                       Style="{StaticResource ChangeLocationInputLabelStyle}"
                       IsEnabled="{Binding IsConfigMode}"/>
            <TextBox Grid.Row="1" Grid.Column="2"
                     Text="{Binding Longitude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ChangeLocationTextBoxStyle}"
                     IsEnabled="{Binding IsConfigMode}"/>
            <TextBlock Grid.Row="2" Grid.Column="2"
                       Text="{DynamicResource ChangeLocation_LongitudeHint}"
                       Style="{StaticResource ChangeLocationHintTextStyle}"/>
        </Grid>

        <!-- LOADING -->
        <ProgressBar Grid.Row="4"
                     IsIndeterminate="True"
                     Style="{StaticResource ChangeLocationProgressBarStyle}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- ACTION BUTTONS -->
        <Grid Grid.Row="5"
              Style="{StaticResource ChangeLocationActionGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource ChangeLocationSaveButtonStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Play"
                                             Style="{StaticResource ChangeLocationButtonIconStyle}"/>
                    <TextBlock Grid.Column="1"
                               Text="{DynamicResource ChangeLocation_SaveButton}"
                               Style="{StaticResource ChangeLocationButtonTextStyle}"/>
                </Grid>
            </Button>
        </Grid>
    </Grid>
</Window>
