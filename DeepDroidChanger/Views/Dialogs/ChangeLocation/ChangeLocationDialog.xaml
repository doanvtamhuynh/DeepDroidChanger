
<Window x:Class="DeepDroidChanger.Views.ChangeLocationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource ChangeLocation_WindowTitle}"
        Width="640"
        Height="660"
        MinWidth="520"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource Brush.WindowBackground}"
        TextElement.Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Metric.FontFamily}">

    <Window.Resources>

    <Style x:Key="ChangeLocationSelectorGridStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="ChangeLocationInputLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Metric.FontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="Margin" Value="0,4,0,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ChangeLocationHintTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Metric.FontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
        <Setter Property="Margin" Value="2,-2,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="ChangeLocationTextBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource FlatTextBoxStyle}">
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.SurfaceSelected}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="materialDesign:HintAssist.Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
    </Style>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Style="{StaticResource DialogRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource DialogHeaderBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Kind="CellphoneCog"
                                         Style="{StaticResource DialogHeaderIconStyle}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding DeviceInfoText}"
                           Style="{StaticResource DialogHeaderTextStyle}"/>
            </Grid>
        </Border>

        <GroupBox Grid.Row="1"
                  Header="{DynamicResource ChangeLocation_ModeGroupHeader}"
                  Style="{StaticResource DialogOptionGroupBoxStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <RadioButton Grid.Row="0"
                             IsChecked="{Binding IsConfigMode, Mode=TwoWay}"
                             ToolTip="{DynamicResource Shared_TooltipOption}"
                             Style="{StaticResource CardRadioButtonStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="SquareEditOutline"
                                                 Width="18" Height="18"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource Brush.Accent}"/>
                        <TextBlock Text="{DynamicResource ChangeLocation_ModeConfig}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton Grid.Row="1"
                             IsChecked="{Binding IsDeviceIpMode, Mode=TwoWay}"
                             ToolTip="{DynamicResource Shared_TooltipOption}"
                             Style="{StaticResource CardRadioButtonStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Web"
                                                 Width="18" Height="18"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource Brush.Accent}"/>
                        <TextBlock Text="{DynamicResource ChangeLocation_ModeDeviceIp}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="2" Style="{StaticResource ChangeLocationSelectorGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0"
                     Text="{Binding LocationSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{DynamicResource Shared_TooltipSearch}"
                     Style="{StaticResource DialogSearchTextBoxStyle}"
                     materialDesign:HintAssist.Hint="{DynamicResource ChangeLocation_CountrySearchHint}"
                     IsEnabled="{Binding IsConfigMode}"/>

            <ComboBox x:Name="CountryComboBox"
                      Grid.Row="1"
                      ItemsSource="{Binding FilteredCountries}"
                      SelectedItem="{Binding SelectedCountry, Mode=TwoWay}"
                      ToolTip="{DynamicResource Shared_TooltipSelection}"
                      IsDropDownOpen="{Binding IsCountryDropDownOpen, Mode=TwoWay}"
                      DropDownClosed="CountryComboBox_DropDownClosed"
                      Style="{StaticResource DialogFormComboBoxStyle}"
                      IsEnabled="{Binding IsConfigMode}"
                      MaxDropDownHeight="220">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding CountryDisplayText}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <ComboBox x:Name="LocationComboBox"
                      Grid.Row="2"
                      ItemsSource="{Binding CountryLocations}"
                      SelectedItem="{Binding SelectedLocation, Mode=TwoWay}"
                      ToolTip="{DynamicResource Shared_TooltipSelection}"
                      DropDownClosed="LocationComboBox_DropDownClosed"
                      Style="{StaticResource DialogFormComboBoxStyle}"
                      IsEnabled="{Binding IsConfigMode}"
                      MaxDropDownHeight="220">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding LocationDisplayText}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="3"
              Visibility="{Binding IsSingleMode, Converter={StaticResource BooleanToVisibilityConverter}}"
              Style="{StaticResource ChangeLocationSelectorGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{DynamicResource ChangeLocation_LatitudeLabel}"
                       Style="{StaticResource ChangeLocationInputLabelStyle}"
                       IsEnabled="{Binding IsConfigMode}"/>
            <TextBox Grid.Row="1" Grid.Column="0"
                     Text="{Binding Latitude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{DynamicResource Shared_TooltipTextInput}"
                     Style="{StaticResource ChangeLocationTextBoxStyle}"
                     IsEnabled="{Binding IsConfigMode}"/>
            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="{DynamicResource ChangeLocation_LatitudeHint}"
                       Style="{StaticResource ChangeLocationHintTextStyle}"/>

            <TextBlock Grid.Row="0" Grid.Column="2"
                       Text="{DynamicResource ChangeLocation_LongitudeLabel}"
                       Style="{StaticResource ChangeLocationInputLabelStyle}"
                       IsEnabled="{Binding IsConfigMode}"/>
            <TextBox Grid.Row="1" Grid.Column="2"
                     Text="{Binding Longitude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{DynamicResource Shared_TooltipTextInput}"
                     Style="{StaticResource ChangeLocationTextBoxStyle}"
                     IsEnabled="{Binding IsConfigMode}"/>
            <TextBlock Grid.Row="2" Grid.Column="2"
                       Text="{DynamicResource ChangeLocation_LongitudeHint}"
                       Style="{StaticResource ChangeLocationHintTextStyle}"/>
        </Grid>

        <ProgressBar Grid.Row="4"
                     IsIndeterminate="True"
                     Style="{StaticResource DialogLinearProgressBarStyle}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <Grid Grid.Row="5"
              Style="{StaticResource DialogActionGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Command="{Binding SaveCommand}"
                    ToolTip="{DynamicResource Shared_TooltipAction}"
                    Style="{StaticResource DialogPrimaryButtonStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Play"
                                             Style="{StaticResource PrimaryButtonIconStyle}"/>
                    <TextBlock Grid.Column="1"
                               Text="{DynamicResource ChangeLocation_SaveButton}"
                               Style="{StaticResource PrimaryButtonTextStyle}"/>
                </Grid>
            </Button>
        </Grid>
    </Grid>
</Window>
