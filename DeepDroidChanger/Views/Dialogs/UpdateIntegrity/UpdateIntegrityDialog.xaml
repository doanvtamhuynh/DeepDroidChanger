
<Window x:Class="DeepDroidChanger.Views.UpdateIntegrityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource UpdateIntegrity_WindowTitle}"
        Width="680"
        Height="680"
        MinWidth="600"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource Brush.WindowBackground}"
        TextElement.Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Metric.FontFamily}">

    <Window.Resources>

        <Style x:Key="UpdateIntegritySectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="UpdateIntegrityCheckBoxStyle"
               TargetType="CheckBox"
               BasedOn="{StaticResource FlatCheckBoxStyle}">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="UpdateIntegritySelectorGridStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource Brush.SurfacePressed}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="UpdateIntegrityTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource FlatTextBoxStyle}">
            <Setter Property="SelectionBrush" Value="{DynamicResource Brush.SurfaceSelected}"/>
            <Setter Property="MinWidth" Value="260"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="materialDesign:HintAssist.Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
        </Style>

        <Style x:Key="UpdateIntegrityBrowseButtonStyle" TargetType="Button"
               BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="{StaticResource Metric.ControlHeight.Comfortable}"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Margin" Value="4,0,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="UpdateIntegrityBrowseIconStyle" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="UpdateIntegrityBrowseButtonTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Metric.FontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="UpdateIntegrityClearButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DialogPrimaryButtonStyle}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="116"/>
            <Setter Property="Padding" Value="16,0,16,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Grid Style="{StaticResource DialogRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource DialogHeaderBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Kind="CellphoneCog"
                                         Style="{StaticResource DialogHeaderIconStyle}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding DeviceInfoText}"
                           Style="{StaticResource DialogHeaderTextStyle}"/>
            </Grid>
        </Border>

        <GroupBox Grid.Row="1"
                  Header="{DynamicResource UpdateIntegrity_SourceGroupHeader}"
                  Style="{StaticResource DialogOptionGroupBoxStyle}">
            <CheckBox Content="{DynamicResource UpdateIntegrity_SourceServer}"
                      IsChecked="{Binding UpdateIntegrityFromServer, Mode=TwoWay}"
                      ToolTip="{DynamicResource Shared_TooltipOption}"
                      Style="{StaticResource UpdateIntegrityCheckBoxStyle}"/>
        </GroupBox>

        <GroupBox Grid.Row="2"
                  Header="{DynamicResource UpdateIntegrity_TargetGroupHeader}"
                  Style="{StaticResource DialogOptionGroupBoxStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Row="0"
                          Grid.Column="0"
                          Content="{DynamicResource UpdateIntegrity_TargetIntegrity}"
                          IsChecked="{Binding UpdateIntegrityEnabled, Mode=TwoWay}"
                          ToolTip="{DynamicResource Shared_TooltipOption}"
                          Style="{StaticResource UpdateIntegrityCheckBoxStyle}"/>
                <CheckBox Grid.Row="0"
                          Grid.Column="1"
                          Content="{DynamicResource UpdateIntegrity_FakeDroidGuardSdk}"
                          IsChecked="{Binding FakeDroidGuardSdkEnabled, Mode=TwoWay}"
                          IsEnabled="{Binding UpdateIntegrityEnabled}"
                          ToolTip="{DynamicResource Shared_TooltipOption}"
                          Style="{StaticResource UpdateIntegrityCheckBoxStyle}"
                          Margin="16,4,0,4"/>
                <CheckBox Grid.Row="1"
                          Grid.Column="0"
                          Content="{DynamicResource UpdateIntegrity_TargetKeybox}"
                          IsChecked="{Binding UpdateKeyboxEnabled, Mode=TwoWay}"
                          ToolTip="{DynamicResource Shared_TooltipOption}"
                          Style="{StaticResource UpdateIntegrityCheckBoxStyle}"/>
            </Grid>
        </GroupBox>

        <Border Grid.Row="3"
                Style="{StaticResource UpdateIntegritySectionBorderStyle}">
            <StackPanel>
                <Grid Style="{StaticResource UpdateIntegritySelectorGridStyle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0"
                               Grid.ColumnSpan="2"
                               Text="{DynamicResource UpdateIntegrity_IntegrityFileLabel}"
                               Style="{StaticResource DialogInputLabelStyle}"/>

                    <TextBox Grid.Row="1" Grid.Column="0"
                             Text="{Binding UpdateIntegrityFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{DynamicResource Shared_TooltipTextInput}"
                             Style="{StaticResource UpdateIntegrityTextBoxStyle}"
                             IsEnabled="{Binding IsIntegrityFilePickerEnabled}"/>
                    <Button Grid.Row="1" Grid.Column="1"
                            Command="{Binding BrowseIntegrityFileCommand}"
                            ToolTip="{DynamicResource Shared_TooltipBrowseFile}"
                            Style="{StaticResource UpdateIntegrityBrowseButtonStyle}"
                            IsEnabled="{Binding IsIntegrityFilePickerEnabled}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderOpenOutline"
                                                     Style="{StaticResource UpdateIntegrityBrowseIconStyle}"/>
                            <TextBlock Text="{DynamicResource UpdateIntegrity_BrowseButton}"
                                       Style="{StaticResource UpdateIntegrityBrowseButtonTextStyle}"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Style="{StaticResource UpdateIntegritySelectorGridStyle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.ColumnSpan="2"
                               Text="{DynamicResource UpdateIntegrity_KeyboxFileLabel}"
                               Style="{StaticResource DialogInputLabelStyle}"/>
                    <TextBox Grid.Row="1" Grid.Column="0"
                             Text="{Binding UpdateKeyboxFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{DynamicResource Shared_TooltipTextInput}"
                             Style="{StaticResource UpdateIntegrityTextBoxStyle}"
                             IsEnabled="{Binding IsKeyboxFilePickerEnabled}"/>
                    <Button Grid.Row="1" Grid.Column="1"
                            Command="{Binding BrowseKeyboxFileCommand}"
                            ToolTip="{DynamicResource Shared_TooltipBrowseFile}"
                            Style="{StaticResource UpdateIntegrityBrowseButtonStyle}"
                            IsEnabled="{Binding IsKeyboxFilePickerEnabled}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderOpenOutline"
                                                     Style="{StaticResource UpdateIntegrityBrowseIconStyle}"/>
                            <TextBlock Text="{DynamicResource UpdateIntegrity_BrowseButton}"
                                       Style="{StaticResource UpdateIntegrityBrowseButtonTextStyle}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4"
              Style="{StaticResource DialogActionGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Command="{Binding ClearIntegrityCommand}"
                        ToolTip="{DynamicResource Shared_TooltipAction}"
                        Style="{StaticResource UpdateIntegrityClearButtonStyle}">
                    <TextBlock Text="{DynamicResource UpdateIntegrity_ClearIntegrityButton}"
                               Style="{StaticResource PrimaryButtonTextStyle}"/>
                </Button>
                <Button Command="{Binding ClearKeyboxCommand}"
                        ToolTip="{DynamicResource Shared_TooltipAction}"
                        Style="{StaticResource UpdateIntegrityClearButtonStyle}">
                    <TextBlock Text="{DynamicResource UpdateIntegrity_ClearKeyboxButton}"
                               Style="{StaticResource PrimaryButtonTextStyle}"/>
                </Button>
                <Button Command="{Binding UpdateCommand}"
                        ToolTip="{DynamicResource Shared_TooltipAction}"
                        Style="{StaticResource DialogPrimaryButtonStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Play"
                                                 Style="{StaticResource PrimaryButtonIconStyle}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{DynamicResource UpdateIntegrity_UpdateButton}"
                                   Style="{StaticResource PrimaryButtonTextStyle}"/>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
