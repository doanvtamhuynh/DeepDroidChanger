
<Window x:Class="DeepDroidChanger.Views.ChangeTimezoneDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource ChangeTimezone_WindowTitle}"
        Width="620"
        Height="540"
        MinWidth="520"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource Brush.WindowBackground}"
        TextElement.Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Metric.FontFamily}">

    <Window.Resources>

    <Style x:Key="ChangeTimezoneSelectorGridStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="ChangeTimezoneComboBoxStyle"
           TargetType="ComboBox"
           BasedOn="{StaticResource FlatComboBoxStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem"
                       BasedOn="{StaticResource FlatComboBoxItemStyle}">
                    <Setter Property="Padding" Value="10,6"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Style="{StaticResource DialogRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource DialogHeaderBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Kind="CellphoneCog"

                                         Style="{StaticResource DialogHeaderIconStyle}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding DeviceInfoText}"
                           Style="{StaticResource DialogHeaderTextStyle}"/>
            </Grid>
        </Border>

        <GroupBox Grid.Row="1"
                  Header="{DynamicResource ChangeTimezone_ModeGroupHeader}"
                  Style="{StaticResource DialogOptionGroupBoxStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <RadioButton Grid.Row="0"
                             IsChecked="{Binding IsDataMode, Mode=TwoWay}"
                             ToolTip="{DynamicResource Shared_TooltipOption}"
                             Style="{StaticResource CardRadioButtonStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ClockOutline"
                                                 Width="18" Height="18"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource Brush.Accent}"/>
                        <TextBlock Text="{DynamicResource ChangeTimezone_ModeData}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton Grid.Row="1"
                             IsChecked="{Binding IsDeviceIpMode, Mode=TwoWay}"
                             ToolTip="{DynamicResource Shared_TooltipOption}"
                             Style="{StaticResource CardRadioButtonStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Web"
                                                 Width="18" Height="18"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource Brush.Accent}"/>
                        <TextBlock Text="{DynamicResource ChangeTimezone_ModeDeviceIp}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="2" Style="{StaticResource ChangeTimezoneSelectorGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0"
                     Text="{Binding TimezoneSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{DynamicResource Shared_TooltipSearch}"
                     Style="{StaticResource DialogSearchTextBoxStyle}"
                     materialDesign:HintAssist.Hint="{DynamicResource ChangeTimezone_SearchHint}"
                     IsEnabled="{Binding IsDataMode}"/>

            <ComboBox x:Name="CountryComboBox"
                      Grid.Row="1"
                      ItemsSource="{Binding FilteredCountries}"
                      SelectedItem="{Binding SelectedCountry, Mode=TwoWay}"
                      ToolTip="{DynamicResource Shared_TooltipSelection}"
                      IsDropDownOpen="{Binding IsCountryDropDownOpen, Mode=TwoWay}"
                      Style="{StaticResource ChangeTimezoneComboBoxStyle}"
                      IsEnabled="{Binding IsDataMode}"
                      MaxDropDownHeight="220">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding CountryDisplayText}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <ComboBox x:Name="TimezoneComboBox"
                      Grid.Row="2"
                      ItemsSource="{Binding CountryTimezones}"
                      SelectedItem="{Binding SelectedTimezone, Mode=TwoWay}"
                      ToolTip="{DynamicResource Shared_TooltipSelection}"
                      Style="{StaticResource ChangeTimezoneComboBoxStyle}"
                      IsEnabled="{Binding IsDataMode}"
                      MaxDropDownHeight="220">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding TimezoneDisplayText}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <ProgressBar Grid.Row="3"
                     IsIndeterminate="True"
                     Style="{StaticResource DialogLinearProgressBarStyle}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <Grid Grid.Row="4"
              Style="{StaticResource DialogActionGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Command="{Binding SaveCommand}"
                    ToolTip="{DynamicResource Shared_TooltipAction}"
                    Style="{StaticResource DialogPrimaryButtonStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Play"
                                             Style="{StaticResource PrimaryButtonIconStyle}"/>
                    <TextBlock Grid.Column="1"
                               Text="{DynamicResource ChangeTimezone_SaveButton}"
                               Style="{StaticResource PrimaryButtonTextStyle}"/>
                </Grid>
            </Button>
        </Grid>
    </Grid>
</Window>
