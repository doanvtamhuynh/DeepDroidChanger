<Window x:Class="DeepDroidChanger.Views.ChangeTimezoneDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource ChangeTimezone_WindowTitle}"
        Width="620"
        Height="540"
        MinWidth="520"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource Brush.WindowBackground}"
        TextElement.Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Metric.FontFamily}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Style="{StaticResource ChangeTimezoneRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- DEVICE INFO -->
        <Border Grid.Row="0"
                Style="{StaticResource ChangeTimezoneDeviceHeaderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Kind="CellphoneCog"
                                         Style="{StaticResource ChangeTimezoneHeaderIconStyle}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding DeviceInfoText}"
                           Style="{StaticResource ChangeTimezoneInfoDeviceTextStyle}"/>
            </Grid>
        </Border>

        <!-- MODE SELECTION -->
        <GroupBox Grid.Row="1"
                  Header="{DynamicResource ChangeTimezone_ModeGroupHeader}"
                  Style="{StaticResource ChangeTimezoneModeGroupBoxStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <RadioButton Grid.Row="0"
                             IsChecked="{Binding IsDataMode, Mode=TwoWay}"
                             Style="{StaticResource ChangeTimezoneModeRadioStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ClockOutline"
                                                 Width="18" Height="18"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource Brush.Accent}"/>
                        <TextBlock Text="{DynamicResource ChangeTimezone_ModeData}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton Grid.Row="1"
                             IsChecked="{Binding IsDeviceIpMode, Mode=TwoWay}"
                             Style="{StaticResource ChangeTimezoneModeRadioStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Web"
                                                 Width="18" Height="18"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource Brush.Accent}"/>
                        <TextBlock Text="{DynamicResource ChangeTimezone_ModeDeviceIp}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </Grid>
        </GroupBox>

        <!-- TIMEZONE SELECTOR -->
        <Grid Grid.Row="2" Style="{StaticResource ChangeTimezoneSelectorGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search Box -->
            <TextBox Grid.Row="0"
                     Text="{Binding TimezoneSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ChangeTimezoneSearchTextBoxStyle}"
                     materialDesign:HintAssist.Hint="{DynamicResource ChangeTimezone_SearchHint}"
                     IsEnabled="{Binding IsDataMode}"/>

            <!-- Country ComboBox (Dropbox 1) -->
            <ComboBox x:Name="CountryComboBox"
                      Grid.Row="1"
                      ItemsSource="{Binding FilteredCountries}"
                      SelectedItem="{Binding SelectedCountry, Mode=TwoWay}"
                      IsDropDownOpen="{Binding IsCountryDropDownOpen, Mode=TwoWay}"
                      Style="{StaticResource ChangeTimezoneComboBoxStyle}"
                      IsEnabled="{Binding IsDataMode}"
                      MaxDropDownHeight="220">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding CountryDisplayText}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Timezone ComboBox (Dropbox 2) -->
            <ComboBox x:Name="TimezoneComboBox"
                      Grid.Row="2"
                      ItemsSource="{Binding CountryTimezones}"
                      SelectedItem="{Binding SelectedTimezone, Mode=TwoWay}"
                      Style="{StaticResource ChangeTimezoneComboBoxStyle}"
                      IsEnabled="{Binding IsDataMode}"
                      MaxDropDownHeight="220">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding TimezoneDisplayText}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <!-- LOADING -->
        <ProgressBar Grid.Row="3"
                     IsIndeterminate="True"
                     Style="{StaticResource ChangeTimezoneProgressBarStyle}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- ACTION BUTTONS -->
        <Grid Grid.Row="4"
              Style="{StaticResource ChangeTimezoneActionGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource ChangeTimezoneSaveButtonStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Play"
                                             Style="{StaticResource ChangeTimezoneButtonIconStyle}"/>
                    <TextBlock Grid.Column="1"
                               Text="{DynamicResource ChangeTimezone_SaveButton}"
                               Style="{StaticResource ChangeTimezoneButtonTextStyle}"/>
                </Grid>
            </Button>
        </Grid>
    </Grid>
</Window>
