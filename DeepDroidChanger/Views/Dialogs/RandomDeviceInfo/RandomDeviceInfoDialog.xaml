
<Window x:Class="DeepDroidChanger.Views.RandomDeviceInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource RandomDeviceInfo_WindowTitle}"
        Width="860"
        Height="700"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.WindowBackground}"
        TextElement.Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Metric.FontFamily}">

    <Window.Resources>

        <Style x:Key="RandomDeviceInfoHeaderGridStyle"
               TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="RandomDeviceInfoHeaderIconStyle"
               TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="RandomDeviceInfoTitleTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource AppTitleTextStyle}">
            <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Title}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="RandomDeviceInfoDescriptionTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource SecondaryTextStyle}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="RandomDeviceInfoFieldCardStyle"
               TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="{StaticResource Metric.BorderThickness.Uniform}"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}"/>
            <Setter Property="Padding" Value="{StaticResource Spacing.CardPadding.Compact}"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>

        <Style x:Key="RandomDeviceInfoFieldTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource AppLabelTextStyle}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="RandomDeviceInfoInputStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource FlatTextBoxStyle}">
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="MinHeight" Value="{StaticResource Metric.ControlHeight}"/>
            <Setter Property="Padding" Value="{StaticResource Spacing.InputPadding}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>

        <Style x:Key="RandomDeviceInfoActionGridStyle"
               TargetType="Grid">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>

        <Style x:Key="RandomDeviceInfoUpdateButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource MaterialPrimaryButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Height" Value="{StaticResource Metric.ControlHeight}"/>
            <Setter Property="Padding" Value="{StaticResource Spacing.ButtonPadding}"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="{StaticResource Radius.Medium}"/>
            <Setter Property="materialDesign:RippleAssist.Feedback"
                    Value="{DynamicResource Brush.AccentForeground}"/>
            <Setter Property="materialDesign:RippleAssist.RippleOnTop" Value="True"/>
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>
    <Grid Style="{StaticResource PageRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Style="{StaticResource RandomDeviceInfoHeaderGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <materialDesign:PackIcon Kind="CellphoneInformation"
                                     Style="{StaticResource RandomDeviceInfoHeaderIconStyle}"/>
            <TextBlock Grid.Column="1"
                       Text="{DynamicResource RandomDeviceInfo_Title}"
                       Style="{StaticResource RandomDeviceInfoTitleTextStyle}"/>
        </Grid>

        <TextBlock Grid.Row="1"
                   Text="{DynamicResource RandomDeviceInfo_Description}"
                   Style="{StaticResource RandomDeviceInfoDescriptionTextStyle}"/>

        <ScrollViewer x:Name="RandomDeviceInfoScrollViewer"
                      Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="RandomDeviceInfoFields"
                          ItemsSource="{Binding Fields}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource RandomDeviceInfoFieldCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Label}"
                                           Style="{StaticResource RandomDeviceInfoFieldTextStyle}"/>
                                <TextBox Grid.Row="1"
                                         Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource RandomDeviceInfoInputStyle}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="3"
              Style="{StaticResource RandomDeviceInfoActionGridStyle}">
            <Button x:Name="UpdateRandomDeviceInfoButton"
                    Command="{Binding UpdateCommand}"
                    Style="{StaticResource RandomDeviceInfoUpdateButtonStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon x:Name="UpdateRandomDeviceInfoIcon"
                                             Kind="Play"
                                             Style="{StaticResource PrimaryButtonIconStyle}"/>
                    <TextBlock x:Name="UpdateRandomDeviceInfoText"
                               Grid.Column="1"
                               Text="{DynamicResource RandomDeviceInfo_UpdateButton}"
                               Style="{StaticResource PrimaryButtonTextStyle}"/>
                </Grid>
            </Button>
        </Grid>
    </Grid>
</Window>
