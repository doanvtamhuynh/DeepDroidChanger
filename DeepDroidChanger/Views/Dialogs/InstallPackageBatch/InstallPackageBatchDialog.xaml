<Window x:Class="DeepDroidChanger.Views.InstallPackageBatchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource InstallPackage_WindowTitle}"
        Width="780"
        Height="660"
        MinWidth="680"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource Brush.WindowBackground}"
        TextElement.Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Metric.FontFamily}">

    <Window.Resources>
        <Style x:Key="InstallPackageHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Metric.FontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="InstallPackageCheckBoxStyle"
               TargetType="CheckBox"
               BasedOn="{StaticResource FlatCheckBoxStyle}">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="InstallPackageOptionsStackStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Vertical"/>
        </Style>

        <Style x:Key="InstallPackageOptionHelpTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Metric.FontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="InstallPackageOptionRowStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="InstallPackageGridStyle"
               TargetType="DataGrid"
               BasedOn="{StaticResource FlatDataGridStyle}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource DeviceTableColumnHeaderStyle}"/>
            <Setter Property="CellStyle" Value="{StaticResource DeviceTableCellStyle}"/>
            <Setter Property="RowStyle" Value="{StaticResource DeviceTableRowStyle}"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="InstallPackageCellTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Metric.FontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="12,0"/>
        </Style>

        <Style x:Key="InstallPackageActionWrapPanelStyle" TargetType="WrapPanel">
            <Setter Property="Margin" Value="0,14,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="InstallPackageButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style x:Key="InstallPackagePrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource MaterialPrimaryButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
            <Setter Property="Height" Value="{StaticResource Metric.ControlHeight.Comfortable}"/>
            <Setter Property="MinWidth" Value="128"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius"
                    Value="{StaticResource Radius.Medium}"/>
            <Setter Property="materialDesign:RippleAssist.Feedback"
                    Value="{DynamicResource Brush.AccentForeground}"/>
            <Setter Property="materialDesign:RippleAssist.RippleOnTop" Value="True"/>
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="InstallPackageButtonIconStyle" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="InstallPackageButtonTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Metric.FontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Resources>

    <Grid Style="{StaticResource DialogRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource DialogHeaderBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Kind="CellphoneCog"
                                         Style="{StaticResource DialogHeaderIconStyle}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding DeviceInfoText}"
                           Style="{StaticResource InstallPackageHeaderTextStyle}"/>
            </Grid>
        </Border>

        <GroupBox Grid.Row="1"
                  Header="{DynamicResource InstallPackage_OptionsHeader}"
                  Style="{StaticResource DialogOptionGroupBoxStyle}">
            <StackPanel Style="{StaticResource InstallPackageOptionsStackStyle}">
                <TextBlock Text="{DynamicResource InstallPackage_OptionsHelp}"
                           Style="{StaticResource InstallPackageOptionHelpTextStyle}"/>
                <Border Style="{StaticResource InstallPackageOptionRowStyle}">
                    <StackPanel Style="{StaticResource InstallPackageOptionsStackStyle}">
                        <CheckBox Content="{DynamicResource InstallPackage_GrantPermissions}"
                                  IsChecked="{Binding GrantPermissions, Mode=TwoWay}"
                                  ToolTip="{DynamicResource Shared_TooltipOption}"
                                  Style="{StaticResource InstallPackageCheckBoxStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource InstallPackageOptionRowStyle}">
                    <StackPanel Style="{StaticResource InstallPackageOptionsStackStyle}">
                        <CheckBox Content="{DynamicResource InstallPackage_AllowDowngrade}"
                                  IsChecked="{Binding AllowDowngrade, Mode=TwoWay}"
                                  ToolTip="{DynamicResource Shared_TooltipOption}"
                                  Style="{StaticResource InstallPackageCheckBoxStyle}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </GroupBox>

        <DataGrid x:Name="InstallPackageBatchGrid"
                  Grid.Row="2"
                  ItemsSource="{Binding Packages}"
                  SelectedItem="{Binding SelectedPackage, Mode=TwoWay}"
                  Style="{StaticResource InstallPackageGridStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding FileName}"
                                    Width="*"
                                    MinWidth="260"
                                    ElementStyle="{StaticResource InstallPackageCellTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource InstallPackage_ColumnFile}"
                                   Style="{StaticResource DataGridColumnHeaderTextStyle}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <WrapPanel Grid.Row="3"
                   Style="{StaticResource InstallPackageActionWrapPanelStyle}">
            <Button Command="{Binding AddFilesCommand}"
                    ToolTip="{DynamicResource Shared_TooltipAction}"
                    Style="{StaticResource InstallPackageButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus"
                                             Style="{StaticResource InstallPackageButtonIconStyle}"/>
                    <TextBlock Text="{DynamicResource InstallPackage_AddFiles}"
                               Style="{StaticResource InstallPackageButtonTextStyle}"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding RemoveSelectedPackageCommand}"
                    ToolTip="{DynamicResource Shared_TooltipAction}"
                    Style="{StaticResource InstallPackageButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Delete"
                                             Style="{StaticResource InstallPackageButtonIconStyle}"/>
                    <TextBlock Text="{DynamicResource InstallPackage_Remove}"
                               Style="{StaticResource InstallPackageButtonTextStyle}"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding StartInstallCommand}"
                    ToolTip="{DynamicResource Shared_TooltipAction}"
                    Style="{StaticResource InstallPackagePrimaryButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Play"
                                             Style="{StaticResource InstallPackageButtonIconStyle}"/>
                    <TextBlock Text="{DynamicResource InstallPackage_Start}"
                               Style="{StaticResource InstallPackageButtonTextStyle}"/>
                </StackPanel>
            </Button>
        </WrapPanel>
    </Grid>
</Window>
