
<Window x:Class="DeepDroidChanger.Views.AddDevicesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource AddDevices_WindowTitle}"
        Width="920"
        Height="580"
        MinWidth="720"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource Brush.WindowBackground}"
        TextElement.Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Metric.FontFamily}">

    <Window.Resources>

    <Style x:Key="AddDevicesHeaderGridStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <Style x:Key="AddDevicesSelectAllCheckBoxStyle"
           TargetType="CheckBox"
           BasedOn="{StaticResource FormCheckBoxStyle}">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="AddDevicesSelectAllContainerStyle"
           TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Metric.BorderThickness.Uniform}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}"/>
        <Setter Property="Height" Value="{StaticResource Metric.ControlHeight.Comfortable}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.ButtonPadding}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="AddDevicesGridStyle"
           TargetType="DataGrid"
           BasedOn="{StaticResource MaterialDesignDataGrid}">
        <Setter Property="materialDesign:DataGridAssist.ApplyMaterialDesignColumnStyles" Value="False"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="CanUserSortColumns" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="IsReadOnly" Value="False"/>
        <Setter Property="RowHeight" Value="{StaticResource Metric.DataGridEditorRowHeight}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="AlternationCount" Value="2"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ColumnHeaderStyle"
                Value="{StaticResource DeviceTableColumnHeaderStyle}"/>
        <Setter Property="RowStyle" Value="{StaticResource DeviceTableRowStyle}"/>
        <Setter Property="CellStyle" Value="{StaticResource DeviceTableCellStyle}"/>
    </Style>

    <Style x:Key="AddDevicesCellStretchStyle"
           TargetType="DataGridCell"
           BasedOn="{StaticResource DeviceTableCellStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment"   Value="Stretch"/>
        <Setter Property="Padding"                    Value="2,4,2,4"/>
    </Style>

    <Style x:Key="AddDevicesSelectionButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style x:Key="AddDevicesActionGridStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0,14,0,0"/>
    </Style>

    <Style x:Key="AddDevicesActionButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource MaterialPrimaryButtonStyle}">
        <Setter Property="Background"
                Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="16,0,16,0"/>
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="{StaticResource Radius.Medium}"/>
        <Setter Property="materialDesign:RippleAssist.Feedback" Value="{DynamicResource Brush.AccentForeground}"/>
        <Setter Property="materialDesign:RippleAssist.RippleOnTop" Value="True"/>
        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2"/>
    </Style>
    </Window.Resources>
    <Grid Style="{StaticResource DialogRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Style="{StaticResource AddDevicesHeaderGridStyle}">
            <Border x:Name="AddDevicesSelectAllDevicesContainer"
                    HorizontalAlignment="Right"
                    Style="{StaticResource AddDevicesSelectAllContainerStyle}">
                <CheckBox x:Name="AddDevicesSelectAllDevicesCheckBox"
                          Content="{DynamicResource AddDevices_SelectAll}"
                          IsChecked="{Binding SelectAll, Mode=TwoWay}"
                          Style="{StaticResource AddDevicesSelectAllCheckBoxStyle}"/>
            </Border>
        </Grid>

        <DataGrid x:Name="AddDevicesGrid"
                  Grid.Row="1"
                  ItemsSource="{Binding Devices}"
                  Style="{StaticResource AddDevicesGridStyle}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="0.75*"
                                        MinWidth="100"
                                        CellStyle="{StaticResource AddDevicesCellStretchStyle}">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{DynamicResource AddDevices_ColumnSelectDevice}"
                                   Style="{StaticResource DataGridColumnHeaderTextStyle}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.ToggleDeviceSelectionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="{DynamicResource AddDevices_ColumnSelectDevice}"
                                    Style="{StaticResource AddDevicesSelectionButtonStyle}">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}"
                                          IsHitTestVisible="False"
                                          Focusable="False"
                                          Style="{StaticResource DataGridCheckBoxStyle}"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Binding="{Binding Serial}"
                                    Width="1.25*"
                                    MinWidth="150"
                                    IsReadOnly="True"
                                    ElementStyle="{StaticResource DataGridLeftCellTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource AddDevices_ColumnSerial}"
                                   Style="{StaticResource DataGridColumnHeaderTextStyle}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTemplateColumn Width="1*"
                                        MinWidth="130"
                                        CellStyle="{StaticResource AddDevicesCellStretchStyle}">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{DynamicResource AddDevices_ColumnType}"
                                   Style="{StaticResource DataGridColumnHeaderTextStyle}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.TypeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource InlineDataGridComboBoxStyle}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="1.35*"
                                        MinWidth="170"
                                        CellStyle="{StaticResource AddDevicesCellStretchStyle}">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{DynamicResource AddDevices_ColumnName}"
                                   Style="{StaticResource DataGridColumnHeaderTextStyle}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InlineDataGridTextBoxStyle}"
                                     materialDesign:HintAssist.Hint="{DynamicResource Shared_DeviceNameHint}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2"
              Style="{StaticResource AddDevicesActionGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Command="{Binding AddCommand}"
                    Style="{StaticResource AddDevicesActionButtonStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Plus"
                                             Style="{StaticResource PrimaryButtonIconStyle}"/>
                    <TextBlock Grid.Column="1"
                               Text="{DynamicResource AddDevices_AddButton}"
                               Style="{StaticResource PrimaryButtonTextStyle}"/>
                </Grid>
            </Button>
        </Grid>
    </Grid>
</Window>
