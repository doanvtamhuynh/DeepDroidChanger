<Window x:Class="DeepDroidChanger.Views.LoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource Login_WindowTitle}"
        Width="640"
        Height="580"
        MinWidth="640"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.WindowBackground}"
        TextElement.Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Metric.FontFamily}">

    <Window.Resources>

        <Style x:Key="LoginRootGridStyle" TargetType="Grid">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="LoginCardBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="460"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="32"/>
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="{StaticResource Metric.BorderThickness.Uniform}"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="{StaticResource Metric.Elevation.DialogBlurRadius}"
                                      ShadowDepth="{StaticResource Metric.Elevation.DialogShadowDepth}"
                                      Direction="270"
                                      Opacity="{StaticResource Metric.Elevation.DialogShadowOpacity}"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginLockIconCircleStyle" TargetType="Border">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Circle}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSelected}"/>
        </Style>

        <Style x:Key="LoginLockIconStyle" TargetType="Control">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
        </Style>

        <Style x:Key="LoginTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Display}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="LoginSubtitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="LoginFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        </Style>

        <Style x:Key="LoginInputHostGridStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <Style x:Key="LoginTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="{StaticResource Metric.ControlHeight.Comfortable}"/>
            <Setter Property="Padding" Value="38,8,12,8"/>
            <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
            <Setter Property="FontFamily" Value="{StaticResource Metric.FontFamily}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Brush.SurfaceSelected}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="LoginInputBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource Radius.Medium}">
                                <Grid>

                                    <TextBlock x:Name="PlaceholderText"
                                               Text="{TemplateBinding Tag}"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               Opacity="0.6"
                                               Margin="{TemplateBinding Padding}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="Collapsed"/>
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="LoginInputBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LoginInputBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="LoginInputBorder" Property="Background" Value="{DynamicResource Brush.SurfacePressed}"/>
                                <Setter TargetName="LoginInputBorder" Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="{StaticResource Metric.ControlHeight.Comfortable}"/>
            <Setter Property="Padding" Value="38,8,38,8"/>
            <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
            <Setter Property="FontFamily" Value="{StaticResource Metric.FontFamily}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Brush.SurfaceSelected}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Grid>
                            <Border x:Name="LoginPasswordBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource Radius.Medium}">
                                <Grid>

                                    <TextBlock x:Name="PlaceholderText"
                                               Text="{TemplateBinding Tag}"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               Opacity="0.6"
                                               Margin="38,8,38,8"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="Collapsed"/>
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="LoginPasswordBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LoginPasswordBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="LoginPasswordBorder" Property="Background" Value="{DynamicResource Brush.SurfacePressed}"/>
                                <Setter TargetName="LoginPasswordBorder" Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginPasswordTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource LoginTextBoxStyle}">
            <Setter Property="Padding" Value="38,8,38,8"/>
        </Style>

        <Style x:Key="LoginInputLeadingIconStyle" TargetType="Control">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="LoginPasswordRevealButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginPasswordRevealIconStyle" TargetType="Control">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        </Style>

        <Style x:Key="LoginCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource FlatCheckBoxStyle}">
            <Setter Property="Margin" Value="0,0,0,24"/>
            <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="LoginErrorTextStyle" TargetType="TextBlock">
            <Setter Property="MinHeight" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="LoginPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="{StaticResource Metric.ControlHeight.Comfortable}"/>
            <Setter Property="Padding" Value="{StaticResource Spacing.ButtonPadding}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
            <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Medium}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                               Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Brush.AccentHover}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Brush.AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Brush.AccentPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Brush.SurfacePressed}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginButtonContentGridStyle" TargetType="Grid">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LoginButtonIconStyle" TargetType="Control">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LoginButtonTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LoginLoadingOverlayGridStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoggingIn}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LoginLoadingBackdropStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}"/>
        </Style>

        <Style x:Key="LoginLoadingPanelStyle" TargetType="StackPanel">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LoginLoadingProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="IsIndeterminate" Value="True"/>
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="4"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
        </Style>

        <Style x:Key="LoginLoadingTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Small}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        </Style>

        <Storyboard x:Key="LoginCardEntranceStoryboard">
            <DoubleAnimation Storyboard.TargetName="LoginCard"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="LoginCardTranslate"
                             Storyboard.TargetProperty="Y"
                             From="24" To="0"
                             Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource LoginCardEntranceStoryboard}"/>
        </EventTrigger>
    </Window.Triggers>

    <Grid Style="{StaticResource LoginRootGridStyle}">

        <Border x:Name="LoginCard"
                Style="{StaticResource LoginCardBorderStyle}"
                Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="LoginCardTranslate" Y="24"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource LoginLockIconCircleStyle}">
                    <materialDesign:PackIcon Kind="LockOutline"
                                             Style="{StaticResource LoginLockIconStyle}"/>
                </Border>

                <TextBlock Grid.Row="1"
                           Text="{DynamicResource Login_WelcomeTitle}"
                           Style="{StaticResource LoginTitleTextStyle}"/>

                <TextBlock Grid.Row="2"
                           Text="{DynamicResource Login_Subtitle}"
                           Style="{StaticResource LoginSubtitleTextStyle}"/>

                <TextBlock Grid.Row="3"
                           Text="{DynamicResource Login_UsernameLabel}"
                           Style="{StaticResource LoginFieldLabelStyle}"/>

                <Grid Grid.Row="4"
                      Style="{StaticResource LoginInputHostGridStyle}">
                    <TextBox Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{DynamicResource Login_UsernameHint}"
                             Style="{StaticResource LoginTextBoxStyle}"/>
                    <materialDesign:PackIcon Kind="AccountOutline"
                                             Style="{StaticResource LoginInputLeadingIconStyle}"/>
                </Grid>

                <TextBlock Grid.Row="5"
                           Text="{DynamicResource Login_PasswordLabel}"
                           Style="{StaticResource LoginFieldLabelStyle}"/>

                <Grid Grid.Row="6"
                      Style="{StaticResource LoginInputHostGridStyle}">
                    <PasswordBox x:Name="LoginPasswordBox"
                                 PasswordChanged="OnPasswordChanged"
                                 Tag="{DynamicResource Login_PasswordHint}"
                                 Style="{StaticResource LoginPasswordBoxStyle}"/>
                    <TextBox x:Name="LoginPasswordTextBox"
                             TextChanged="OnPasswordTextBoxChanged"
                             Style="{StaticResource LoginPasswordTextBoxStyle}"
                             Visibility="Collapsed"/>

                    <materialDesign:PackIcon Kind="LockOutline"
                                             Style="{StaticResource LoginInputLeadingIconStyle}"/>

                    <Button Style="{StaticResource LoginPasswordRevealButtonStyle}"
                            Click="OnRevealPasswordClick">
                        <materialDesign:PackIcon x:Name="RevealIcon"
                                                 Kind="EyeOutline"
                                                 Style="{StaticResource LoginPasswordRevealIconStyle}"/>
                    </Button>
                </Grid>

                <CheckBox Grid.Row="7"
                          Content="{DynamicResource Login_RememberAccount}"
                          IsChecked="{Binding RememberAccount, Mode=TwoWay}"
                          Style="{StaticResource LoginCheckBoxStyle}"/>

                <TextBlock Grid.Row="8"
                           Text="{Binding ErrorMessage}"
                           Style="{StaticResource LoginErrorTextStyle}"/>

                <Button Grid.Row="9"
                        Command="{Binding SignInCommand}"
                        Style="{StaticResource LoginPrimaryButtonStyle}">
                    <Grid Style="{StaticResource LoginButtonContentGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Login"
                                                 Style="{StaticResource LoginButtonIconStyle}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{DynamicResource Login_SignInButton}"
                                   Style="{StaticResource LoginButtonTextStyle}"/>
                    </Grid>
                </Button>

                <Grid Grid.RowSpan="10"
                      Style="{StaticResource LoginLoadingOverlayGridStyle}">
                    <Border Style="{StaticResource LoginLoadingBackdropStyle}"/>
                    <StackPanel Style="{StaticResource LoginLoadingPanelStyle}">
                        <ProgressBar Style="{StaticResource LoginLoadingProgressBarStyle}"/>
                        <TextBlock Text="{DynamicResource Login_SigningIn}"
                                   Style="{StaticResource LoginLoadingTextStyle}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
