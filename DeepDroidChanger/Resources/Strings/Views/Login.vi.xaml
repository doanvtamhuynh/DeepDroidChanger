<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="Login_WindowTitle">Đăng nhập DeepDroidChanger</sys:String>
    <sys:String x:Key="Login_WelcomeTitle">Đăng nhập</sys:String>
    <sys:String x:Key="Login_Subtitle">Tài khoản thử nghiệm: admin / admin</sys:String>
    <sys:String x:Key="Login_UsernameLabel">Tên đăng nhập</sys:String>
    <sys:String x:Key="Login_PasswordLabel">Mật khẩu</sys:String>
    <sys:String x:Key="Login_UsernameHint">Nhập tên đăng nhập</sys:String>
    <sys:String x:Key="Login_PasswordHint">Mật khẩu</sys:String>
    <sys:String x:Key="Login_TogglePasswordVisibility">Hiện hoặc ẩn mật khẩu khi đang nhập. Hãy ẩn lại trước khi rời khỏi màn hình này.</sys:String>
    <sys:String x:Key="Login_RememberAccount">Lưu thông tin đăng nhập</sys:String>
    <sys:String x:Key="Login_SignInButton">Đăng nhập</sys:String>
    <sys:String x:Key="Login_SigningIn">Đang đăng nhập...</sys:String>
    <sys:String x:Key="Login_ErrorMissingFields">Vui lòng nhập tên đăng nhập và mật khẩu.</sys:String>
    <sys:String x:Key="Login_ErrorAuthenticationFailed">Tên đăng nhập hoặc mật khẩu không đúng.</sys:String>
    <sys:String x:Key="Login_ErrorAccountSaveFailed">Đăng nhập thành công nhưng không thể cập nhật tài khoản đã lưu.</sys:String>
    <sys:String x:Key="Login_ErrorCanceled">Đã hủy đăng nhập.</sys:String>
</ResourceDictionary>
