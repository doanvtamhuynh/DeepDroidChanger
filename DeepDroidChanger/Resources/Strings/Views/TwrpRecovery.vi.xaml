    <sys:String x:Key="Twrp_Build">ROM / build</sys:String>
    <sys:String x:Key="Twrp_ListHint">Để restore, chọn backup hoàn tất rồi bật chế độ khôi phục ở tab Chuẩn bị. Để phục hồi, chọn phiên dở dang và nhập FLASH TWRP ở tab đó trước. Chi tiết và đường dẫn cứu hộ ở tab Kết quả.</sys:String>
    <sys:String x:Key="Twrp_Recover">Kiểm tra / phục hồi boot</sys:String>
    <sys:String x:Key="Twrp_Delete">Xóa bản sao lưu</sys:String>
    <sys:String x:Key="Twrp_DeleteWarning">Xóa phiên này và backup TWRP tương ứng? Phiên dở dang sẽ chặn xóa. Bản cứu hộ bổ sung trong thư mục PC bạn chọn vẫn được giữ.</sys:String>
    <sys:String x:Key="Twrp_Deleted">Đã xóa backup. Bản cứu hộ bổ sung vẫn được giữ.</sys:String>
    <sys:String x:Key="Twrp_Ready">Điều kiện đạt. Kiểm tra lựa chọn và nơi cứu hộ trước khi flash.</sys:String>
    <sys:String x:Key="Twrp_GuardReady">Guard và cầu native đang chạy; boot gốc đã ở RAM. Có thể giải mã Data trong TWRP. Chờ tối đa 5 phút.</sys:String>
    <sys:String x:Key="Twrp_PreflightBlocked">Kiểm tra điều kiện chưa đạt.</sys:String>
    <sys:String x:Key="Twrp_UnsupportedDevice">Thiết bị không hỗ trợ. Property ro.deepdroid.device phải là sargo. Chưa flash hoặc reboot.</sys:String>
    <sys:String x:Key="Twrp_Android13Required">Cần Android 13 (SDK 33).</sys:String>
    <sys:String x:Key="Twrp_BootloaderLocked">Bootloader phải được mở khóa sẵn.</sys:String>
