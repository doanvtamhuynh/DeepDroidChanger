    <sys:String x:Key="Twrp_BatteryLow">Pin phải từ 50% hoặc máy đang sạc.</sys:String>
    <sys:String x:Key="Twrp_InvalidImage">Thiếu ảnh TWRP, hash không khớp hoặc định dạng ảnh chưa hỗ trợ.</sys:String>
    <sys:String x:Key="Twrp_ImageTooLarge">Ảnh recovery tạo ra vượt vùng chứa ảnh được hỗ trợ.</sys:String>
    <sys:String x:Key="Twrp_RootRequired">Cần quyền ADB root đã xác minh.</sys:String>
    <sys:String x:Key="Twrp_OtaNotIdle">OTA/snapshot đang bận hoặc không xác định. Đã chặn flash.</sys:String>
    <sys:String x:Key="Twrp_InvalidLayout">Không xác minh được bố cục phân vùng.</sys:String>
    <sys:String x:Key="Twrp_NoStaging">Không có thư mục tạm để lưu boot gốc và ảnh recovery.</sys:String>
    <sys:String x:Key="Twrp_InvalidSelection">Lựa chọn phân vùng không hợp lệ. Không gửi boot hoặc phân vùng chưa hỗ trợ tới nandroid.</sys:String>
    <sys:String x:Key="Twrp_UnsafePath">Đường dẫn không đạt kiểm tra an toàn.</sys:String>
    <sys:String x:Key="Twrp_HashMismatch">Kiểm tra SHA-256 thất bại.</sys:String>
    <sys:String x:Key="Twrp_InvalidJournal">Journal không hợp lệ. Giữ bản cứu hộ và kiểm tra thủ công.</sys:String>
    <sys:String x:Key="Twrp_DeviceBusy">Thiết bị đang có thao tác khác.</sys:String>
    <sys:String x:Key="Twrp_ConfirmationRequired">Xác nhận thao tác trước khi tiếp tục.</sys:String>
    <sys:String x:Key="Twrp_PendingSession">Có phiên TWRP dở dang cần xử lý. Mở danh sách và kiểm tra/phục hồi trước khi thực hiện phiên mới.</sys:String>
    <sys:String x:Key="Twrp_IncompatibleBackup">Backup chưa hoàn tất hoặc không tương thích thiết bị, ROM, Android, slot, storage hay bố cục phân vùng.</sys:String>
    <sys:String x:Key="Twrp_AlreadyProtected">Phân vùng nhạy cảm được chọn đã có backup hoàn tất. Hãy giữ bản hiện có.</sys:String>
    <sys:String x:Key="Twrp_WorkflowFailed">Thao tác thất bại. Kiểm tra journal, kết quả và bản cứu hộ trước khi thử lại.</sys:String>
    <sys:String x:Key="Twrp_FlashFailed">Flash recovery chưa hoàn tất. Đã yêu cầu phục hồi boot; hãy kiểm tra kết quả.</sys:String>
    <sys:String x:Key="Twrp_RecoveryTimeout">Hết thời gian chờ kết quả recovery. Guard độc lập có thể vẫn chạy; không mở phiên mới.</sys:String>
    <sys:String x:Key="Twrp_BootRestoreFailed">Chưa hoàn nguyên được boot gốc hoặc Android chưa trở lại. Kiểm tra kết quả và bản cứu hộ.</sys:String>
    <sys:String x:Key="Twrp_InvalidManifest">Danh sách payload backup bị thiếu hoặc không hợp lệ.</sys:String>
    <sys:String x:Key="Twrp_GuardOwnsRecovery">Guard recovery đang chịu trách nhiệm phiên này. Chờ kết quả hoặc dùng hướng dẫn cứu hộ thủ công đã lưu.</sys:String>
    <sys:String x:Key="Twrp_ManualRecoveryRequired">Phục hồi boot tự động chưa hoàn tất. Dùng original.img và restore-boot.ps1 trong thư mục cứu hộ PC khi ADB còn online.</sys:String>
