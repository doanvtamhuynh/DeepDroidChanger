    <sys:String x:Key="Twrp_Risk">Chỉ Pixel 3a (sargo), Android 13. TWRP tạm ghi đè boot của slot hiện tại. Phải hoàn nguyên boot gốc trước khi trở lại Android.</sys:String>
    <sys:String x:Key="Twrp_MediaWarning">Data của TWRP không gồm /data/media và file bộ nhớ trong.</sys:String>
    <sys:String x:Key="Twrp_Inspect">Kiểm tra thiết bị và điều kiện</sys:String>
    <sys:String x:Key="Twrp_InspectHint">Kiểm tra điều kiện trước khi flash recovery.</sys:String>
    <sys:String x:Key="Twrp_StagingLocation">Thư mục tạm</sys:String>
    <sys:String x:Key="Twrp_StorageLocation">Lưu trên máy</sys:String>
    <sys:String x:Key="Twrp_StorageHint">Bộ nhớ trong: /data/media/0 (cần giải mã). USB OTG: /usb_otg (phải được mount). Chỉ dùng đường dẫn đã kiểm tra trong recovery.</sys:String>
    <sys:String x:Key="Twrp_RescueLocation">Boot cứu hộ</sys:String>
    <sys:String x:Key="Twrp_Browse">Chọn…</sys:String>
    <sys:String x:Key="Twrp_RestoreMode">Khôi phục bản đã chọn (chọn trong danh sách trước)</sys:String>
    <sys:String x:Key="Twrp_Execute">Bắt đầu backup / restore</sys:String>
    <sys:String x:Key="Twrp_RebootWarning">Giải mã Data trực tiếp trong TWRP khi được hỏi (chờ tối đa 5 phút). Ứng dụng không lưu mật khẩu. Máy trở lại sau khi hoàn nguyên boot; restore lỗi sẽ giữ recovery. Giữ nguồn điện. Các nút và việc đóng cửa sổ bị khóa trong lúc chạy.</sys:String>
    <sys:String x:Key="Twrp_SafetyLimit">Phục hồi qua ADB khi Android hoặc TWRP còn online. Giữ bản cứu hộ PC. Mất nguồn hoặc recovery không khởi động có thể cần phục hồi thủ công theo thiết bị.</sys:String>
