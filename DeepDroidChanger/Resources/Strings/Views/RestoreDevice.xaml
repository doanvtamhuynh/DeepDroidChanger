<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="RestoreDevice_WindowTitle">Restore Device</sys:String>
    <sys:String x:Key="RestoreDevice_Header">Configure device restore</sys:String>
    <sys:String x:Key="RestoreDevice_Subtitle">Validate an encrypted .ddcbak archive before restoring selected device state.</sys:String>
    <sys:String x:Key="RestoreDevice_ArchiveHeader">Backup archive</sys:String>
    <sys:String x:Key="RestoreDevice_Browse">Browse...</sys:String>
    <sys:String x:Key="RestoreDevice_BrowseTitle">Choose a DeepDroid backup</sys:String>
    <sys:String x:Key="RestoreDevice_FileFilter">DeepDroid backup (*.ddcbak)|*.ddcbak</sys:String>
    <sys:String x:Key="RestoreDevice_ArchiveCountFormat">{0} backup archives selected</sys:String>
    <sys:String x:Key="RestoreDevice_InspectionFailureFormat">{0}: archive inspection failed ({1})</sys:String>
    <sys:String x:Key="RestoreDevice_PasswordLabel">Backup Password</sys:String>
    <sys:String x:Key="RestoreDevice_PasswordTooltip">Enter the password used to encrypt this backup.</sys:String>
    <sys:String x:Key="RestoreDevice_PasswordTooShort">Password must contain at least 8 characters.</sys:String>
    <sys:String x:Key="RestoreDevice_SourceHeader">Source backup</sys:String>
    <sys:String x:Key="RestoreDevice_BackupDate">Backup date</sys:String>
    <sys:String x:Key="RestoreDevice_SourceSerial">Source serial</sys:String>
    <sys:String x:Key="RestoreDevice_SourceRole">Source device role</sys:String>
    <sys:String x:Key="RestoreDevice_AndroidSdk">Android SDK</sys:String>
    <sys:String x:Key="RestoreDevice_TargetSerial">Target serial(s)</sys:String>
    <sys:String x:Key="RestoreDevice_PackageSummaryFormat">Packages in selected backup(s): {0} user, {1} Google ({2} archive(s)).</sys:String>
    <sys:String x:Key="RestoreDevice_PartialAccountWarning">Backup contains partial Google Account State.</sys:String>
    <sys:String x:Key="RestoreDevice_SameDeviceAccountWarning">Google Account State is restricted to a compatible same-device restore.</sys:String>
    <sys:String x:Key="RestoreDevice_AccountSnapshotUnavailableWarning">Some Google Account State snapshots were unavailable in this backup.</sys:String>
    <sys:String x:Key="RestoreDevice_SourceSerialDiffersWarning">The backup source serial differs from the target.</sys:String>
    <sys:String x:Key="RestoreDevice_SourceRoleDiffersWarning">The backup source device role differs from the target.</sys:String>
    <sys:String x:Key="RestoreDevice_KeyboxSensitiveWarning">Keybox restore is sensitive and can change device identity state.</sys:String>
    <sys:String x:Key="RestoreDevice_SsaidCrossDeviceWarning">SSAID restore is strongly discouraged across different device serials.</sys:String>
    <sys:String x:Key="RestoreDevice_GoogleAppCrossDeviceWarning">Google App Data comes from a different source device or role.</sys:String>
    <sys:String x:Key="RestoreDevice_AccountIncompatibleWarning">Google Account State is incompatible with this target and must be deselected.</sys:String>
    <sys:String x:Key="RestoreDevice_ComponentsHeader">Restore components</sys:String>
    <sys:String x:Key="RestoreDevice_DeviceProperties">Device and Change Properties</sys:String>
    <sys:String x:Key="RestoreDevice_ManagedSettings">Managed System Settings</sys:String>
    <sys:String x:Key="RestoreDevice_UserAppData">User App Data</sys:String>
    <sys:String x:Key="RestoreDevice_ExperimentalHeader">Sensitive / experimental components</sys:String>
    <sys:String x:Key="RestoreDevice_ExperimentalWarning">These components can overwrite identity, account, or integrity state. Select them only when the source is compatible.</sys:String>
    <sys:String x:Key="RestoreDevice_Keybox">Keybox</sys:String>
    <sys:String x:Key="RestoreDevice_Ssaid">SSAID</sys:String>
    <sys:String x:Key="RestoreDevice_GoogleAppData">Google App Data</sys:String>
    <sys:String x:Key="RestoreDevice_GoogleAccountState">Google Account State</sys:String>
    <sys:String x:Key="RestoreDevice_NotAvailableTooltip">Not available in this backup.</sys:String>
    <sys:String x:Key="RestoreDevice_ConfirmationWarning">Restore may overwrite application and system data and may reboot the device.</sys:String>
    <sys:String x:Key="RestoreDevice_Cancel">Cancel</sys:String>
    <sys:String x:Key="RestoreDevice_Confirm">Inspect / Restore</sys:String>
    <sys:String x:Key="RestoreDevice_Action">Restore Device</sys:String>
    <sys:String x:Key="RestoreDevice_ActionTooltip">Restore selected state from a validated encrypted .ddcbak archive.</sys:String>
</ResourceDictionary>
