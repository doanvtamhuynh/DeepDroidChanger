<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="ChangeDeviceConfirmation_WindowTitle">Confirm Change Device</sys:String>
    <sys:String x:Key="ChangeDeviceConfirmation_Title">Apply the generated identity to this device?</sys:String>
    <sys:String x:Key="ChangeDeviceConfirmation_DefaultProfileNotice">Default change and wipe applies the generated device profile while preserving Android ID.</sys:String>
    <sys:String x:Key="ChangeDeviceConfirmation_AdvancedProfileNotice">Advanced profile options: {0}.</sys:String>
    <sys:String x:Key="ChangeDeviceConfirmation_RegenerateAndroidId">Android ID will be regenerated by deleting the current secure setting</sys:String>
    <sys:String x:Key="ChangeDeviceConfirmation_PreserveAndroidId">Android ID will be preserved</sys:String>
    <sys:String x:Key="ChangeDeviceConfirmation_ChangeMac">Wi-Fi/Bluetooth MAC will be changed</sys:String>
    <sys:String x:Key="ChangeDeviceConfirmation_DeepPackageWipe">Deep package wipe will run "rm -rf" on eight app-data and ART-profile paths after "pm clear"</sys:String>
    <sys:String x:Key="ChangeDeviceConfirmation_NoPackageCleanup">No package data will be cleared.</sys:String>
    <sys:String x:Key="ChangeDeviceConfirmation_ClearAllPackages">Data for all installed packages will be cleared</sys:String>
    <sys:String x:Key="ChangeDeviceConfirmation_ClearSelectedPackages">Data for {0} selected package(s) will be cleared</sys:String>
    <sys:String x:Key="ChangeDeviceConfirmation_ClearGooglePackages">Google package data will be cleared</sys:String>
    <sys:String x:Key="ChangeDeviceConfirmation_ClearGoogleAccounts">Google package data, accounts, and encrypted CE/DE user state will be cleared</sys:String>
    <sys:String x:Key="ChangeDeviceConfirmation_GoogleDataPreserved">Google package data and accounts are preserved.</sys:String>
    <sys:String x:Key="ChangeDeviceConfirmation_GoogleDataMayBeCleared">Google data may be removed by the selected cleanup policy. Cleared data cannot be recovered without a backup.</sys:String>
</ResourceDictionary>
