<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="ChangeDeviceConfirmation_Caption">Confirm Change Device: {0} - {1}</sys:String>
    <sys:String x:Key="ChangeDeviceConfirmation_Message">Applies the generated device information and selected cleanup options.</sys:String>
    <sys:String x:Key="ChangeDeviceConfirmation_Warning">This action will change device information and may erase data.</sys:String>
