<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DesignTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style TargetType="{x:Type GroupBox}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="SurfaceGroupBoxStyle" TargetType="GroupBox" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource Spacing.CardPadding}" />
        <Setter Property="FontFamily" Value="{StaticResource Metric.FontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Medium}" Padding="{TemplateBinding Padding}">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="{TemplateBinding Header}" FontFamily="{StaticResource Metric.FontFamily}" FontSize="{StaticResource Metric.FontSize.SectionTitle}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,10" />
                            <ContentPresenter />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="OptionSectionGroupBoxStyle" TargetType="GroupBox" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="{StaticResource Metric.BorderThickness.Uniform}" />
        <Setter Property="Padding" Value="{StaticResource Spacing.CardPadding}" />
        <Setter Property="FontFamily" Value="{StaticResource Metric.FontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Medium}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" CornerRadius="{StaticResource Radius.TopMedium}" MinHeight="{StaticResource Metric.ControlHeight.Comfortable}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="3" Background="{DynamicResource Brush.Accent}" CornerRadius="{StaticResource Radius.TopLeftMedium}" />
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" Margin="12,8" VerticalAlignment="Center" TextElement.FontFamily="{StaticResource Metric.FontFamily}" TextElement.FontSize="{StaticResource Metric.FontSize.Body}" TextElement.FontWeight="SemiBold" TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True" />
                                </Grid>
                            </Border>
                            <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PagePanelGroupBoxStyle" TargetType="GroupBox" BasedOn="{StaticResource SurfaceGroupBoxStyle}" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
        <Setter Property="Padding" Value="{StaticResource Spacing.CardPadding.Compact}" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style x:Key="DialogOptionGroupBoxStyle" TargetType="GroupBox" BasedOn="{StaticResource OptionSectionGroupBoxStyle}" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
</ResourceDictionary>