<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Style x:Key="AdvancedChangeConfigHeaderIconStyle"
           TargetType="materialDesign:PackIcon">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
    </Style>

    <Style x:Key="AdvancedChangeConfigSelectiveGroupStyle"
           TargetType="GroupBox"
           BasedOn="{StaticResource {x:Type GroupBox}}">
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Brush.SurfacePressed}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                <Setter Property="Opacity" Value="0.48"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AdvancedChangeConfigPackagePanelStyle"
           TargetType="Border"
           BasedOn="{StaticResource CardBorderStyle}">
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Brush.SurfacePressed}"/>
                <Setter Property="Opacity" Value="0.48"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AdvancedChangeConfigPrimaryButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
        <Setter Property="Height" Value="{StaticResource Metric.ControlHeight}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.ButtonPadding}"/>
        <Setter Property="materialDesign:ButtonAssist.CornerRadius"
                Value="{StaticResource Radius.Medium}"/>
        <Setter Property="materialDesign:RippleAssist.Feedback"
                Value="{DynamicResource Brush.AccentForeground}"/>
        <Setter Property="materialDesign:RippleAssist.RippleOnTop" Value="True"/>
        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="AdvancedChangeConfigButtonIconStyle"
           TargetType="materialDesign:PackIcon">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
    </Style>

    <Style x:Key="AdvancedChangeConfigButtonTextStyle"
           TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Metric.FontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
    </Style>
</ResourceDictionary>
