<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Style x:Key="UpdateIntegrityRootGridStyle" TargetType="Grid">
        <Setter Property="Margin" Value="20"/>
    </Style>

    <Style x:Key="UpdateIntegrityDeviceHeaderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="UpdateIntegrityHeaderIconStyle" TargetType="materialDesign:PackIcon">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <Style x:Key="UpdateIntegrityInfoDeviceTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="UpdateIntegritySectionBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="UpdateIntegrityModeGroupBoxStyle" TargetType="GroupBox"
           BasedOn="{StaticResource OptionSectionGroupBoxStyle}">
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="UpdateIntegrityCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource Metric.FontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="UpdateIntegritySelectorGridStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Brush.SurfacePressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="UpdateIntegrityInputLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Metric.FontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="Margin" Value="0,4,0,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="UpdateIntegrityTextBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource FlatTextBoxStyle}">
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.SurfaceSelected}"/>
        <Setter Property="MinWidth" Value="260"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="materialDesign:HintAssist.Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
    </Style>

    <Style x:Key="UpdateIntegrityBrowseButtonStyle" TargetType="Button"
           BasedOn="{StaticResource MaterialDesignFlatButton}">
        <Setter Property="Height" Value="{StaticResource Metric.ControlHeight.Comfortable}"/>
        <Setter Property="MinWidth" Value="112"/>
        <Setter Property="Margin" Value="4,0,0,8"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="UpdateIntegrityBrowseIconStyle" TargetType="materialDesign:PackIcon">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <Style x:Key="UpdateIntegrityBrowseButtonTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Metric.FontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="UpdateIntegrityActionGridStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>

    <Style x:Key="UpdateIntegritySaveButtonStyle" TargetType="Button"
           BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="16,0,16,0"/>
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="{StaticResource Radius.Medium}"/>
        <Setter Property="materialDesign:RippleAssist.Feedback"
                Value="{DynamicResource Brush.AccentForeground}"/>
        <Setter Property="materialDesign:RippleAssist.RippleOnTop" Value="True"/>
        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="UpdateIntegrityButtonIconStyle" TargetType="materialDesign:PackIcon">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <Style x:Key="UpdateIntegrityButtonTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Metric.FontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
