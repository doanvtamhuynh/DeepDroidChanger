<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DesignTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="AppFocusVisualStyle" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="2" BorderBrush="{DynamicResource Brush.Focus}" BorderThickness="2" CornerRadius="{StaticResource Radius.Small}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type Control}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
        <Setter Property="FontFamily" Value="{DynamicResource Metric.FontFamily}" />
        <Setter Property="FontStyle" Value="{DynamicResource Metric.FontStyle}" />
        <Setter Property="FontSize" Value="{DynamicResource Metric.FontSize.Body}" />
        <Setter Property="FontWeight" Value="{DynamicResource Metric.FontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
</ResourceDictionary>