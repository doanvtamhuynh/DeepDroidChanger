<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Style x:Key="DeleteDeviceConfirmationRootGridStyle"
           TargetType="Grid">
        <Setter Property="Margin"
                Value="20"/>
    </Style>

    <Style x:Key="DeleteDeviceConfirmationHeaderGridStyle"
           TargetType="Grid">
        <Setter Property="Margin"
                Value="0,0,0,14"/>
    </Style>

    <Style x:Key="DeleteDeviceConfirmationHeaderIconStyle"
           TargetType="materialDesign:PackIcon">
        <Setter Property="Width"
                Value="24"/>
        <Setter Property="Height"
                Value="24"/>
        <Setter Property="Foreground"
                Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="VerticalAlignment"
                Value="Center"/>
        <Setter Property="Margin"
                Value="0,0,10,0"/>
    </Style>

    <Style x:Key="DeleteDeviceConfirmationTitleTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource AppTitleTextStyle}">
        <Setter Property="FontSize"
                Value="{StaticResource Metric.FontSize.Subtitle}"/>
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="DeleteDeviceConfirmationContentGridStyle"
           TargetType="Grid">
        <Setter Property="Margin"
                Value="0,0,0,18"/>
    </Style>

    <Style x:Key="DeleteDeviceConfirmationMessageTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource AppLabelTextStyle}">
        <Setter Property="TextWrapping"
                Value="Wrap"/>
        <Setter Property="Margin"
                Value="0,0,0,12"/>
    </Style>

    <Style x:Key="DeleteDeviceConfirmationDeviceNameTextStyle"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{StaticResource Metric.FontFamily}"/>
        <Setter Property="FontSize"
                Value="{StaticResource Metric.FontSize.Body}"/>
        <Setter Property="FontWeight"
                Value="SemiBold"/>
        <Setter Property="Foreground"
                Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis"/>
        <Setter Property="Margin"
                Value="0,0,0,4"/>
    </Style>

    <Style x:Key="DeleteDeviceConfirmationSerialTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource AppLabelTextStyle}">
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="DeleteDeviceConfirmationActionGridStyle"
           TargetType="Grid">
        <Setter Property="Margin"
                Value="0,8,0,0"/>
    </Style>

    <Style x:Key="DeleteDeviceConfirmationSecondaryButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource FlatButtonStyle}">
        <Setter Property="Height"
                Value="36"/>
        <Setter Property="Padding"
                Value="14,0"/>
        <Setter Property="Margin"
                Value="0,0,8,0"/>
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch"/>
        <Setter Property="VerticalContentAlignment"
                Value="Center"/>
    </Style>

    <Style x:Key="DeleteDeviceConfirmationDangerButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Height"
                Value="36"/>
        <Setter Property="Padding"
                Value="14,0"/>
        <Setter Property="Background"
                Value="{DynamicResource Brush.Danger}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource Brush.Danger}"/>
        <Setter Property="Foreground"
                Value="{DynamicResource Brush.AccentForeground}"/>
        <Setter Property="materialDesign:ButtonAssist.CornerRadius"
                Value="{StaticResource Radius.Medium}"/>
        <Setter Property="materialDesign:RippleAssist.Feedback"
                Value="{DynamicResource Brush.AccentForeground}"/>
        <Setter Property="materialDesign:RippleAssist.RippleOnTop"
                Value="True"/>
        <Setter Property="Cursor"
                Value="Hand"/>
    </Style>

    <Style x:Key="DeleteDeviceConfirmationButtonIconStyle"
           TargetType="materialDesign:PackIcon">
        <Setter Property="Width"
                Value="16"/>
        <Setter Property="Height"
                Value="16"/>
        <Setter Property="VerticalAlignment"
                Value="Center"/>
        <Setter Property="Margin"
                Value="0,0,6,0"/>
    </Style>

    <Style x:Key="DeleteDeviceConfirmationButtonTextStyle"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{StaticResource Metric.FontFamily}"/>
        <Setter Property="FontSize"
                Value="{StaticResource Metric.FontSize.Body}"/>
        <Setter Property="FontWeight"
                Value="SemiBold"/>
        <Setter Property="VerticalAlignment"
                Value="Center"/>
    </Style>
</ResourceDictionary>
