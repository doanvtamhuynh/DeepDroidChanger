<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Style x:Key="RandomDeviceInfoRootGridStyle"
           TargetType="Grid">
        <Setter Property="Margin" Value="{StaticResource Spacing.PageMargin}"/>
    </Style>

    <Style x:Key="RandomDeviceInfoHeaderGridStyle"
           TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="RandomDeviceInfoHeaderIconStyle"
           TargetType="materialDesign:PackIcon">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <Style x:Key="RandomDeviceInfoTitleTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource AppTitleTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Title}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="RandomDeviceInfoDescriptionTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource SecondaryTextStyle}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="RandomDeviceInfoFieldCardStyle"
           TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Metric.BorderThickness.Uniform}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.CardPadding.Compact}"/>
        <Setter Property="Margin" Value="0,0,10,10"/>
    </Style>

    <Style x:Key="RandomDeviceInfoFieldTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource AppLabelTextStyle}">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="RandomDeviceInfoInputStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource FlatTextBoxStyle}">
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="MinHeight" Value="{StaticResource Metric.ControlHeight}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.InputPadding}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>

    <Style x:Key="RandomDeviceInfoActionGridStyle"
           TargetType="Grid">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="0,12,0,0"/>
    </Style>

    <Style x:Key="RandomDeviceInfoUpdateButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
        <Setter Property="MinWidth" Value="96"/>
        <Setter Property="Height" Value="{StaticResource Metric.ControlHeight}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.ButtonPadding}"/>
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="{StaticResource Radius.Medium}"/>
        <Setter Property="materialDesign:RippleAssist.Feedback"
                Value="{DynamicResource Brush.AccentForeground}"/>
        <Setter Property="materialDesign:RippleAssist.RippleOnTop" Value="True"/>
        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="RandomDeviceInfoUpdateButtonTextStyle"
           TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Metric.FontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="RandomDeviceInfoUpdateButtonIconStyle"
           TargetType="materialDesign:PackIcon">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
</ResourceDictionary>
