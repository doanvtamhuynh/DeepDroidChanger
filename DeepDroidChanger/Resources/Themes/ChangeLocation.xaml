<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

<!-- ROOT -->
<Style x:Key="ChangeLocationRootGridStyle" TargetType="Grid">
    <Setter Property="Margin" Value="20"/>
</Style>

<!-- DEVICE INFO HEADER -->
<Style x:Key="ChangeLocationDeviceHeaderStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}"/>
    <Setter Property="Padding" Value="14,12"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
</Style>

<Style x:Key="ChangeLocationHeaderIconStyle" TargetType="materialDesign:PackIcon">
    <Setter Property="Width" Value="22"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,0,10,0"/>
</Style>

<!-- DEVICE INFO -->
<Style x:Key="ChangeLocationInfoDeviceTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
</Style>

<!-- MODE GROUP BOX -->
<Style x:Key="ChangeLocationModeGroupBoxStyle" TargetType="GroupBox"
       BasedOn="{StaticResource OptionSectionGroupBoxStyle}">
    <Setter Property="Margin" Value="0,0,0,12"/>
</Style>

<!-- MODE RADIO BUTTON -->
<Style x:Key="ChangeLocationModeRadioStyle" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource Metric.FontFamily}"/>
    <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
    <Setter Property="Margin" Value="0,4"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
</Style>

<!-- SELECTOR GRID -->
<Style x:Key="ChangeLocationSelectorGridStyle" TargetType="Grid">
    <Setter Property="Margin" Value="0,0,0,12"/>
</Style>

<!-- INPUT LABEL -->
<Style x:Key="ChangeLocationInputLabelStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Metric.FontFamily}"/>
    <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
    <Setter Property="Margin" Value="0,4,0,4"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
</Style>

<!-- HINT TEXT -->
<Style x:Key="ChangeLocationHintTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Metric.FontFamily}"/>
    <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
    <Setter Property="Margin" Value="2,-2,0,0"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
</Style>

<!-- TEXT BOX -->
<Style x:Key="ChangeLocationTextBoxStyle"
       TargetType="TextBox"
       BasedOn="{StaticResource FlatTextBoxStyle}">
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.SurfaceSelected}"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
    <Setter Property="materialDesign:HintAssist.Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
</Style>

<!-- ACTION GRID -->
<Style x:Key="ChangeLocationActionGridStyle" TargetType="Grid">
    <Setter Property="Margin" Value="0,8,0,0"/>
</Style>


<!-- SAVE BUTTON -->
<Style x:Key="ChangeLocationSaveButtonStyle" TargetType="Button"
       BasedOn="{StaticResource MaterialDesignRaisedButton}">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Padding" Value="16,0,16,0"/>
    <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="{StaticResource Radius.Medium}"/>
    <Setter Property="materialDesign:RippleAssist.Feedback"
            Value="{DynamicResource Brush.AccentForeground}"/>
    <Setter Property="materialDesign:RippleAssist.RippleOnTop" Value="True"/>
    <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2"/>
    <Setter Property="Cursor" Value="Hand"/>
</Style>

<!-- BUTTON ICON -->
<Style x:Key="ChangeLocationButtonIconStyle" TargetType="materialDesign:PackIcon">
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,0,6,0"/>
</Style>

<!-- BUTTON TEXT -->
<Style x:Key="ChangeLocationButtonTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Metric.FontFamily}"/>
    <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
</Style>

</ResourceDictionary>
