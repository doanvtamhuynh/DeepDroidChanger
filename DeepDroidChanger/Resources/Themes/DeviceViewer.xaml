<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- ── Disconnected Screen Geometries ── -->

    <!-- Thân điện thoại: hình chữ nhật bo góc -->
    <PathGeometry x:Key="PhoneBodyGeometry">
        M 30,0
        L 90,0
        Q 120,0 120,30
        L 120,210
        Q 120,240 90,240
        L 30,240
        Q 0,240 0,210
        L 0,30
        Q 0,0 30,0 Z
    </PathGeometry>

    <!-- Màn hình điện thoại (bên trong thân) -->
    <PathGeometry x:Key="PhoneScreenGeometry">
        M 14,30 L 106,30 L 106,196 L 14,196 Z
    </PathGeometry>

    <!-- Mũi tên lên (trong màn hình) -->
    <PathGeometry x:Key="ArrowUpGeometry">
        M 60,60 L 60,140
        M 60,60 L 44,80
        M 60,60 L 76,80
    </PathGeometry>

    <!-- Mũi tên xuống (trong màn hình, lệch sang phải) -->
    <PathGeometry x:Key="ArrowDownGeometry">
        M 72,90 L 72,170
        M 72,170 L 56,150
        M 72,170 L 88,150
    </PathGeometry>

    <sys:Double x:Key="DeviceViewerTitleBarMinHeight">40</sys:Double>
    <sys:Double x:Key="DeviceViewerStatusBarMinHeight">22</sys:Double>

    <Style x:Key="DeviceViewerRootBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="DeviceViewerTitleBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>

    <Style x:Key="DeviceViewerPanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="DeviceViewerSectionHeaderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>

    <Style x:Key="DeviceViewerInfoPillStyle" TargetType="Border">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}"/>
    </Style>

    <Style x:Key="DeviceViewerTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Metric.FontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DeviceViewerSmallTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Metric.FontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Small}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="DeviceViewerButtonTextStyle" TargetType="TextBlock"
           BasedOn="{StaticResource DeviceViewerSmallTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
    </Style>

    <Style x:Key="DeviceViewerMutedTextStyle" TargetType="TextBlock"
           BasedOn="{StaticResource DeviceViewerSmallTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
    </Style>

    <Style x:Key="DeviceViewerInfoPillTextStyle" TargetType="TextBlock"
           BasedOn="{StaticResource DeviceViewerSmallTextStyle}">
        <Setter Property="MaxWidth" Value="150"/>
    </Style>

    <Style x:Key="DeviceViewerSectionLabelStyle" TargetType="TextBlock"
           BasedOn="{StaticResource DeviceViewerMutedTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="DeviceViewerIconStyle" TargetType="materialDesign:PackIcon">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DeviceViewerButtonIconStyle" TargetType="materialDesign:PackIcon"
           BasedOn="{StaticResource DeviceViewerIconStyle}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
    </Style>

    <Style x:Key="DeviceViewerLeftButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Medium}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Brush.AccentHover}"/>
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Brush.AccentHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Brush.AccentPressed}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Brush.SurfacePressed}"/>
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DeviceViewerNavButtonStyle" TargetType="Button"
           BasedOn="{StaticResource DeviceViewerLeftButtonStyle}">
        <Setter Property="Width" Value="80"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Margin" Value="4,0"/>
    </Style>

    <Style x:Key="DeviceViewerActionButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Medium}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Brush.AccentHover}"/>
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Brush.AccentHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Brush.AccentPressed}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Brush.SurfacePressed}"/>
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DeviceViewerInputStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.SurfaceSelected}"/>
        <Setter Property="FontFamily" Value="{StaticResource Metric.FontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Body}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="materialDesign:HintAssist.Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
    </Style>

    <Style x:Key="DeviceViewerStreamStatusStyle" TargetType="TextBlock"
           BasedOn="{StaticResource DeviceViewerMutedTextStyle}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DeviceViewerStreamErrorStyle" TargetType="TextBlock"
           BasedOn="{StaticResource DeviceViewerStreamStatusStyle}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
    </Style>

    <Style x:Key="DeviceViewerStatusBarTextStyle" TargetType="TextBlock"
           BasedOn="{StaticResource DeviceViewerSmallTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
    </Style>

    <!-- ── Disconnected Overlay Styles ── -->

    <Style x:Key="DeviceViewerDisconnectedOverlayStyle" TargetType="Grid">
        <Setter Property="Background" Value="{DynamicResource Brush.DeviceViewerStream}"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsWaitingForDevice}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Container của toàn bộ icon (phone + X), được scale bởi Viewbox -->
    <Style x:Key="DeviceViewerDisconnectedIconContainerStyle" TargetType="Canvas">
        <Setter Property="Width" Value="120"/>
        <Setter Property="Height" Value="240"/>
    </Style>

    <!-- Thân điện thoại trắng -->
    <Style x:Key="DeviceViewerPhoneBodyStyle" TargetType="Path">
        <Setter Property="Data" Value="{StaticResource PhoneBodyGeometry}"/>
        <Setter Property="Fill" Value="{DynamicResource Brush.DeviceViewerBody}"/>
        <Setter Property="Stroke" Value="Transparent"/>
    </Style>

    <!-- Màn hình điện thoại (màu tối hơn để tạo contrast) -->
    <Style x:Key="DeviceViewerPhoneScreenStyle" TargetType="Path">
        <Setter Property="Data" Value="{StaticResource PhoneScreenGeometry}"/>
        <Setter Property="Fill" Value="{DynamicResource Brush.DeviceViewerScreen}"/>
    </Style>

    <!-- Nút home tròn đen -->
    <Style x:Key="DeviceViewerPhoneHomeStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="{DynamicResource Brush.DeviceViewerScreen}"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Canvas.Left" Value="50"/>
        <Setter Property="Canvas.Top" Value="210"/>
    </Style>

    <!-- Mũi tên lên — màu trắng, nét to -->
    <Style x:Key="DeviceViewerArrowUpStyle" TargetType="Path">
        <Setter Property="Data" Value="{StaticResource ArrowUpGeometry}"/>
        <Setter Property="Stroke" Value="{DynamicResource Brush.DeviceViewerGlyph}"/>
        <Setter Property="StrokeThickness" Value="8"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Fill" Value="Transparent"/>
    </Style>

    <!-- Mũi tên xuống — màu trắng, nét to -->
    <Style x:Key="DeviceViewerArrowDownStyle" TargetType="Path">
        <Setter Property="Data" Value="{StaticResource ArrowDownGeometry}"/>
        <Setter Property="Stroke" Value="{DynamicResource Brush.DeviceViewerGlyph}"/>
        <Setter Property="StrokeThickness" Value="8"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Fill" Value="Transparent"/>
    </Style>

    <!-- Badge X đỏ: hình tròn đỏ chứa dấu X trắng -->
    <Style x:Key="DeviceViewerDisconnectedBadgeStyle" TargetType="Border">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Circle}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Danger}"/>
        <!-- Đặt ở góc dưới-phải của icon phone (canvas 120×240, badge 44×44) -->
        <Setter Property="Canvas.Left" Value="84"/>
        <Setter Property="Canvas.Top" Value="204"/>
    </Style>

    <!-- Dấu X bên trong badge -->
    <Style x:Key="DeviceViewerDisconnectedXStyle" TargetType="Path">
        <Setter Property="Data" Value="M 10,10 L 34,34 M 34,10 L 10,34"/>
        <Setter Property="Stroke" Value="{DynamicResource Brush.DeviceViewerGlyph}"/>
        <Setter Property="StrokeThickness" Value="5"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DeviceViewerStatusPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSelected}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDeviceDisconnected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
