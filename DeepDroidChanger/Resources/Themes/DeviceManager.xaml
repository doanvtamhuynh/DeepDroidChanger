<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <Style x:Key="DeviceManagerRootGridStyle"
           TargetType="Grid">
        <Setter Property="Margin"
                Value="{StaticResource Spacing.PageMargin}"/>
    </Style>

    <Style x:Key="DeviceManagerHeaderTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource AppTitleTextStyle}">
        <Setter Property="FontSize"
                Value="{StaticResource Metric.FontSize.Title}"/>
    </Style>

    <Style x:Key="DeviceManagerGridStyle"
           TargetType="DataGrid"
           BasedOn="{StaticResource FlatDataGridStyle}">
        <Setter Property="MinHeight"
                Value="220"/>
        <Setter Property="RowHeight"
                Value="{StaticResource Metric.DataGridEditorRowHeight}"/>
        <Setter Property="MaxHeight"
                Value="364"/>
        <Setter Property="GridLinesVisibility"
                Value="All"/>
        <Setter Property="HorizontalGridLinesBrush"
                Value="{DynamicResource Brush.Border}"/>
        <Setter Property="VerticalGridLinesBrush"
                Value="{DynamicResource Brush.Border}"/>
        <Setter Property="HorizontalScrollBarVisibility"
                Value="Auto"/>
        <Setter Property="VerticalScrollBarVisibility"
                Value="Auto"/>
        <Setter Property="RowStyle"
                Value="{DynamicResource DeviceGridRowContextMenuStyle}"/>
    </Style>

    <Style x:Key="DeviceGridRowContextMenuStyle"
           TargetType="DataGridRow"
           BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Setter Property="FocusVisualStyle"
                Value="{StaticResource AppFocusVisualStyle}"/>
        <Setter Property="Tag"
                Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu Style="{DynamicResource DeviceActionsContextMenuStyle}">
                    <MenuItem Command="{Binding PlacementTarget.Tag.ViewDeviceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              Style="{DynamicResource DeviceActionsContextMenuItemStyle}">
                        <MenuItem.Header>
                            <Grid Style="{DynamicResource DeviceActionsContextMenuHeaderGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Cellphone"
                                                         Style="{DynamicResource DeviceActionsContextMenuButtonIconStyle}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{DynamicResource DeviceManager_ActionViewDevice}"
                                           Style="{DynamicResource DeviceActionsContextMenuButtonTextStyle}"/>
                            </Grid>
                        </MenuItem.Header>
                    </MenuItem>

                    <MenuItem Command="{Binding PlacementTarget.Tag.ViewDeviceInfoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              Style="{DynamicResource DeviceActionsContextMenuItemStyle}">
                        <MenuItem.Header>
                            <Grid Style="{DynamicResource DeviceActionsContextMenuHeaderGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="InformationOutline"
                                                         Style="{DynamicResource DeviceActionsContextMenuButtonIconStyle}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{DynamicResource DeviceManager_RowMenuDeviceInfo}"
                                           Style="{DynamicResource DeviceActionsContextMenuButtonTextStyle}"/>
                            </Grid>
                        </MenuItem.Header>
                    </MenuItem>

                    <MenuItem Command="{Binding PlacementTarget.Tag.RebootDeviceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              Style="{DynamicResource DeviceActionsContextMenuItemStyle}">
                        <MenuItem.Header>
                            <Grid Style="{DynamicResource DeviceActionsContextMenuHeaderGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Restart"
                                                         Style="{DynamicResource DeviceActionsContextMenuButtonIconStyle}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{DynamicResource DeviceManager_RowMenuRebootDevice}"
                                           Style="{DynamicResource DeviceActionsContextMenuButtonTextStyle}"/>
                            </Grid>
                        </MenuItem.Header>
                    </MenuItem>

                    <Separator Style="{DynamicResource DeviceActionsContextMenuSeparatorStyle}"/>

                    <MenuItem Command="{Binding PlacementTarget.Tag.DeleteDeviceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              InputGestureText="{DynamicResource DeviceManager_RowMenuDeleteShortcut}"
                              Style="{DynamicResource DeviceActionsContextMenuDangerItemStyle}">
                        <MenuItem.Header>
                            <Grid Style="{DynamicResource DeviceActionsContextMenuHeaderGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Delete"
                                                         Style="{DynamicResource DeviceActionsContextMenuDangerButtonIconStyle}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{DynamicResource DeviceManager_RowMenuDeleteDevice}"
                                           Style="{DynamicResource DeviceActionsContextMenuDangerButtonTextStyle}"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding InputGestureText, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                                           Style="{DynamicResource DeviceActionsContextMenuShortcutTextStyle}"/>
                            </Grid>
                        </MenuItem.Header>
                    </MenuItem>
                </ContextMenu>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DeviceManagerColumnHeaderTextStyle"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{StaticResource Metric.FontFamily}"/>
        <Setter Property="FontSize"
                Value="{StaticResource Metric.FontSize.Small}"/>
        <Setter Property="FontWeight"
                Value="SemiBold"/>
        <Setter Property="Foreground"
                Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="HorizontalAlignment"
                Value="Center"/>
        <Setter Property="TextAlignment"
                Value="Center"/>
    </Style>

    <Style x:Key="DeviceManagerCellStretchStyle"
           TargetType="DataGridCell"
           BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="DeviceGridCellTextStyle"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{StaticResource Metric.FontFamily}"/>
        <Setter Property="FontSize"
                Value="{StaticResource Metric.FontSize.Body}"/>
        <Setter Property="Foreground"
                Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="VerticalAlignment"
                Value="Center"/>
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis"/>
        <Setter Property="Margin"
                Value="12,0"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}"
                         Value="True">
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.TextPrimary}"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}"
                               Value="True"/>
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                               Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.TextPrimary}"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DeviceGridWrappingCellTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource DeviceGridCellTextStyle}">
        <Setter Property="HorizontalAlignment"
                Value="Stretch"/>
        <Setter Property="TextAlignment"
                Value="Left"/>
        <Setter Property="TextWrapping"
                Value="Wrap"/>
        <Setter Property="TextTrimming"
                Value="None"/>
        <Setter Property="ToolTip"
