<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="SettingsRootGridStyle" TargetType="Grid">
        <Setter Property="Margin" Value="{StaticResource Spacing.PageMargin}"/>
    </Style>

    <Style x:Key="SettingsHeaderTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource AppTitleTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource Metric.FontSize.Title}"/>
    </Style>

    <Style x:Key="SettingsPanelStyle"
           TargetType="GroupBox"
           BasedOn="{StaticResource SurfaceGroupBoxStyle}">
        <Setter Property="Padding" Value="{StaticResource Spacing.CardPadding.Compact}"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <Style x:Key="SettingsPlaceholderTitleTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource AppTitleTextStyle}">
        <Setter Property="FontSize"
                Value="{StaticResource Metric.FontSize.Body}"/>
    </Style>

    <Style x:Key="SettingsDescriptionTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource AppLabelTextStyle}">
        <Setter Property="TextWrapping"
                Value="Wrap"/>
        <Setter Property="Margin"
                Value="0,8,0,0"/>
    </Style>

</ResourceDictionary>
