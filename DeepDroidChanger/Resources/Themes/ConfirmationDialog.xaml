<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Double x:Key="Metric.ConfirmationDialog.Width">560</sys:Double>
    <sys:Double x:Key="Metric.ConfirmationDialog.MinWidth">440</sys:Double>
    <sys:Double x:Key="Metric.ConfirmationDialog.IconSize">56</sys:Double>
    <sys:Double x:Key="Metric.ConfirmationDialog.IconGlyphSize">32</sys:Double>
    <sys:Double x:Key="Metric.ConfirmationDialog.CloseButtonSize">36</sys:Double>
    <sys:Double x:Key="Metric.ConfirmationDialog.CloseGlyphSize">22</sys:Double>
    <sys:Double x:Key="Metric.ConfirmationDialog.ButtonWidth">112</sys:Double>

    <Thickness x:Key="Spacing.ConfirmationDialog.FrameMargin">12</Thickness>
    <Thickness x:Key="Spacing.ConfirmationDialog.BodyPadding">28,24,24,22</Thickness>
    <Thickness x:Key="Spacing.ConfirmationDialog.IconMargin">0,0,20,0</Thickness>
    <Thickness x:Key="Spacing.ConfirmationDialog.TitleMargin">0,0,0,8</Thickness>
    <Thickness x:Key="Spacing.ConfirmationDialog.MessageMargin">0,0,0,16</Thickness>
    <Thickness x:Key="Spacing.ConfirmationDialog.WarningIconMargin">0,2,10,0</Thickness>
    <Thickness x:Key="Spacing.ConfirmationDialog.FooterPadding">24,16</Thickness>
    <Thickness x:Key="Spacing.ConfirmationDialog.ButtonGap">0,0,12,0</Thickness>
    <Thickness x:Key="Metric.ConfirmationDialog.FooterBorderThickness">0,1,0,0</Thickness>

    <Style x:Key="ConfirmationDialogCloseButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="{StaticResource Metric.ConfirmationDialog.CloseButtonSize}"/>
        <Setter Property="Height" Value="{StaticResource Metric.ConfirmationDialog.CloseButtonSize}"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Danger}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Metric.BorderThickness.Uniform}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Medium}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{DynamicResource Brush.DangerHover}"/>
                            <Setter TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Brush.DangerHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{DynamicResource Brush.DangerPressed}"/>
                            <Setter TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Brush.DangerPressed}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Brush.Focus}"/>
                            <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
