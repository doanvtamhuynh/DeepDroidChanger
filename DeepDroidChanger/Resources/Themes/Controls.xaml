                                    Property="BorderBrush"
                                    Value="{DynamicResource Brush.Border}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Brush.TextDisabled}"/>
                        </Trigger>
                        <Trigger Property="Validation.HasError"
                                 Value="True">
                            <Setter TargetName="InputBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Brush.Danger}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
