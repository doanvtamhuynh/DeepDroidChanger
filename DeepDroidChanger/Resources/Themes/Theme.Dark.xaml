<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color.WindowBackground">#0B1220</Color>
    <Color x:Key="Color.Surface">#121E2F</Color>
    <Color x:Key="Color.SurfaceAlt">#19283C</Color>
    <Color x:Key="Color.SurfaceHover">#22344B</Color>
    <Color x:Key="Color.SurfacePressed">#2C405A</Color>
    <Color x:Key="Color.SurfaceSelected">#1C3656</Color>

    <Color x:Key="Color.TextPrimary">#F1F5FB</Color>
    <Color x:Key="Color.TextSecondary">#B8C5D8</Color>
    <Color x:Key="Color.TextDisabled">#7C8DA6</Color>

    <Color x:Key="Color.Border">#2A3C54</Color>
    <Color x:Key="Color.BorderStrong">#526987</Color>
    <Color x:Key="Color.Focus">#60A5FA</Color>

    <Color x:Key="Color.Accent">#4F91FF</Color>
    <Color x:Key="Color.AccentHover">#70A6FF</Color>
    <Color x:Key="Color.AccentPressed">#3B82F6</Color>
    <Color x:Key="Color.AccentForeground">#FFFFFFFF</Color>

    <Color x:Key="Color.Success">#4ADE80</Color>
    <Color x:Key="Color.Warning">#FBBF24</Color>
    <Color x:Key="Color.Danger">#F87171</Color>
    <Color x:Key="Color.DangerHover">#EF4444</Color>
    <Color x:Key="Color.DangerPressed">#DC2626</Color>
    <Color x:Key="Color.Overlay">#99000000</Color>
    <Color x:Key="Color.BadgeInfoBackground">#1B2A4A</Color>
    <Color x:Key="Color.BadgeInfoForeground">#3B82F6</Color>
    <Color x:Key="Color.DeviceStatusPositiveForeground">#6BE298</Color>
    <Color x:Key="Color.DeviceStatusPositiveBackground">#2B27A661</Color>
    <Color x:Key="Color.DeviceStatusNegativeForeground">#FF8A8A</Color>
    <Color x:Key="Color.DeviceStatusNegativeBackground">#26FF8A8A</Color>
    <Color x:Key="Color.DeviceStatusWarningForeground">#FFBE63</Color>
    <Color x:Key="Color.DeviceStatusWarningBackground">#24FFBE63</Color>
    <Color x:Key="Color.DeviceStatusInfoForeground">#4C93FF</Color>
    <Color x:Key="Color.DeviceStatusInfoBackground">#264C93FF</Color>

    <SolidColorBrush x:Key="Brush.WindowBackground" Color="{StaticResource Color.WindowBackground}"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}"/>
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}"/>
    <SolidColorBrush x:Key="Brush.SurfacePressed" Color="{StaticResource Color.SurfacePressed}"/>
    <SolidColorBrush x:Key="Brush.SurfaceSelected" Color="{StaticResource Color.SurfaceSelected}"/>

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}"/>

    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}"/>
    <SolidColorBrush x:Key="Brush.Focus" Color="{StaticResource Color.Focus}"/>

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.AccentPressed}"/>
    <SolidColorBrush x:Key="Brush.AccentForeground" Color="{StaticResource Color.AccentForeground}"/>

    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>
    <SolidColorBrush x:Key="Brush.DangerHover" Color="{StaticResource Color.DangerHover}"/>
    <SolidColorBrush x:Key="Brush.DangerPressed" Color="{StaticResource Color.DangerPressed}"/>
    <SolidColorBrush x:Key="Brush.Overlay" Color="{StaticResource Color.Overlay}"/>
    <SolidColorBrush x:Key="Brush.BadgeInfoBackground" Color="{StaticResource Color.BadgeInfoBackground}"/>
    <SolidColorBrush x:Key="Brush.BadgeInfoForeground" Color="{StaticResource Color.BadgeInfoForeground}"/>
    <SolidColorBrush x:Key="Brush.DeviceStatusPositiveForeground" Color="{StaticResource Color.DeviceStatusPositiveForeground}"/>
    <SolidColorBrush x:Key="Brush.DeviceStatusPositiveBackground" Color="{StaticResource Color.DeviceStatusPositiveBackground}"/>
    <SolidColorBrush x:Key="Brush.DeviceStatusNegativeForeground" Color="{StaticResource Color.DeviceStatusNegativeForeground}"/>
    <SolidColorBrush x:Key="Brush.DeviceStatusNegativeBackground" Color="{StaticResource Color.DeviceStatusNegativeBackground}"/>
    <SolidColorBrush x:Key="Brush.DeviceStatusWarningForeground" Color="{StaticResource Color.DeviceStatusWarningForeground}"/>
    <SolidColorBrush x:Key="Brush.DeviceStatusWarningBackground" Color="{StaticResource Color.DeviceStatusWarningBackground}"/>
    <SolidColorBrush x:Key="Brush.DeviceStatusInfoForeground" Color="{StaticResource Color.DeviceStatusInfoForeground}"/>
    <SolidColorBrush x:Key="Brush.DeviceStatusInfoBackground" Color="{StaticResource Color.DeviceStatusInfoBackground}"/>

    <SolidColorBrush x:Key="Brush.PrimaryButtonBackground" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.PrimaryButtonForeground" Color="{StaticResource Color.AccentForeground}"/>
    <SolidColorBrush x:Key="Brush.AccentHoverForeground" Color="{StaticResource Color.AccentForeground}"/>
    <SolidColorBrush x:Key="Brush.AccentPressedForeground" Color="{StaticResource Color.AccentForeground}"/>
    <SolidColorBrush x:Key="Brush.DangerForeground" Color="#FF17101A"/>
    <SolidColorBrush x:Key="Brush.DangerPressedForeground" Color="#FFFFFFFF"/>
</ResourceDictionary>
