<Window x:Class="DeepDroidChanger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource AppName}"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        MinWidth="980"
        MinHeight="640"
        Background="{DynamicResource Brush.WindowBackground}"
        TextElement.Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Metric.FontFamily}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn"
                              Width="{Binding SidebarWidth}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">
                <Grid x:Name="HeaderPanel"
                      DockPanel.Dock="Top"
                      Margin="{Binding HeaderMargin}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"
                                       MinHeight="{StaticResource Metric.ToolbarMinHeight}"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnToggle"
                            Grid.Row="0"
                            Grid.Column="{Binding HeaderToggleColumn}"
                            Grid.ColumnSpan="{Binding HeaderToggleColumnSpan}"
                            Width="34"
                            Height="34"
                            HorizontalAlignment="{Binding ToggleHorizontalAlignment}"
                            VerticalAlignment="Center"
                            Command="{Binding ToggleSidebarCommand}"
                            Style="{StaticResource BottomIconButtonStyle}"
                            ToolTip="{DynamicResource Nav_ToggleSidebar}">
                        <materialDesign:PackIcon Kind="{Binding ToggleIconKind}"
                                                 Style="{StaticResource ShellToggleIconStyle}"/>
                    </Button>

                    <StackPanel x:Name="PnlLogo"
                                Grid.Row="{Binding LogoRow}"
                                Grid.Column="0"
                                Grid.ColumnSpan="{Binding LogoColumnSpan}"
                                Orientation="Horizontal"
                                HorizontalAlignment="{Binding LogoHorizontalAlignment}"
                                Margin="{Binding LogoMargin}"
                                VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Robot"
                                                 Style="{StaticResource ShellLogoIconStyle}"/>
                        <TextBlock x:Name="TxtLogo"
                                   Text="{DynamicResource AppName}"
                                   Style="{StaticResource ShellLogoTextStyle}"
                                   Visibility="{Binding LogoTextVisibility}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Separator DockPanel.Dock="Top"
                           Background="{DynamicResource Brush.Border}"
                           Margin="12,4"/>

                <StackPanel DockPanel.Dock="Top"
                            Margin="6,6,6,0">
                    <Button x:Name="BtnDeviceManager"
                            Tag="Cellphone"
                            Content="{DynamicResource Nav_DeviceManager}"
                            Command="{Binding NavigateDeviceManagerCommand}"
                            Style="{StaticResource SidebarDeviceManagerTabStyle}"/>

                    <Button x:Name="BtnSettings"
                            Tag="Cog"
                            Content="{DynamicResource Nav_Settings}"
                            Command="{Binding NavigateSettingsCommand}"
                            Style="{StaticResource SidebarSettingsTabStyle}"/>
                </StackPanel>

                <Grid DockPanel.Dock="Top"/>

                <Border x:Name="BottomActionsPanel"
                        DockPanel.Dock="Bottom"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,1,0,0"
                        Padding="{Binding BottomActionsPadding}">
                    <StackPanel>
                        <StackPanel x:Name="BottomActions"
                                    Orientation="{Binding BottomActionsOrientation}"
                                    HorizontalAlignment="{Binding BottomActionsHorizontalAlignment}"
                                    Margin="0,0,0,4">
                            <Button x:Name="BtnLanguage"
                                    Style="{StaticResource BottomIconButtonStyle}"
                                    Command="{Binding ToggleLanguageCommand}"
                                    ToolTip="{DynamicResource Nav_Language}">
                                <Image x:Name="ImgLanguage"
                                       Width="20"
                                       Height="20"
                                       Source="{Binding LanguageFlagSource}"
                                       Stretch="Uniform"/>
                            </Button>

                            <Button x:Name="BtnTheme"
                                    Style="{StaticResource BottomIconButtonStyle}"
                                    Margin="{Binding ThemeButtonMargin}"
                                    Command="{Binding ToggleThemeCommand}"
                                    ToolTip="{DynamicResource Nav_Theme}">
                                <materialDesign:PackIcon x:Name="IconTheme"
                                                         Kind="{Binding ThemeIconKind}"
                                                         Style="{StaticResource ShellBottomIconStyle}"/>
                            </Button>
                        </StackPanel>

                        <Separator Background="{DynamicResource Brush.Border}"
                                   Margin="0,4,0,6"/>

                        <DockPanel x:Name="VersionInfoPanel"
                                   Margin="0"
                                   HorizontalAlignment="{Binding VersionHorizontalAlignment}">
                            <materialDesign:PackIcon x:Name="IconVersion"
                                                     Kind="InformationOutline"
                                                     Style="{StaticResource ShellVersionIconStyle}"
                                                     Visibility="{Binding VersionTextVisibility}"
                                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtVersionLabel"
                                       Style="{StaticResource ShellVersionTextStyle}"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding VersionTextVisibility}"
                                       Text="{DynamicResource Version}"/>
                            <TextBlock x:Name="TxtVersionValue"
                                       Style="{StaticResource ShellVersionTextStyle}"
                                       Margin="{Binding VersionValueMargin}"
                                       VerticalAlignment="Center"
                                       Text="{DynamicResource AppVersion}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Border Grid.Column="1"
                Background="{DynamicResource Brush.WindowBackground}">
            <ContentControl x:Name="MainContent"/>
        </Border>
    </Grid>
</Window>
